                <td style="height: 20px; line-height: 20px; font-size: 1px;">&nbsp;</td>
              </tr>

              <!-- VIEW ORDER BUTTON -->
              {% if order_view_url != blank %}
              <tr>
                <td class="section-padding track-button-wrap" style="padding: 0 20px;" align="center">
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" class="track-button-inner" width="280" style="border-collapse: collapse; margin: 0 auto; width: 280px; max-width: 100%;">
                    <tr>
                      <td class="track-button-cell" align="center" bgcolor="#747853" style="border-radius: 0; background-color: #747853; padding: 12px 24px; mso-padding-alt: 12px 24px;">
                        <a class="track-button-link ql-font-oswald" href="{{ order_view_url }}" target="_blank" style="display: inline-block; text-decoration: none; text-align: center; color: #ffffff; font-family: Oswald, Arial, sans-serif; font-weight: bold; font-size: 18px; line-height: 22px; text-transform: uppercase; letter-spacing: 0.5px; mso-line-height-rule: exactly;">
                          <strong class="ql-font-oswald">View your order</strong>
                        </a>
                      </td>
                    </tr>
                  </table>
                  {% if shop.url %}
                  <p class="secondary-link" style="margin: 16px 0 0; padding: 0; font-family: Lato, Helvetica, Arial, sans-serif; font-size: 14px; line-height: 22px; color: #333333; text-align: center;">
                    or <a href="{{ shop.url }}" style="color: #747853; text-decoration: underline;">Visit our store</a>
                  </p>
                  {% endif %}
                </td>
              </tr>
              {% endif %}

              {% if fulfillment.tracking_numbers.size > 0 %}
              <tr>
                <td class="section-padding" style="padding: 16px 20px 0;">
                  <p class="tracking-text" style="margin: 0; padding: 0; font-family: Lato, Helvetica, Arial, sans-serif; font-size: 14px; line-height: 22px; color: #666666; text-align: center;">
                    {% if fulfillment.tracking_numbers.size == 1 and fulfillment.tracking_company %}
                      {{ fulfillment.tracking_company }} tracking number:
                      {% if tracking_link != blank %}
                        <a href="{{ tracking_link }}" style="color: #747853; text-decoration: underline;">{{ fulfillment.tracking_numbers.first }}</a>
                      {% else %}
                        {{ fulfillment.tracking_numbers.first }}
                      {% endif %}
                    {% elsif fulfillment.tracking_numbers.size == 1 %}
                      Tracking number:
                      {% if tracking_link != blank %}
                        <a href="{{ tracking_link }}" style="color: #747853; text-decoration: underline;">{{ fulfillment.tracking_numbers.first }}</a>
                      {% else %}
                        {{ fulfillment.tracking_numbers.first }}
                      {% endif %}
                    {% else %}
                      {{ fulfillment.tracking_company }} tracking numbers:<br />
                      {% for tracking_number in fulfillment.tracking_numbers %}
                        {% if fulfillment.tracking_urls[forloop.index0] %}
                          <a href="{{ fulfillment.tracking_urls[forloop.index0] }}" style="color: #747853; text-decoration: underline;">{{ tracking_number }}</a>
                        {% else %}
                          {{ tracking_number }}
                        {% endif %}
                        {% unless forloop.last %}<br />{% endunless %}
                      {% endfor %}
                    {% endif %}
                  </p>
                </td>
              </tr>
              {% endif %}

              <tr>
                <td style="height: 48px; line-height: 48px; font-size: 1px;">&nbsp;</td>
              </tr>

              <!-- DELIVERED CONFIRMATION -->
              <tr>
                <td bgcolor="#FBF8EE" style="background-color: #FBF8EE;">
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse: collapse;">
                    <tr>
                      <td class="section-padding-lg" align="center" style="padding: 28px 24px; text-align: center;">
                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="border-collapse: collapse; margin: 0 auto; max-width: 560px;">
                          <tr>
                            <td align="center" class="arrival-heart" style="padding-bottom: 18px;">
                              <svg viewBox="0 0 64 64" width="52" height="42" style="display: block; margin: 0 auto; max-width: 100%; height: auto;" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M32 54 L29.5 51.6 C18 41.2 11 34.8 11 25.8 C11 18.8 16.2 14 22.8 14 C27 14 30.2 16.2 32 19 C33.8 16.2 37 14 41.2 14 C47.8 14 53 18.8 53 25.8 C53 34.8 46 41.2 34.5 51.6 Z" fill="none" stroke="#BC9C70" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
                              </svg>
                            </td>
                          </tr>
                          <tr>
                            <td align="center" class="arrival-label" style="font-family: Lato, Helvetica, Arial, sans-serif; font-size: 20px; line-height: 28px; font-weight: 400; color: #333333;">
                              Your package has arrived — we hope you love it!
                            </td>
                          </tr>
                        </table>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>

              <tr>
                <td style="height: 16px; line-height: 16px; font-size: 1px;">&nbsp;</td>
              </tr>

              <!-- LINE ITEMS -->
              <tr>
                <td class="section-padding line-items-wrap" style="padding: 8px 20px 0;">
                  <p class="section-heading" style="margin: 0 0 16px; font-family: Lato, Helvetica, Arial, sans-serif; font-size: 18px; line-height: 24px; font-weight: 900; letter-spacing: 2px; color: #222222; text-transform: uppercase; text-align: left;">
                    Items in delivery
                  </p>
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse: collapse; min-width: 100%;">
                    <tbody>
                      {% for line in fulfillment.fulfillment_line_items %}
                        {% unless line.line_item.nested_line_child? %}
                          {% assign is_parent = false %}
                          {% assign is_nested_line_parent = line.line_item.nested_line_parent? %}
                          {% if line.line_item.bundle_parent? or line.line_item.nested_line_parent? %}
                            {% assign is_parent = true %}
                          {% endif %}

                          {% if line.line_item.presentment_title %}
                            {% assign line_title = line.line_item.presentment_title %}
                          {% elsif line.line_item.title %}
                            {% assign line_title = line.line_item.title %}
                          {% else %}
                            {% assign line_title = line.line_item.product.title %}
                          {% endif %}

                          {% if line.quantity < line.line_item.quantity %}
                            {% capture line_display %}{{ line.quantity }} of {{ line.line_item.quantity }}{% endcapture %}
                          {% else %}
                            {% assign line_display = line.line_item.quantity %}
                          {% endif %}

                          {% comment %}
                            Use live catalog images first so updated product/variant photos appear in sent emails.
                            line.line_item.image is an order snapshot and is only a fallback.
                            Size-only img_url (no crop/scale) avoids stale Shopify CDN crop derivatives.
                          {% endcomment %}
                          {% assign li = line.line_item %}
                          {% assign line_image_src = '' %}
                          {% if li.variant.image != blank %}
                            {% assign line_image_src = li.variant | img_url: '240x240' %}
                            {% if line_image_src == blank %}
                              {% assign line_image_src = li.variant.image | img_url: '240x240' %}
                            {% endif %}
                          {% endif %}
                          {% if line_image_src == blank and li.product.featured_image != blank %}
                            {% assign line_image_src = li.product | img_url: '240x240' %}
                            {% if line_image_src == blank %}
                              {% assign line_image_src = li.product.featured_image | img_url: '240x240' %}
                            {% endif %}
                          {% endif %}
                          {% if line_image_src == blank and li.image != blank %}
                            {% assign line_image_src = li | img_url: '240x240' %}
                            {% if line_image_src == blank %}
                              {% assign line_image_src = li.image | img_url: '240x240' %}
                            {% endif %}
                          {% endif %}

                          <tr>
                            <td class="order-list__item__cell" style="padding: 14px 0; border-bottom: 1px solid #ECE6DC;">
                              <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" class="line-item-row" style="border-collapse: collapse;">
                                <tr>
                                  <td class="line-item-img" width="120" valign="top" style="width: 120px; padding: 0 12px 0 0; vertical-align: top;">
                                    {% if line_image_src != blank %}
                                      <img src="{{ line_image_src }}" width="120" height="120" alt="{{ line_title | escape }}" class="order-list__product-image" style="display: block; max-width: 120px; width: 120px; height: auto; border: 0; margin: 0;" />
                                    {% else %}
                                      <img src="{{ 'notifications/no-image.png' | shopify_asset_url }}" width="120" height="120" alt="{{ line_title | escape }}" class="order-list__product-image" style="display: block; max-width: 120px; width: 120px; height: auto; border: 0; margin: 0;" />
                                    {% endif %}
                                  </td>
                                  <td class="line-item-details" valign="top" style="padding: 0 8px 0 0; vertical-align: top; text-align: left;">
                                    <span class="order-list__item-title" style="display: block; margin: 0 0 6px; font-family: Lato, Helvetica, Tahoma, Verdana, Segoe, sans-serif; font-size: 16px; line-height: 22px; font-weight: 700; color: #080808; letter-spacing: 1px; text-transform: uppercase;">{{ line_title }}&nbsp;&times;&nbsp;{{ line_display }}</span>

                                    {% if line.line_item.variant.title != 'Default Title' and is_parent == false %}
                                      <span class="order-list__item-variant" style="display: block; margin: 0 0 4px;">{{ line.line_item.variant.title }}</span>
                                    {% elsif line.line_item.variant.title != 'Default Title' and line.line_item.nested_line_parent? %}
                                      <span class="order-list__item-variant" style="display: block; margin: 0 0 4px;">{{ line.line_item.variant.title }}</span>
                                    {% elsif line.line_item.variant.title != 'Default Title' and line.line_item.bundle_parent? %}
                                      <span class="order-list__item-variant" style="display: block; margin: 0 0 4px;">{{ line.line_item.variant.title }}</span>
                                    {% endif %}

                                    {% unless false %}
                                      {% for group in line.line_item.groups %}
                                        {% if group.deliverable? %}
                                          <span class="order-list__item-variant" style="display: block; margin: 0 0 4px;">For: {{ group.display_title }}</span>
                                        {% else %}
                                          <span class="order-list__item-variant" style="display: block; margin: 0 0 4px;">Part of: {{ group.display_title }}</span>
                                        {% endif %}
                                      {% endfor %}
                                    {% endunless %}

                                    {% if line.line_item.selling_plan_allocation %}
                                      <span class="order-list__item-variant" style="display: block; margin: 0 0 4px;">{{ line.line_item.selling_plan_allocation.selling_plan.name }}</span>
                                    {% endif %}

                                    {% if line.line_item.refunded_quantity > 0 %}
                                      <span class="order-list__item-refunded" style="display: block; margin: 0 0 4px;">Refunded</span>
                                    {% endif %}

                                    {% if line.line_item.discount_allocations %}
                                      {% for discount_allocation in line.line_item.discount_allocations %}
                                        {% if discount_allocation.discount_application.target_selection != 'all' %}
                                          <p style="margin: 0 0 4px; font-family: Lato, Helvetica, Arial, sans-serif; font-size: 14px; line-height: 20px; color: #333333;">
                                            <span class="order-list__item-discount-allocation">
                                              <img src="{{ 'notifications/discounttag.png' | shopify_asset_url }}" width="18" height="18" alt="" style="vertical-align: middle; border: 0;" />
                                              <span>{{ discount_allocation.discount_application.title | upcase }} (-{{ discount_allocation.amount | money }})</span>
                                            </span>
                                          </p>
                                        {% endif %}
                                      {% endfor %}
                                    {% endif %}
                                  </td>
                                </tr>

                                {% if line.line_item.nested_line_parent? %}
                                  {% for child_line in line.line_item.nested_lines %}
                                    {% assign child_image_src = '' %}
                                    {% if child_line.variant.image != blank %}
                                      {% assign child_image_src = child_line.variant | img_url: '160x160' %}
                                      {% if child_image_src == blank %}
                                        {% assign child_image_src = child_line.variant.image | img_url: '160x160' %}
                                      {% endif %}
                                    {% endif %}
                                    {% if child_image_src == blank and child_line.product.featured_image != blank %}
                                      {% assign child_image_src = child_line.product | img_url: '160x160' %}
                                      {% if child_image_src == blank %}
                                        {% assign child_image_src = child_line.product.featured_image | img_url: '160x160' %}
                                      {% endif %}
                                    {% endif %}
                                    {% if child_image_src == blank and child_line.image != blank %}
                                      {% assign child_image_src = child_line | img_url: '160x160' %}
                                      {% if child_image_src == blank %}
                                        {% assign child_image_src = child_line.image | img_url: '160x160' %}
                                      {% endif %}
                                    {% endif %}

                                    {% if child_line.product.title %}
                                      {% assign item_title = child_line.product.title %}
                                    {% else %}
                                      {% assign item_title = child_line.title %}
                                    {% endif %}
                                    {% assign item_display = child_line.quantity %}

                                    <tr>
                                      <td class="line-item-img" width="80" valign="top" style="width: 80px; padding: 12px 12px 0 24px; vertical-align: top;">
                                        {% if child_image_src != blank %}
                                          <img src="{{ child_image_src }}" width="80" height="80" alt="{{ item_title | escape }}" class="order-list__product-image" style="display: block; max-width: 80px; width: 80px; height: auto; border: 0; margin: 0;" />
                                        {% else %}
                                          <img src="{{ 'notifications/no-image.png' | shopify_asset_url }}" width="80" height="80" alt="{{ item_title | escape }}" style="display: block; max-width: 80px; width: 80px; height: auto; border: 0; margin: 0;" />
                                        {% endif %}
                                      </td>
                                      <td class="line-item-details" valign="top" style="padding: 12px 0 0; vertical-align: top; text-align: left;">
                                        <span class="order-list__item-title" style="display: block; margin: 0 0 4px; font-family: Lato, Helvetica, Arial, sans-serif; font-size: 14px; line-height: 20px; font-weight: 700; color: #080808; text-transform: uppercase;">{{ item_title }}&nbsp;&times;&nbsp;{{ item_display }}</span>
                                        {% if child_line.variant.title != 'Default Title' %}
                                          <span class="order-list__item-variant" style="display: block; margin: 0 0 4px;">{{ child_line.variant.title }}</span>
                                        {% endif %}
                                        {% if child_line.selling_plan_allocation %}
                                          <span class="order-list__item-variant" style="display: block; margin: 0 0 4px;">{{ child_line.selling_plan_allocation.selling_plan.name }}</span>
                                        {% endif %}
                                      </td>
                                    </tr>
                                  {% endfor %}
                                {% endif %}
                              </table>
                            </td>
                          </tr>
                        {% endunless %}
                      {% endfor %}
                    </tbody>
                  </table>
                </td>
              </tr>

              <!-- NEED HELP -->
              <tr>
                <td bgcolor="#FAF9F6" style="background-color: #FAF9F6;">
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse: collapse;">
                    <tr>
                      <td class="section-padding-lg" style="padding: 32px 24px;">
                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse: collapse; max-width: 520px; margin: 0 auto;">
                          <tr>
                            <td class="info-icon-cell support-icon-cell" width="62" valign="top" style="width: 62px; padding-right: 18px; vertical-align: top; text-align: left;">
                              <table role="presentation" cellpadding="0" cellspacing="0" border="0" class="support-icon-wrap" style="border-collapse: collapse; margin: 0;">
                                <tr>
                                  <td class="support-icon-circle" width="62" height="62" align="center" valign="middle" bgcolor="#747853" style="width: 62px; height: 62px; min-width: 62px; border-radius: 50%; background-color: #747853; text-align: center; vertical-align: middle; font-size: 26px; line-height: 62px; color: #ffffff;" aria-hidden="true">✉</td>
                                </tr>
                              </table>
                            </td>
                            <td class="info-text-cell" valign="top" style="vertical-align: top; text-align: left;">
                              <p class="support-heading" style="margin: 0 0 8px; font-family: Lato, Helvetica, Arial, sans-serif; font-size: 24px; line-height: 30px; font-weight: 700; color: #222222; letter-spacing: -0.5px;">
                                NEED HELP?
                              </p>
                              <p class="support-text" style="margin: 0 0 4px; font-family: Lato, Helvetica, Arial, sans-serif; font-size: 18px; line-height: 26px; font-weight: 500; color: #333333;">
                                We're here for you.
                              </p>
                              <p class="support-text" style="margin: 0 0 4px; font-family: Lato, Helvetica, Arial, sans-serif; font-size: 18px; line-height: 26px; font-weight: 500; color: #333333;">
                                <a href="mailto:{{ shop.email }}" style="color: #333333; text-decoration: none;">{{ shop.email }}</a>
                              </p>
                              <p class="support-text" style="margin: 0; font-family: Lato, Helvetica, Arial, sans-serif; font-size: 18px; line-height: 26px; font-weight: 500; color: #333333;">
                                Mon–Fri, 9:00 AM – 5:00 PM EST
                              </p>
                            </td>
                          </tr>
                        </table>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>

              <!-- STAY CONNECTED -->
              <tr>
                <td bgcolor="#f0f5f0" style="background-color: #f0f5f0;">
                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse; width: 100%; background-color: #f0f5f0;">
                    <tr>
                      <td align="center" class="section-padding-lg" style="padding: 30px 20px 28px;">
                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width: 560px; margin: 0 auto; border-collapse: collapse;">
                          <tr>
                            <td align="center" class="social-heading" style="font-family: Lato, Arial, Helvetica, sans-serif; font-size: 24px; line-height: 30px; font-weight: 700; letter-spacing: 3px; color: #333333; padding-bottom: 24px;">
                              STAY CONNECTED
                            </td>
                          </tr>
                        </table>

                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="border-collapse: collapse; margin: 0 auto;">
                          <tr>
                            <td align="center" style="padding: 0 10px;">
                              <a class="social-icon-link" href="https://www.instagram.com/shop.littlejoyco/" target="_blank" style="display: inline-block; width: 48px; height: 48px; border: 2px solid #9d9d9d; border-radius: 50%; text-decoration: none; color: #555555; font-family: Arial, Helvetica, sans-serif; font-size: 21px; line-height: 48px; text-align: center;">
                                ◎
                              </a>
                            </td>
                            <td align="center" style="padding: 0 10px;">
                              <a class="social-icon-link" href="https://www.facebook.com/hellolittlejoyco/" target="_blank" style="display: inline-block; width: 48px; height: 48px; border: 2px solid #9d9d9d; border-radius: 50%; text-decoration: none; color: #555555; font-family: Arial, Helvetica, sans-serif; font-size: 28px; line-height: 48px; text-align: center; font-weight: bold;">
                                f
                              </a>
                            </td>
                            <td align="center" style="padding: 0 10px;">
                              <a class="social-icon-link" href="mailto:{{ shop.email }}" style="display: inline-block; width: 48px; height: 48px; border: 2px solid #9d9d9d; border-radius: 50%; text-decoration: none; color: #555555; font-family: Arial, Helvetica, sans-serif; font-size: 22px; line-height: 48px; text-align: center;">
                                ✉
                              </a>
                            </td>
                          </tr>
                        </table>

                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width: 100%; max-width: 560px; margin: 24px auto 0; border-collapse: collapse;">
                          <tr>
                            <td width="44%" valign="top" style="border-top: 2px solid #d7d1c6; font-size: 1px; line-height: 1px; height: 1px;">&nbsp;</td>
                            <td width="12%" align="center" valign="middle" style="font-family: Arial, Helvetica, sans-serif; font-size: 28px; line-height: 28px; color: #8b8b8b; padding: 0 8px;">
                              ❤
                            </td>
                            <td width="44%" valign="top" style="border-top: 2px solid #d7d1c6; font-size: 1px; line-height: 1px; height: 1px;">&nbsp;</td>
                          </tr>
                        </table>

                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse: collapse; max-width: 560px; margin: 0 auto;">
                          <tr>
                            <td align="center" class="tagline-text" style="font-family: Parisienne, 'Brush Script MT', cursive; font-size: 30px; line-height: 38px; font-style: italic; color: #4f4f4f; padding-top: 22px;">
                              Carefully designed for everyday parenting.
                            </td>
                          </tr>
                        </table>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>

              <!-- FOOTER -->
              <tr>
                <td bgcolor="#fdfbf9" style="background-color: #fdfbf9;">
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse: collapse;">
                    <tr>
                      <td class="section-padding" style="padding: 20px 24px 28px;">
                        <p class="footer-text" style="margin: 0; font-family: Lato, Helvetica, Arial, sans-serif; font-size: 14px; line-height: 22px; color: #666666; text-align: center;">
                          If you have any questions, reply to this email or contact us at <a href="mailto:{{ shop.email }}" style="color: #747853; text-decoration: underline;">{{ shop.email }}</a>.
                        </p>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>

            </tbody>
          </table>
        </td>
      </tr>
      <!--[if gte mso 9]>
        </table>
      </center>
      <![endif]-->
      <!--[if mso]>
        </td>
        <td style="padding: 0; margin: 0;">&nbsp;</td>
      </tr>
      <![endif]-->
    </table>
  </center>
</body>
</html>
