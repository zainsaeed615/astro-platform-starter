{% comment %}
  Hello Little Joy — Delivered (DEL)

  Product images prefer the live variant/product catalog photo, then the
  order line-item snapshot. View your order links to Shopify's customer
  order status page (order_status_url), not an UpOrder click wrapper.
  Tracking numbers still use the carrier URL first.

  Publish into Shopify: Settings → Notifications → Delivered →
  replace Email body (HTML) → Save.
{% endcomment %}
{% capture recType %}DEL{% endcapture %}

{% capture email_title %}Your order has been delivered{% endcapture %}
{% capture email_body %}Haven't received your order? <a href="mailto:{{ shop.email }}" style="color: #747853; text-decoration: underline;">Let us know</a>.{% endcapture %}

{% assign order_view_url = '' %}
{% if order_status_url != blank %}
  {% assign order_view_url = order_status_url | strip %}
{% endif %}
{% if order_view_url == blank %}
  {% assign order_view_url = shop.url %}
{% endif %}

{% assign tracking_link = '' %}
{% if fulfillment.tracking_urls %}
  {% for tracking_url in fulfillment.tracking_urls %}
    {% if tracking_link == blank and tracking_url != blank %}
      {% assign tracking_link = tracking_url | strip %}
    {% endif %}
  {% endfor %}
{% endif %}
{% if tracking_link == blank and fulfillment.tracking_url != blank %}
  {% assign tracking_link = fulfillment.tracking_url | strip %}
{% endif %}
{% if tracking_link == blank and fulfillment.tracking_link != blank %}
  {% assign tracking_link = fulfillment.tracking_link | strip %}
{% endif %}
{% if tracking_link == blank and order_view_url != blank %}
  {% assign tracking_link = order_view_url %}
{% endif %}
