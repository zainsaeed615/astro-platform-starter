                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse;">
                    <tr>
                      <td align="center" style="padding:0px 0px 20px 0px;">
                        <table role="presentation" width="80%" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; margin:0 auto;">
                          <tr>
                            <td width="45%" valign="middle" style="border-top:2px solid #E4DED2; font-size:1px; line-height:1px;">&nbsp;</td>
