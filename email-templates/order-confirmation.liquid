                  <table style="mso-table-lspace: 0; mso-table-rspace: 0;" cellpadding="0" cellspacing="0" width="100%" style="min-width: 100%"><tbody><tr><td style="height: 10px; min-height: 10px"></td></tr></tbody></table>

                  <table style="mso-table-lspace:0;mso-table-rspace:0;min-width:100%;width: 100%;word-break: break-word;" cellpadding="0" cellspacing="0" width="100%">
                    <tbody>
                      <tr>
                        <td style="mso-table-lspace:0;mso-table-rspace:0;padding-top: 0px; padding-bottom: 0px; padding-left: 20px; padding-right: 20px;width:100%;background-color:transparent">
                          <table style="mso-table-lspace:0;mso-table-rspace:0;margin:auto" align="center" width="100%">
                            <tbody>
                              <tr>
                                <td class="tb__component--text__table" style="mso-table-lspace:0;mso-table-rspace:0">
                                  <h1 style="padding:auto;margin:0px;font-size:18px;line-height: 23px;font-family:lato, Helvetica, Tahoma, Verdana, Segoe, sans-serif;color:#000; font-weight:normal; font-style:normal; text-align: center; text-transform: none;">
                                    We're preparing your order<br />and will notify you as soon as it ships.
                                  </h1>
                                </td>
                              </tr>
                            </tbody>
                          </table>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                  <table style="mso-table-lspace: 0; mso-table-rspace: 0;" cellpadding="0" cellspacing="0" width="100%" style="min-width: 100%"><tbody><tr><td style="height: 39px; min-height: 39px"></td></tr></tbody></table>

                  <table style="mso-table-lspace:0;mso-table-rspace:0;min-width:100%;width: 100%;word-break: break-word;" cellpadding="0" cellspacing="0" width="100%">
                    <tbody>
                      <tr>
                        <td style="mso-table-lspace:0;mso-table-rspace:0;padding-top: 0px; padding-bottom: 0px; padding-left: 0px; padding-right: 0px;width:100%;background-color:transparent">
                          <table style="mso-table-lspace:0;mso-table-rspace:0;margin:auto" align="center" width="100%">
                            <tbody>
                              <tr>
                                <td class="tb__component--text__table" style="mso-table-lspace:0;mso-table-rspace:0">
                                  <h1 style="padding:auto;margin:0px;font-size:20px;line-height: 25px;font-family:Tahoma,Verdana, Segoe, sans-serif;color:#050505; font-weight:normal; font-style:normal; text-align: center; text-transform: none;">
                                    ORDER SUMMARY
                                  </h1>
                                </td>
                              </tr>
                            </tbody>
                          </table>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                  <table style="mso-table-lspace: 0; mso-table-rspace: 0;" cellpadding="0" cellspacing="0" width="100%" style="min-width: 100%"><tbody><tr><td style="height: 10px; min-height: 10px"></td></tr></tbody></table>

                  <table cellpadding="0" cellspacing="0" width="100%" style="background-color: #F5F2EE; padding: 15px 8px; min-width: 100%;">
                    <tbody>
                      <tr>
                        <td>
                          <table cellpadding="0" cellspacing="0" width="100%" style="min-width: 100%">
                            <tbody>
                              {% for line in line_items %}
                                {% capture product_attributes %}
                                  {% for p in line.properties %}
                                    {% assign stringToCheck = p.first %}
                                    {% assign containsStartsWith = false %}
                                    {% assign checkString = stringToCheck | slice: 0 %}
                                    {% if checkString == '_' %}
                                      {% assign containsStartsWith = true %}
                                    {% else %}
                                      {% assign containsStartsWith = false %}
                                    {% endif %}
                                    {% unless p.last == blank or p.first contains '_options' or containsStartsWith == true %}
                                      <br />{{ p.first }}: {{ p.last }}
                                    {% endunless %}
                                  {% endfor %}
                                {% endcapture %}

                                {% comment %}
                                  Use live catalog images first so updated product/variant photos appear in sent emails.
                                  line.image is an order snapshot and is only a fallback.
                                  Size-only img_url (no crop/scale) avoids stale Shopify CDN crop derivatives.
                                {% endcomment %}
                                {% assign line_image_src = '' %}
                                {% if line.variant.image != blank %}
                                  {% assign line_image_src = line.variant | img_url: '240x240' %}
                                  {% if line_image_src == blank %}
                                    {% assign line_image_src = line.variant.image | img_url: '240x240' %}
                                  {% endif %}
                                {% endif %}
                                {% if line_image_src == blank and line.product.featured_image != blank %}
                                  {% assign line_image_src = line.product | img_url: '240x240' %}
                                  {% if line_image_src == blank %}
                                    {% assign line_image_src = line.product.featured_image | img_url: '240x240' %}
                                  {% endif %}
                                {% endif %}
                                {% if line_image_src == blank and line.image != blank %}
                                  {% assign line_image_src = line | img_url: 'compact_cropped' %}
                                  {% if line_image_src == blank %}
                                    {% assign line_image_src = line.image | img_url: '240x240' %}
                                  {% endif %}
                                {% endif %}

                                <tr class="">
                                  <td style="padding-top: 10px; width: 50px">
                                    <table cellpadding="0" cellspacing="0" width="100%">
                                      <tbody>
                                        <tr>
                                          <td>
                                            <a data-component="LineItems" href="https://api.uporder.com/api/spently/click?id={{ order_number }}&store=n88nm1-zy&type=OI&cid={{ customer.id }}&url={{ shop.url }}{{ line.url }}&s={{ "n88nm1-zypantastic" | append: "" | append: shop.url | append: "" | append: line.url | append: "" | url_decode | sha256 }}&component=LineItems" target="_blank">
                                              {% if line_image_src != blank %}
                                                <img src="{{ line_image_src }}" width="120" alt="{{ line.title | escape }}" style="display:block; max-width:120px; width:120px; height:auto; border:0;" />
                                              {% else %}
                                                <img src="{{ 'notifications/no-image.png' | shopify_asset_url }}" width="120" alt="{{ line.title | escape }}" style="display:block; max-width:120px; width:120px; height:auto; border:0;" />
                                              {% endif %}
                                            </a>
                                          </td>
                                        </tr>
                                      </tbody>
                                    </table>
                                  </td>
                                  <td style="padding-left: 30px;">
                                    <p style="font-weight: bold; color: #000000; font-family: lato, Helvetica, Tahoma, Verdana, Segoe, sans-serif; text-align: left; font-style: normal; letter-spacing: 2px; font-size: 18px; margin: 0px; text-transform: uppercase;">{{ line.title }} x {{ line.quantity }}</p>
                                    <p style="font-weight: normal; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Fira Sans', Droid Sans, 'Helvetica Neue', sans-serif; font-style: normal; letter-spacing: 1px; font-size: 16px; margin: 0px; color: #000000; text-align: left;">{{ product_attributes }}</p>
                                    {% assign strikeThrough = 'none' %}
                                    {% if recType == "RN" and line.refunded_quantity == 1 %}
                                      {% assign strikeThrough = 'line-through' %}
                                      <p style="font-weight: normal; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Fira Sans', Droid Sans, 'Helvetica Neue', sans-serif; font-style: normal; letter-spacing: 1px; font-size: 16px; margin: 0px; color: #000000; text-align: left;">Refunded</p>
                                    {% endif %}
                                    {% assign discountBool = false %}
                                    {% if line.discount_allocations %}
                                      {% for discount_allocation in line.discount_allocations %}
                                        {% if discount_allocation.discount_application.target_selection != 'all' %}
                                          {% if discount_allocation.amount > 0 %}
                                            {% assign discountBool = true %}
                                            {% assign strikeThrough = 'line-through' %}
                                            <p style="font-weight: normal; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Fira Sans', Droid Sans, 'Helvetica Neue', sans-serif; font-style: normal; letter-spacing: 1px; font-size: 16px; margin: 0px; color: #000000; text-align: left;">{{ discount_allocation.discount_application.title | upcase }} -({{ discount_allocation.amount | money }})</p>
                                          {% endif %}
                                        {% endif %}
                                      {% endfor %}
                                    {% endif %}
                                  </td>
                                  <td class="alignRight" style="padding-left: 10px; width: 20%;">
                                    <p style="font-weight: normal; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Fira Sans', Droid Sans, 'Helvetica Neue', sans-serif; font-style: normal; letter-spacing: 1px; font-size: 16px; margin: 0px; color: #000000; text-align: right; text-decoration: {{ strikeThrough }};">{{ line.original_line_price | money }}</p>
                                    {% if discountBool == true %}
                                      <p style="font-weight: normal; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Fira Sans', Droid Sans, 'Helvetica Neue', sans-serif; font-style: normal; letter-spacing: 1px; font-size: 16px; margin: 0px; color: #000000; text-align: right;">{{ line.final_line_price | money }}</p>
                                    {% endif %}
                                  </td>
                                </tr>
                              {% endfor %}
                            </tbody>
                          </table>
                        </td>
                      </tr>
                    </tbody>
                  </table>

                  <table cellspacing="0" cellpadding="0" width="100%" style="background-color: transparent; min-width: 100%; padding-left: 8px; padding-right: 8px;">
                    {% if recType == "IN" or recType == "DI" %}
                      {% assign taxTitle = "Estimated taxes" %}
                    {% else %}
                      {% assign taxTitle = "Taxes" %}
                    {% endif %}
                    {% assign up_order = order %}
                    <tbody>
                      <tr>
                        <td style="padding-top: 15px; padding-bottom: 15px;">
                          <table cellpadding="0" cellspacing="0" width="100%" style="min-width: 100%;">
                            <tbody>
                              {% for discount_application in up_order.discount_applications %}
                                {% if discount_application.target_selection == 'all' %}
                                  {% if discount_application.target_type == 'shipping_line' %}
                                    {% assign has_shipping_discount = true %}
                                    {% assign shipping_discount = discount_application.title %}
                                    {% assign shipping_amount = discount_application.total_allocated_amount %}
                                  {% else %}
                                    {% capture discount_title %}
                                      {% if discount_application.title %}
                                        {{ discount_application.title | upcase }}
                                      {% else %}
                                        Discount
                                      {% endif %}
                                    {% endcapture %}
                                    <tr>
                                      <td width="50%" style="font-weight: bold; font-style: normal; color: #080808; font-family: lato, Helvetica, Tahoma, Verdana, Segoe, sans-serif; text-transform: uppercase; letter-spacing: 2px; font-size: 21.2px; overflow-wrap: break-word; vertical-align: top; padding-bottom: 4px; text-align: left; min-width: 50%;">
                                        <span>Discount</span>
                                        <div style="font-weight: normal; font-style: normal; color: #000000; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Fira Sans', Droid Sans, 'Helvetica Neue', sans-serif; letter-spacing: 1px; font-size: 16px; overflow-wrap: break-word; vertical-align: top; padding-bottom: 4px; text-align: left;">
                                          <img src="{{ 'notifications/discounttag.png' | shopify_asset_url }}" width="18" height="18" class="discount-tag-icon" />
                                          <span>{{ discount_title }}</span>
                                        </div>
                                      </td>
                                      <td width="50%" style="font-weight: normal; font-style: normal; color: #000000; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Fira Sans', Droid Sans, 'Helvetica Neue', sans-serif; letter-spacing: 1px; font-size: 16px; overflow-wrap: break-word; vertical-align: top; padding-bottom: 4px; text-align: right; min-width: 50%;">
                                        -{{ discount_application.total_allocated_amount | money }}
                                      </td>
                                    </tr>
                                  {% endif %}
                                {% endif %}
                              {% endfor %}
                              <tr>
                                <td width="50%" style="font-weight: bold; font-style: normal; color: #080808; font-family: lato, Helvetica, Tahoma, Verdana, Segoe, sans-serif; text-transform: uppercase; letter-spacing: 2px; font-size: 21.2px; overflow-wrap: break-word; vertical-align: top; padding-bottom: 4px; text-align: left; min-width: 50%;">Subtotal</td>
                                <td width="50%" style="font-weight: normal; font-style: normal; color: #000000; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Fira Sans', Droid Sans, 'Helvetica Neue', sans-serif; letter-spacing: 1px; font-size: 16px; overflow-wrap: break-word; vertical-align: top; padding-bottom: 4px; text-align: right; min-width: 50%;">
                                  {{ up_order.subtotal_price | money }}
                                </td>
                              </tr>
                              <tr>
                                <td width="50%" style="font-weight: bold; font-style: normal; color: #080808; font-family: lato, Helvetica, Tahoma, Verdana, Segoe, sans-serif; text-transform: uppercase; letter-spacing: 2px; font-size: 21.2px; overflow-wrap: break-word; vertical-align: top; padding-bottom: 4px; text-align: left; min-width: 50%;">
                                  <span>{% if up_order.delivery_method == 'pick-up' %}Pickup{% else %}Shipping{% endif %}</span>
                                  <div style="font-weight: normal; font-style: normal; color: #000000; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Fira Sans', Droid Sans, 'Helvetica Neue', sans-serif; letter-spacing: 1px; font-size: 16px; overflow-wrap: break-word; vertical-align: top; padding-bottom: 4px; text-align: left; display: {% if has_shipping_discount == true %}block{% else %}none{% endif %};">
                                    <img src="{{ 'notifications/discounttag.png' | shopify_asset_url }}" width="18" height="18" class="discount-tag-icon" />
                                    <span>{{ shipping_discount }}(-{{ shipping_amount | money }})</span>
                                  </div>
                                </td>
                                <td width="50%" style="font-weight: normal; font-style: normal; color: #000000; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Fira Sans', Droid Sans, 'Helvetica Neue', sans-serif; letter-spacing: 1px; font-size: 16px; overflow-wrap: break-word; vertical-align: top; padding-bottom: 4px; text-align: right; min-width: 50%;">
                                  {% if has_shipping_discount == true %}free{% else %}{{ up_order.shipping_method.price | default: 0 | money }}{% endif %}
                                </td>
                              </tr>
                              <tr>
                                <td width="50%" style="font-weight: bold; font-style: normal; color: #080808; font-family: lato, Helvetica, Tahoma, Verdana, Segoe, sans-serif; text-transform: uppercase; letter-spacing: 2px; font-size: 21.2px; overflow-wrap: break-word; vertical-align: top; padding-bottom: 4px; text-align: left; min-width: 50%;">
                                  {{ taxTitle }}
                                </td>
                                <td width="50%" style="font-weight: normal; font-style: normal; color: #000000; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Fira Sans', Droid Sans, 'Helvetica Neue', sans-serif; letter-spacing: 1px; font-size: 16px; overflow-wrap: break-word; vertical-align: top; padding-bottom: 4px; text-align: right; min-width: 50%;">
                                  {{ up_order.tax_price | money }}
                                </td>
                              </tr>
                            </tbody>
                          </table>
                          <table cellpadding="0" cellspacing="0" width="100%" style="min-width: 100%; margin-bottom: 5px">
                            <tbody>
                              <tr>
                                <td width="50%" style="vertical-align: top; text-align: left;">
                                  <h2 style="margin: 0px; font-weight: bold; font-style: normal; color: #080808; font-family: lato, Helvetica, Tahoma, Verdana, Segoe, sans-serif; text-transform: uppercase; letter-spacing: 2px; font-size: 21.2px; overflow-wrap: break-word;">Total</h2>
                                </td>
                                <td width="50%" style="vertical-align: top; text-align: right;">
                                  <h2 style="margin: 0px; font-weight: bold; font-style: normal; color: #080808; font-family: lato, Helvetica, Tahoma, Verdana, Segoe, sans-serif; text-align: inherit; text-transform: uppercase; letter-spacing: 2px; font-size: 21.2px; overflow-wrap: break-word;">
                                    {{ up_order.total_price | money_with_currency }}
                                  </h2>
                                </td>
                              </tr>
                            </tbody>
                          </table>
                          {% if up_order.total_discounts > 0 %}
                            <table cellpadding="0" cellspacing="0" width="100%" style="min-width: 100%; margin-bottom: 5px">
                              <tbody>
                                <tr>
                                  <td width="50%" style="vertical-align: top; text-align: left;"></td>
                                  <td width="50%" style="vertical-align: top; text-align: right;">
                                    <div style="font-weight: normal; font-style: normal; color: #000000; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Fira Sans', Droid Sans, 'Helvetica Neue', sans-serif; letter-spacing: 1px; font-size: 16px; overflow-wrap: break-word; vertical-align: top; padding-bottom: 4px; text-align: right; min-width: 50%;">
                                      You saved {{ up_order.total_discounts | money }}
                                    </div>
                                  </td>
                                </tr>
                              </tbody>
                            </table>
                          {% endif %}
                          <table cellpadding="0" cellspacing="0" width="100%" style="min-width: 100%;">
                            <tbody>
                              {% assign totalRefund = 0 %}
                              {% assign transactionAmount = 0 %}
                              {% assign transaction_size = 0 %}
                              {% for transaction in transactions %}
                                {% unless transaction.kind == 'authorization' or transaction.kind == 'void' %}
                                  {% assign transaction_size = transaction_size | plus: 1 %}
                                {% endunless %}
                              {% endfor %}
                              {% if transaction_size > 1 %}
                                {% for transaction in transactions %}
                                  {% if transaction.status == "success" and transaction.kind == "capture" or transaction.kind == "sale" %}
                                    {% assign transactionAmount = transactionAmount | plus: transaction.amount %}
                                  {% elsif transaction.kind == 'refund' %}
                                    {% if transaction.payment_details.credit_card_company %}
                                      {% assign refund_method_title = transaction.payment_details.credit_card_company %}
                                      {% assign totalRefund = totalRefund | plus: transaction.amount %}
                                      {% assign lastFourDigits = transaction.payment_details.credit_card_last_four_digits %}
                                    {% else %}
                                      {% assign refund_method_title = transaction.gateway %}
                                      {% assign totalRefund = totalRefund | plus: transaction.amount %}
                                    {% endif %}
                                  {% endif %}
                                {% endfor %}
                              {% endif %}
                              {% if totalRefund > 0 %}
                                <tr>
                                  <td width="50%" style=" font-weight: bold; font-style: normal; color: #080808; font-family: lato, Helvetica, Tahoma, Verdana, Segoe, sans-serif; text-transform: uppercase; letter-spacing: 2px; font-size: 21.2px; overflow-wrap: break-word; vertical-align: top; padding-bottom: 4px; text-align: left; min-width: 50%;">
                                    {{ refund_method_title | replace: '_', ' ' | capitalize }}
                                    <span style="font-size: 13px;">{% if lastFourDigits %}(ending in {{ lastFourDigits }}){% endif %}</span>
                                  </td>
                                  <td width="50%" style="font-weight: normal; font-style: normal; color: #000000; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Fira Sans', Droid Sans, 'Helvetica Neue', sans-serif; letter-spacing: 1px; font-size: 16px; overflow-wrap: break-word; vertical-align: top; padding-bottom: 4px; text-align: right; min-width: 50%;">
                                    {{ transactionAmount | money }}
                                  </td>
                                </tr>
                                <tr>
                                  <td width="50%" style="font-weight: bold; font-style: normal; color: #080808; font-family: lato, Helvetica, Tahoma, Verdana, Segoe, sans-serif; text-transform: uppercase; letter-spacing: 2px; font-size: 21.2px; overflow-wrap: break-word; vertical-align: top; padding-bottom: 4px; text-align: left; min-width: 50%;">Refund</td>
                                  <td width="50%" style="font-weight: normal; font-style: normal; color: #000000; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Fira Sans', Droid Sans, 'Helvetica Neue', sans-serif; letter-spacing: 1px; font-size: 16px; overflow-wrap: break-word; vertical-align: top; padding-bottom: 4px; text-align: right; min-width: 50%;">
                                    -{{ totalRefund | money }}
                                  </td>
                                </tr>
                                <tr>
                                  <td width="50%" style="font-weight: normal; font-style: normal; color: #000000; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Fira Sans', Droid Sans, 'Helvetica Neue', sans-serif; letter-spacing: 1px; font-size: 16px; overflow-wrap: break-word; vertical-align: top; padding-bottom: 4px; text-align: left; min-width: 50%;">
                                    {{ refund_method_title | replace: '_', ' ' | capitalize }}
                                  </td>
                                </tr>
                              {% endif %}
                            </tbody>
                          </table>
                        </td>
                      </tr>
                    </tbody>
                  </table>
                  <table style="mso-table-lspace: 0; mso-table-rspace: 0;" cellpadding="0" cellspacing="0" width="100%" style="min-width: 100%"><tbody><tr><td style="height: 10px; min-height: 10px"></td></tr></tbody></table>

                  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="border-collapse:collapse; width:100%; background-color:#f0f5f0;">
                    <tr>
                      <td align="center" style="padding:30px 20px 25px;">
                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:760px; margin:0 auto;">
