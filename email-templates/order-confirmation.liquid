                            <td align="center" style="font-family:Arial, Helvetica, sans-serif; font-size:24px; line-height:30px; font-weight:700; letter-spacing:3px; color:#333333; padding-bottom:28px;">
                              STAY CONNECTED
                            </td>
                          </tr>
                        </table>
                        <table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center">
                          <tr>
                            <td align="center" style="padding:0 12px;">
                              <a href="https://api.uporder.com/api/spently/click?id={{ order_number }}&store=n88nm1-zy&type=OI&cid={{ customer.id }}&url=https%3A%2F%2Fwww.instagram.com%2Fshop.littlejoyco%2F&s={{ "n88nm1-zypantastic" | append: "https://www.instagram.com/shop.littlejoyco/" | url_decode | sha256 }}" target="_blank" style="display:inline-block; width:48px; height:48px; border:2px solid #9d9d9d; border-radius:50%; text-decoration:none; color:#555555; font-family:Arial, Helvetica, sans-serif; font-size:21px; line-height:48px; text-align:center;">◎</a>
