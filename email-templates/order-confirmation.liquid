                        <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                          <tr>
                            <td align="center" style="font-family: Parisienne, 'Brush Script MT', cursive; font-size:30px; line-height:38px; font-style:italic; color:#4f4f4f; padding-top:25px;">
                              Carefully designed for everyday parenting.
