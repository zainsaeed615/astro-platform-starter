              <!-- LINE ITEMS -->
              <tr>
                <td class="section-padding" style="padding: 8px 16px 0;">
                  <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" style="border-collapse: collapse; min-width: 100%;">
                    <tbody>
                      {% for fulfillment_item in fulfillment.fulfillment_line_items %}
                        {% assign line = fulfillment_item.line_item %}
                        {% capture product_attributes %}
                          {% for p in line.properties %}
                            {% assign stringToCheck = p.first %}
                            {% assign containsStartsWith = false %}
                            {% assign checkString = stringToCheck | slice: 0 %}
                            {% if checkString == '_' %}
                              {% assign containsStartsWith = true %}
                            {% else %}
                              {% assign containsStartsWith = false %}
                            {% endif %}
                            {% unless p.last == blank or p.first contains '_options' or containsStartsWith == true %}
                              <br />{{ p.first }}: {{ p.last }}
                            {% endunless %}
                          {% endfor %}
                        {% endcapture %}

                        {% assign strikeThrough = 'none' %}
                        {% if recType == "RN" and line.refunded_quantity == 1 %}
                          {% assign strikeThrough = 'line-through' %}
                        {% endif %}

                        {% assign discountBool = false %}
                        {% if line.discount_allocations %}
                          {% for discount_allocation in line.discount_allocations %}
                            {% if discount_allocation.discount_application.target_selection != 'all' and discount_allocation.amount > 0 %}
                              {% assign discountBool = true %}
                              {% assign strikeThrough = 'line-through' %}
                            {% endif %}
                          {% endfor %}
                        {% endif %}

                        {% comment %}
                          Use live catalog images first so updated product/variant photos appear in sent emails.
                          line.image is an order snapshot and is only a fallback.
                          Size-only img_url (no crop/scale) avoids stale Shopify CDN crop derivatives.
                        {% endcomment %}
                        {% assign line_image_src = '' %}
                        {% if line.variant.image != blank %}
                          {% assign line_image_src = line.variant | img_url: '240x240' %}
                          {% if line_image_src == blank %}
                            {% assign line_image_src = line.variant.image | img_url: '240x240' %}
                          {% endif %}
                        {% endif %}
                        {% if line_image_src == blank and line.product.featured_image != blank %}
                          {% assign line_image_src = line.product | img_url: '240x240' %}
                          {% if line_image_src == blank %}
                            {% assign line_image_src = line.product.featured_image | img_url: '240x240' %}
                          {% endif %}
                        {% endif %}
                        {% if line_image_src == blank and line.image != blank %}
                          {% assign line_image_src = line | img_url: 'compact_cropped' %}
                          {% if line_image_src == blank %}
                            {% assign line_image_src = line.image | img_url: '240x240' %}
                          {% endif %}
                        {% endif %}

                        {% assign line_display_qty = fulfillment_item.quantity %}
                        {% if line_display_qty == blank or line_display_qty == 0 %}
                          {% assign line_display_qty = line.quantity %}
                        {% endif %}

                        <tr>
                          <td style="padding: 14px 0; border-bottom: 1px solid #ECE6DC;">
                            <table role="presentation" cellpadding="0" cellspacing="0" border="0" width="100%" class="line-item-row" style="border-collapse: collapse;">
                              <tr>
                                <td class="line-item-img" width="120" valign="top" style="width: 120px; padding: 0 12px 0 0; vertical-align: top;">
                                  <a data-component="LineItems" href="https://api.uporder.com/api/spently/click?id={{ order_number }}&store=n88nm1-zy&type=SC&cid={{ customer.id }}&url={{ shop.url }}{{ line.url }}&s={{ "n88nm1-zypantastic" | append: "" | append: shop.url | append: "" | append: line.url | append: "" | url_decode | sha256 }}&component=LineItems" target="_blank" style="text-decoration: none;">
                                    {% if line_image_src != blank %}
                                      <img src="{{ line_image_src }}" width="120" height="120" alt="{{ line.title | escape }}" style="display: block; max-width: 120px; width: 120px; height: auto; border: 0; margin: 0; object-fit: cover;" />
                                    {% else %}
                                      <img src="{{ 'notifications/no-image.png' | shopify_asset_url }}" width="120" height="120" alt="{{ line.title | escape }}" style="display: block; max-width: 120px; width: 120px; height: auto; border: 0; margin: 0;" />
                                    {% endif %}
                                  </a>
                                </td>
                                <td class="line-item-details" valign="top" style="padding: 0 8px 0 0; vertical-align: top;">
                                  <p style="margin: 0 0 6px; font-family: Lato, Helvetica, Tahoma, Verdana, Segoe, sans-serif; font-size: 16px; line-height: 22px; font-weight: 700; color: #080808; text-align: left; letter-spacing: 1px; text-transform: uppercase;">
                                    {{ line.title }} x {{ line_display_qty }}
                                  </p>
                                  {% if product_attributes != blank %}
                                    <p style="margin: 0 0 6px; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen-Sans, Ubuntu, Cantarell, 'Fira Sans', Droid Sans, 'Helvetica Neue', sans-serif; font-size: 14px; line-height: 20px; font-weight: 400; color: #000000; text-align: left;">
                                      {{ product_attributes }}
                                    </p>
                                  {% endif %}
                                  {% if recType == "RN" and line.refunded_quantity == 1 %}
                                    <p style="margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 14px; line-height: 20px; color: #000000; text-align: left;">Refunded</p>
                                  {% endif %}
                                  {% if line.discount_allocations %}
                                    {% for discount_allocation in line.discount_allocations %}
                                      {% if discount_allocation.discount_application.target_selection != 'all' and discount_allocation.amount > 0 %}
                                        <p style="margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 14px; line-height: 20px; color: #000000; text-align: left;">
                                          {{ discount_allocation.discount_application.title | upcase }} - ({{ discount_allocation.amount | money }})
                                        </p>
                                      {% endif %}
                                    {% endfor %}
                                  {% endif %}
                                </td>
                                <td class="line-item-price" width="90" valign="top" align="right" style="width: 90px; vertical-align: top; text-align: right;">
                                  <p style="margin: 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 14px; line-height: 20px; color: #000000; text-align: right; text-decoration: {{ strikeThrough }};">
                                    {{ line.original_line_price | money }}
                                  </p>
                                  {% if discountBool == true %}
                                    <p style="margin: 4px 0 0; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-size: 14px; line-height: 20px; color: #000000; text-align: right;">
                                      {{ line.final_line_price | money }}
                                    </p>
                                  {% endif %}
                                </td>
                              </tr>
                            </table>
                          </td>
                        </tr>
                      {% endfor %}
                    </tbody>
                  </table>
                </td>
              </tr>

              <tr>
                <td style="height: 24px; line-height: 24px; font-size: 1px;">&nbsp;</td>
