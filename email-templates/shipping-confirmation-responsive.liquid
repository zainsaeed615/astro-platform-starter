                              <svg viewBox="0 0 64 64" width="52" height="42" style="display: block; margin: 0 auto; max-width: 100%; height: auto;" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M32 54 L29.5 51.6 C18 41.2 11 34.8 11 25.8 C11 18.8 16.2 14 22.8 14 C27 14 30.2 16.2 32 19 C33.8 16.2 37 14 41.2 14 C47.8 14 53 18.8 53 25.8 C53 34.8 46 41.2 34.5 51.6 Z" fill="none" stroke="#BC9C70" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" />
                              </svg>
                            </td>
                          </tr>
                          <tr>
                            <td align="center" class="arrival-label" style="font-family: Lato, Helvetica, Arial, sans-serif; font-size: 20px; line-height: 26px; font-weight: 400; color: #333333; padding-bottom: 8px;">
                              Estimated arrival:
                            </td>
                          </tr>
                          <tr>
                            <td align="center" class="arrival-date" style="font-family: Lato, Helvetica, Arial, sans-serif; font-size: 25px; line-height: 32px; font-weight: 700; color: #111111;">
                              {% if fulfillment.estimated_delivery_at %}
                                {{ fulfillment.estimated_delivery_at | date: "%B %-d" }}
                              {% elsif fulfillment.tracking_company %}
                                On its way — check tracking for delivery updates
                              {% else %}
                                Delivery estimate available in your tracking link
