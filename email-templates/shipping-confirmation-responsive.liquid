                              <p class="shipping-text word-break" style="margin: 0 0 6px; font-family: Lato, Helvetica, Arial, sans-serif; font-size: 18px; line-height: 28px; font-weight: 400; color: #3D3D3D;">
                                {{ shipping_address.address1 }}{% if shipping_address.address2 != blank %}, {{ shipping_address.address2 }}{% endif %}
