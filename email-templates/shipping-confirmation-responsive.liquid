{% capture paid_with %}
  {% if payment_details.credit_card_company %}{{ payment_details.credit_card_company }}
  {% elsif gateway %}{{ gateway }}{% endif %}
{% endcapture %}

{% capture tracking_link %}
  {% if order_status_url %}{{ order_status_url }}
  {% elsif fulfillment.tracking_link %}{{ fulfillment.tracking_link }}
  {% elsif fulfillment.tracking_url %}{{ fulfillment.tracking_url }}
  {% else %}{{ shop.url }}{% endif %}
{% endcapture %}

{% if fulfillment.items_count == item_count %}
  {% capture shipment_name %}Your order is{% endcapture %}
{% elsif fulfillment.item_count > 1 %}
  {% if fulfillment_status == 'fulfilled' %}
    {% capture shipment_name %}the last items {% endcapture %}
  {% else %}
    {% capture shipment_name %}Some items {% endcapture %}
  {% endif %}
{% else %}
  {% if fulfillment_status == 'fulfilled' %}
    {% capture shipment_name %}The last item {% endcapture %}
  {% else %}
    {% capture shipment_name %}One item {% endcapture %}
  {% endif %}
{% endif %}

{% assign uporder_order_id = order.id %}
{% assign uporder_customer_id = customer.id %}

