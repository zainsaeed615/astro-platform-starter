---
import { SPEC_SHEET_URL } from '../data/site';

interface Props {
    title?: string;
    text?: string;
}

const {
    title = 'Get Started with UltraHMB™',
    text = 'Bring UltraHMB™ into your next formulation. Pull the technical documentation or talk through your formulation with a Vesta® ingredient specialist.'
} = Astro.props;
---

<section class="relative overflow-hidden bg-navy text-white">
    <div class="blob -left-10 top-0 h-72 w-72 bg-blue/35"></div>
    <div class="blob -right-8 bottom-0 h-64 w-64 bg-cyan/25"></div>
    <div class="container-site section-pad relative text-center">
        <h2 class="text-white reveal">{title}</h2>
        <p class="mx-auto mt-4 max-w-2xl text-base text-white/80 sm:text-lg reveal" style="transition-delay: 90ms">{text}</p>
        <div class="mt-9 flex flex-wrap items-center justify-center gap-4 reveal" style="transition-delay: 160ms">
            <a href={SPEC_SHEET_URL} target="_blank" rel="noopener noreferrer" class="btn pulse-glow">
                Download Spec Sheet
            </a>
            <a href="/contact" class="btn-outline">Contact Us</a>
        </div>
    </div>
</section>
