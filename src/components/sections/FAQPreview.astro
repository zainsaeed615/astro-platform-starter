---
import { homeFaqs } from '../../content/faq';
import SectionHeading from '../ui/SectionHeading.astro';
import FAQAccordion from '../ui/FAQAccordion';
---

<section class="section-pdq bg-pdq-light">
  <div class="container-pdq">
    <div class="mx-auto max-w-3xl">
      <SectionHeading
        eyebrow="FAQ"
        title="Common Questions"
        lead="Quick answers before you request an estimate. More details on our full FAQ page."
        align="center"
      />

      <div class="mt-12">
        <FAQAccordion client:load items={homeFaqs} />
      </div>

      <div class="mt-10 text-center">
        <a href="/faq" class="btn-outline">View All FAQs</a>
      </div>
    </div>
  </div>
</section>
