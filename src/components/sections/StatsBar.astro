---
import { stats } from '../../content/site';
---

<section class="relative overflow-hidden surface-dark text-white">
  <div
    class="pointer-events-none absolute inset-y-0 left-1/2 hidden w-px bg-white/10 md:block"
    aria-hidden="true"
  ></div>
  <div class="container-pdq py-16 md:py-20">
    <div class="grid grid-cols-2 gap-10 lg:grid-cols-4 lg:gap-8">
      {
        stats.map((stat, index) => (
          <div
            class:list={[
              'reveal text-center lg:text-left',
              index > 0 && 'lg:border-l lg:border-white/10 lg:pl-8',
            ]}
            style={`transition-delay: ${index * 90}ms`}
          >
            <p class="font-display text-5xl md:text-6xl lg:text-7xl leading-none text-white">
              {stat.value}
            </p>
            <div class="mx-auto mt-3 h-0.5 w-10 bg-pdq-red lg:mx-0"></div>
            <p class="mt-3 text-[11px] font-bold uppercase tracking-[0.2em] text-white/70">
              {stat.label}
            </p>
          </div>
        ))
      }
    </div>
  </div>
</section>
