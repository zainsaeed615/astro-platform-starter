---
import { featuredProjects } from '../../content/portfolio';
---

<section class="section-pdq bg-white overflow-hidden">
  <div class="container-pdq">
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between reveal">
      <div class="max-w-2xl">
        <p class="section-eyebrow">Portfolio</p>
        <h2 class="section-heading">
          Work That Speaks
          <span class="text-pdq-red"> Louder Than Words</span>
        </h2>
        <p class="section-lead">
          Real Sacramento-area projects — remodeling, additions, kitchens, and custom builds.
        </p>
      </div>
      <a href="/portfolio" class="btn-outline shrink-0 self-start md:self-auto">Full Portfolio</a>
    </div>

    <div class="mt-14 grid gap-4 md:grid-cols-12 md:auto-rows-[220px]">
      {
        featuredProjects.map((project, i) => {
          const spans = [
            'md:col-span-7 md:row-span-2',
            'md:col-span-5 md:row-span-1',
            'md:col-span-5 md:row-span-1',
            'md:col-span-4 md:row-span-1',
            'md:col-span-4 md:row-span-1',
            'md:col-span-4 md:row-span-1',
          ];
          return (
            <a
              href="/portfolio"
              class:list={[
                'group relative isolate overflow-hidden no-underline min-h-[240px] reveal',
                spans[i] || 'md:col-span-4',
              ]}
              style={`transition-delay: ${i * 60}ms`}
            >
              <img
                src={project.image}
                alt={project.title}
                class="absolute inset-0 h-full w-full object-cover transition duration-700 group-hover:scale-110"
                width="900"
                height="700"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-pdq-navy-dark via-pdq-navy-dark/30 to-transparent opacity-90 transition group-hover:opacity-100" />
              <div class="absolute inset-x-0 bottom-0 p-5 md:p-7">
                <span class="inline-block bg-pdq-red px-2.5 py-1 text-[10px] font-bold uppercase tracking-[0.18em] text-white">
                  {project.categoryLabel}
                </span>
                <h3 class="mt-3 font-display text-2xl md:text-3xl text-white leading-none">
                  {project.title}
                </h3>
                <p class="mt-2 text-sm text-white/75 normal-case tracking-normal">{project.location}</p>
              </div>
            </a>
          );
        })
      }
    </div>
  </div>
</section>
