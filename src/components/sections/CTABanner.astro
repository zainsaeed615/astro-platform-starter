---
import { site } from '../../content/site';
---

<section class="relative overflow-hidden">
  <div
    class="absolute inset-0 bg-gradient-to-br from-pdq-navy-dark via-pdq-navy to-pdq-navy-mid"
    aria-hidden="true"
  ></div>
  <div
    class="absolute inset-y-0 right-0 w-1/3 bg-gradient-to-l from-pdq-red/40 to-transparent"
    aria-hidden="true"
  ></div>
  <div
    class="absolute -bottom-24 -left-24 h-64 w-64 rounded-full bg-pdq-red/20 blur-3xl"
    aria-hidden="true"
  ></div>

  <div class="relative z-10 container-pdq section-pdq">
    <div class="mx-auto max-w-3xl text-center">
      <p class="section-eyebrow !text-white/90 mb-4">Ready to Build?</p>
      <h2 class="font-display text-3xl md:text-4xl lg:text-5xl font-bold text-white leading-tight">
        Request Your Free Estimate
      </h2>
      <div class="divider-accent mx-auto mt-6"></div>
      <p class="mt-6 text-base md:text-lg text-white/85 leading-relaxed">
        Tell us about your remodel, addition, or commercial project. We will follow up with a clear
        next step — no obligation.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
        <a href="/contact" class="btn-primary">Request Free Estimate</a>
        <a href={site.phoneHref} class="btn-secondary">
          Call {site.phone}
        </a>
      </div>
    </div>
  </div>
</section>
