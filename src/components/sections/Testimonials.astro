---
import { testimonials } from '../../content/testimonials';

const featured = testimonials.slice(0, 3);
---

<section class="section-pdq surface-grid overflow-hidden">
  <div class="container-pdq">
    <div class="max-w-3xl mx-auto text-center reveal">
      <p class="section-eyebrow !mx-auto">Client Stories</p>
      <h2 class="section-heading">
        Trusted Across the
        <span class="text-pdq-red"> Sacramento Valley</span>
      </h2>
      <p class="section-lead mx-auto">
        Homeowners and property owners who chose licensed craftsmanship — and got results.
      </p>
    </div>

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {
        featured.map((item, i) => (
          <blockquote
            class="relative flex flex-col border border-pdq-border/70 bg-white p-7 md:p-8 shadow-[0_20px_50px_-30px_rgba(15,36,64,0.35)] reveal"
            style={`transition-delay: ${i * 80}ms`}
          >
            <span
              class="font-display text-7xl leading-none text-pdq-red/20 absolute top-4 right-6"
              aria-hidden="true"
            >
              “
            </span>
            <div class="mb-5 flex gap-1" aria-label={`${item.rating} out of 5 stars`}>
              {Array.from({ length: item.rating }).map(() => (
                <svg class="h-4 w-4 text-pdq-red" viewBox="0 0 20 20" fill="currentColor">
                  <path d="M10 1.5l2.47 5.01 5.53.8-4 3.9.94 5.5L10 14.4l-4.94 2.6.94-5.5-4-3.9 5.53-.8L10 1.5z" />
                </svg>
              ))}
            </div>
            <p class="flex-1 text-base leading-relaxed text-pdq-navy/85 font-medium normal-case tracking-normal">
              {item.quote}
            </p>
            <footer class="mt-8 flex items-center gap-3 border-t border-pdq-border pt-5">
              <span class="flex h-11 w-11 items-center justify-center bg-pdq-navy font-display text-lg text-white">
                {item.name.charAt(0)}
              </span>
              <div>
                <cite class="not-italic font-display text-xl text-pdq-navy leading-none">
                  {item.name}
                </cite>
                <p class="mt-1 text-xs font-bold uppercase tracking-[0.14em] text-pdq-muted">
                  {item.location}
                </p>
              </div>
            </footer>
          </blockquote>
        ))
      }
    </div>
  </div>
</section>
