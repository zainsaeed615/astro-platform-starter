---
import { homeProcessSteps } from '../../content/process';
---

<section class="section-pdq surface-dark text-white overflow-hidden">
  <div class="container-pdq">
    <div class="max-w-3xl reveal">
      <p class="section-eyebrow !text-pdq-red">How We Work</p>
      <h2 class="section-heading !text-white">
        From First Call to
        <span class="text-pdq-red"> Final Walkthrough</span>
      </h2>
      <p class="section-lead !text-white/75">
        A clear, premium process — Pretty Darn Quick, without cutting corners.
      </p>
    </div>

    <ol class="relative mt-16 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
      <div
        class="pointer-events-none absolute left-[12%] right-[12%] top-12 hidden h-px bg-gradient-to-r from-transparent via-pdq-red/60 to-transparent lg:block"
        aria-hidden="true"
      ></div>
      {
        homeProcessSteps.map((step, i) => (
          <li
            class="group relative border border-white/10 bg-white/[0.04] p-6 md:p-7 backdrop-blur-sm transition duration-500 hover:-translate-y-1.5 hover:border-pdq-red/50 hover:bg-white/[0.07] reveal"
            style={`transition-delay: ${i * 80}ms`}
          >
            <span class="font-display text-6xl leading-none text-pdq-red/40 transition group-hover:text-pdq-red">
              {step.number}
            </span>
            <h3 class="mt-5 font-display text-2xl text-white leading-none">{step.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-white/70 normal-case tracking-normal font-medium">
              {step.summary}
            </p>
          </li>
        ))
      }
    </ol>

    <div class="mt-12 reveal">
      <a href="/process" class="btn-primary">See Full Process</a>
    </div>
  </div>
</section>
