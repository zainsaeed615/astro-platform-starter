---
import { whyChooseUs } from '../../content/testimonials';
---

<section class="section-pdq bg-white overflow-hidden">
  <div class="container-pdq">
    <div class="grid gap-12 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-4 reveal">
        <p class="section-eyebrow">Why PDQ</p>
        <h2 class="section-heading">
          Built for Clients Who
          <span class="text-pdq-red"> Expect More</span>
        </h2>
        <p class="section-lead">
          Licensed accountability, transparent pricing, and craftsmanship that lasts.
        </p>
        <a href="/contact" class="btn-navy mt-8">Start Your Project</a>
      </div>

      <div class="lg:col-span-8 grid gap-4 sm:grid-cols-2">
        {
          whyChooseUs.map((item, i) => (
            <div
              class="group relative overflow-hidden border border-pdq-border/80 bg-pdq-light/60 p-6 transition duration-500 hover:bg-pdq-navy hover:border-pdq-navy reveal"
              style={`transition-delay: ${i * 60}ms`}
            >
              <span class="font-display text-4xl text-pdq-red/30 transition group-hover:text-pdq-red/60">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3 class="mt-3 font-display text-xl text-pdq-navy leading-none transition group-hover:text-white">
                {item.title}
              </h3>
              <p class="mt-3 text-sm leading-relaxed text-pdq-muted normal-case tracking-normal font-medium transition group-hover:text-white/80">
                {item.description}
              </p>
              <div class="absolute bottom-0 left-0 h-0.5 w-0 bg-pdq-red transition-all duration-500 group-hover:w-full" />
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
