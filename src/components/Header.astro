---
import Logo from './Logo.astro';
import { navItems } from '../data/site';

interface Props {
    currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const isActive = (href: string) => {
    if (href === '/') return currentPath === '/';
    return currentPath === href || currentPath.startsWith(`${href}/`);
};

const appsActive = currentPath.startsWith('/applications');
---

<header id="site-header" class="site-header">
    <div class="container-site flex items-center justify-between gap-4 py-3.5 sm:py-4">
        <Logo class="transition-transform duration-300 hover:scale-[1.02]" />

        <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
            {
                navItems.map((item) =>
                    'children' in item && item.children ? (
                        <div class="relative group">
                            <button
                                type="button"
                                class:list={['nav-link inline-flex items-center gap-1 px-3 py-2', appsActive && 'is-active']}
                                aria-expanded="false"
                                aria-haspopup="true"
                            >
                                {item.label}
                                <svg class="h-3.5 w-3.5 opacity-70 transition duration-300 group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                                </svg>
                            </button>
                            <div class="invisible absolute left-0 top-full z-20 min-w-72 translate-y-2 rounded-2xl border border-white/70 bg-white/90 p-2 opacity-0 shadow-lift backdrop-blur-xl transition duration-300 group-hover:visible group-hover:translate-y-1 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-1 group-focus-within:opacity-100">
                                {item.children.map((child) => (
                                    <a
                                        href={child.href}
                                        class:list={[
                                            'block rounded-xl px-4 py-3 text-sm text-navy/80 no-underline transition hover:bg-blue/5 hover:text-blue',
                                            isActive(child.href) && 'bg-blue/5 font-semibold text-blue'
                                        ]}
                                    >
                                        {child.label}
                                    </a>
                                ))}
                            </div>
                        </div>
                    ) : (
                        <a href={item.href} class:list={['nav-link px-3 py-2', isActive(item.href) && 'is-active']}>
                            {item.label}
                        </a>
                    )
                )
            }
        </nav>

        <a href="/contact" class="btn hidden lg:inline-flex">Contact Us</a>

        <button
            type="button"
            id="mobile-nav-toggle"
            class="inline-flex h-11 w-11 items-center justify-center rounded-xl border border-line/80 bg-white/70 text-navy shadow-sm backdrop-blur transition hover:border-blue/30 hover:text-blue lg:hidden"
            aria-expanded="false"
            aria-controls="mobile-nav"
            aria-label="Open menu"
        >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
        </button>
    </div>

    <div id="mobile-nav" class="mobile-drawer border-t border-line/60 bg-white/95 backdrop-blur-xl lg:hidden" hidden>
        <div>
            <nav class="container-site flex flex-col gap-1 py-5" aria-label="Mobile">
                {
                    navItems.map((item) =>
                        'children' in item && item.children ? (
                            <details class="group rounded-xl border border-line/70 bg-surface/60 px-3 pb-2">
                                <summary class="flex cursor-pointer list-none items-center justify-between py-3 text-sm font-medium text-navy">
                                    {item.label}
                                    <svg class="h-4 w-4 transition group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor">
                                        <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                                    </svg>
                                </summary>
                                <div class="flex flex-col pb-2 pl-2">
                                    {item.children.map((child) => (
                                        <a href={child.href} class="rounded-lg py-2.5 pl-2 text-sm text-navy/75 no-underline hover:bg-white hover:text-blue">
                                            {child.label}
                                        </a>
                                    ))}
                                </div>
                            </details>
                        ) : (
                            <a
                                href={item.href}
                                class:list={[
                                    'rounded-xl border border-transparent px-3 py-3 text-sm font-medium text-navy no-underline transition hover:border-line hover:bg-surface hover:text-blue',
                                    isActive(item.href) && 'border-blue/20 bg-blue/5 text-blue'
                                ]}
                            >
                                {item.label}
                            </a>
                        )
                    )
                }
                <a href="/contact" class="btn mt-3">Contact Us</a>
            </nav>
        </div>
    </div>
</header>
