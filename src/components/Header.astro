---
import Logo from '../components/Logo.astro';

const navItems = [
    { linkText: 'Services', href: '/#services' },
    { linkText: 'Process', href: '/#process' },
    { linkText: 'Projects', href: '/#projects' },
    { linkText: 'Reviews', href: '/#reviews' },
    { linkText: 'Areas', href: '/#areas' }
];
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-white/70 bg-white/85 shadow-sm shadow-slate-900/5 backdrop-blur-xl">
    <nav class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8" aria-label="Primary navigation">
        <a href="/" class="plain-link shrink-0" aria-label="Koalaty Home Repairs home">
        <Logo />
    </a>
    {
        !!navItems?.length && (
                <ul class="hidden items-center gap-1 rounded-full border border-slate-200 bg-white/80 p-1 shadow-sm lg:flex">
                {navItems.map((item) => (
                    <li>
                            <a href={item.href} class="plain-link rounded-full px-4 py-2 text-sm font-semibold text-slate-600 transition hover:bg-slate-100 hover:text-slate-950">
                            {item.linkText}
                        </a>
                    </li>
                ))}
            </ul>
        )
    }
        <div class="flex items-center gap-2">
            <a href="tel:+15046717363" class="plain-link hidden rounded-full border border-slate-200 bg-white px-4 py-2 text-sm font-bold text-slate-900 shadow-sm transition hover:-translate-y-0.5 hover:border-primary/40 hover:text-primary sm:inline-flex">
                Call +1 504-671-7363
            </a>
            <a href="/#quote" class="plain-link rounded-full bg-primary px-4 py-2 text-sm font-bold text-white shadow-lg shadow-primary/25 transition hover:-translate-y-0.5 hover:bg-primary/90 sm:px-5">
                Free Quote
            </a>
        </div>
    </nav>
</header>
