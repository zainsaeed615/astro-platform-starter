---
import Logo from './Logo.astro';
import { navItems } from '../data/site';
---

<header class="sticky top-0 z-50 border-b border-line/80 bg-white/95 backdrop-blur">
    <div class="container-site flex items-center justify-between gap-4 py-3 sm:py-4">
        <Logo />

        <nav class="hidden items-center gap-1 lg:flex" aria-label="Primary">
            {
                navItems.map((item) =>
                    'children' in item && item.children ? (
                        <div class="relative group">
                            <button
                                type="button"
                                class="nav-link inline-flex items-center gap-1 px-3 py-2"
                                aria-expanded="false"
                                aria-haspopup="true"
                            >
                                {item.label}
                                <svg class="h-3.5 w-3.5 opacity-70 transition group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                    <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                                </svg>
                            </button>
                            <div class="invisible absolute left-0 top-full z-20 min-w-64 translate-y-1 border border-line bg-white py-2 opacity-0 shadow-xl shadow-navy/10 transition group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100">
                                {item.children.map((child) => (
                                    <a href={child.href} class="block px-4 py-2.5 text-sm text-navy/80 no-underline hover:bg-surface hover:text-blue">
                                        {child.label}
                                    </a>
                                ))}
                            </div>
                        </div>
                    ) : (
                        <a href={item.href} class="nav-link px-3 py-2">
                            {item.label}
                        </a>
                    )
                )
            }
        </nav>

        <a href="/contact" class="btn hidden lg:inline-flex">Contact Us</a>

        <button
            type="button"
            id="mobile-nav-toggle"
            class="inline-flex h-10 w-10 items-center justify-center border border-line text-navy lg:hidden"
            aria-expanded="false"
            aria-controls="mobile-nav"
            aria-label="Open menu"
        >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M4 7h16M4 12h16M4 17h16"></path>
            </svg>
        </button>
    </div>

    <div id="mobile-nav" class="hidden border-t border-line bg-white lg:hidden" hidden>
        <nav class="container-site flex flex-col gap-1 py-4" aria-label="Mobile">
            {
                navItems.map((item) =>
                    'children' in item && item.children ? (
                        <details class="group border-b border-line/70 pb-2">
                            <summary class="flex cursor-pointer list-none items-center justify-between py-2 text-sm font-medium text-navy">
                                {item.label}
                                <svg class="h-4 w-4 transition group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor">
                                    <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.17l3.71-3.94a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                                </svg>
                            </summary>
                            <div class="flex flex-col pb-2 pl-3">
                                {item.children.map((child) => (
                                    <a href={child.href} class="py-2 text-sm text-navy/75 no-underline hover:text-blue">
                                        {child.label}
                                    </a>
                                ))}
                            </div>
                        </details>
                    ) : (
                        <a href={item.href} class="border-b border-line/70 py-3 text-sm font-medium text-navy no-underline hover:text-blue">
                            {item.label}
                        </a>
                    )
                )
            }
            <a href="/contact" class="btn mt-3">Contact Us</a>
        </nav>
    </div>
</header>

<script>
    const toggle = document.getElementById('mobile-nav-toggle');
    const panel = document.getElementById('mobile-nav');
    toggle?.addEventListener('click', () => {
        const open = panel?.classList.toggle('hidden') === false;
        panel?.toggleAttribute('hidden', !open);
        toggle.setAttribute('aria-expanded', String(open));
        toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    });
</script>
