---
interface Props {
    label?: string;
    title: string;
    description?: string;
    image?: string;
    size?: 'default' | 'large';
}

const { label, title, description, image = '/images/hero-bg.jpg', size = 'default' } = Astro.props;
---

<section class="relative overflow-hidden border-b border-white/[0.06]">
    <img src={image} alt="" class="absolute inset-0 h-full w-full object-cover" aria-hidden="true" />
    <div class="hero-overlay absolute inset-0"></div>
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_80%_20%,rgba(0,180,255,0.1),transparent_50%)]"></div>
    <div class="section-container relative py-20 md:py-28">
        {label && <p class="section-label">{label}</p>}
        <h1 class:list={[size === 'large' ? 'text-5xl md:text-7xl' : 'text-4xl md:text-6xl', 'max-w-4xl font-normal leading-[0.95]']}>
            {title}
        </h1>
        {description && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/60">{description}</p>}
        <slot />
    </div>
</section>
