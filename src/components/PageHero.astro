---
interface Props {
    eyebrow?: string;
    title: string;
    subtitle?: string;
}

const { eyebrow, title, subtitle } = Astro.props;
---

<section class="relative overflow-hidden bg-navy text-white">
    <div
        class="absolute inset-0 opacity-40"
        style="background: radial-gradient(circle at 20% 20%, #1f65e9 0%, transparent 45%), radial-gradient(circle at 80% 0%, #4b86f0 0%, transparent 35%);"
    >
    </div>
    <div class="container-site relative py-16 sm:py-20">
        {eyebrow && <p class="eyebrow text-blue-soft">{eyebrow}</p>}
        <h1 class="mt-3 max-w-4xl text-white">{title}</h1>
        {subtitle && <p class="mt-5 max-w-3xl text-base text-white/80 sm:text-lg">{subtitle}</p>}
    </div>
</section>
