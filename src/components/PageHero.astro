---
interface Props {
    eyebrow?: string;
    title: string;
    subtitle?: string;
}

const { eyebrow, title, subtitle } = Astro.props;
---

<section class="relative overflow-hidden bg-navy text-white">
    <div class="blob left-[10%] top-[-20%] h-72 w-72 bg-blue/40" data-parallax="0.08"></div>
    <div class="blob floating-delayed right-[5%] top-[30%] h-64 w-64 bg-cyan/25" data-parallax="0.12"></div>
    <div
        class="absolute inset-0 opacity-40"
        style="background: radial-gradient(circle at 20% 20%, #1f65e9 0%, transparent 45%), radial-gradient(circle at 80% 0%, #38bdf8 0%, transparent 35%);"
        data-parallax="0.05"
    >
    </div>
    <div class="absolute inset-0 bg-[linear-gradient(to_bottom,transparent,rgba(7,21,51,0.55))]"></div>

    <div class="container-site relative py-20 sm:py-24">
        {eyebrow && <p class="eyebrow border-white/15 bg-white/10 text-blue-soft reveal">{eyebrow}</p>}
        <h1 class="mt-4 max-w-4xl text-white reveal" style="transition-delay: 80ms">{title}</h1>
        {
            subtitle && (
                <p class="mt-5 max-w-3xl text-base text-white/80 sm:text-lg reveal" style="transition-delay: 160ms">
                    {subtitle}
                </p>
            )
        }
    </div>
</section>
