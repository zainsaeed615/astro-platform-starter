---
interface Props {
    label?: string;
    tagline?: string;
    title: string;
    description?: string;
    size?: 'default' | 'large';
}

const { label, tagline, title, description, size = 'default' } = Astro.props;
---

<section class="relative overflow-hidden border-b border-white/5">
    <div class="hero-glow absolute inset-0"></div>
    <div class="section-container relative py-16 md:py-24">
        {label && <p class="tagline mb-3">{label}</p>}
        {tagline && <p class="tagline mb-3">{tagline}</p>}
        <h1 class:list={[size === 'large' ? 'text-4xl md:text-6xl lg:text-7xl' : 'text-3xl md:text-5xl', 'max-w-4xl font-bold leading-tight']}>
            {title}
        </h1>
        {description && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-white/70">{description}</p>}
        <slot />
    </div>
</section>
