---
interface Props {
    variant?: 'default' | 'light';
    class?: string;
}

const { variant = 'default', class: className = '' } = Astro.props;
const isLight = variant === 'light';
---

<a href="/" class={`inline-flex items-center gap-2 no-underline ${className}`} aria-label="UltraHMB home">
    <img
        src="/images/ultrahmb-logo.webp"
        alt="UltraHMB"
        class={`h-9 w-auto sm:h-10 ${isLight ? 'brightness-0 invert' : ''}`}
        width="160"
        height="40"
    />
</a>
