---
interface Props {
  title: string;
  subtitle?: string;
  image?: string;
}

const {
  title,
  subtitle,
  image = '/images/hero/hero-2.jpg',
} = Astro.props;
---

<section class="relative min-h-[42vh] md:min-h-[48vh] flex items-end overflow-hidden">
  <img
    src={image}
    alt=""
    class="absolute inset-0 h-full w-full object-cover"
    width="1920"
    height="800"
    loading="eager"
    decoding="async"
  />
  <div class="absolute inset-0 overlay-navy" aria-hidden="true"></div>
  <div class="relative z-10 container-pdq w-full pb-14 pt-28 md:pb-16 md:pt-32">
    <p class="section-eyebrow !text-pdq-red mb-4">PDQ Construction</p>
    <h1 class="font-display text-4xl md:text-5xl lg:text-6xl font-bold text-white leading-tight max-w-3xl">
      {title}
    </h1>
    {
      subtitle && (
        <p class="mt-5 max-w-2xl text-base md:text-lg text-white/85 leading-relaxed">
          {subtitle}
        </p>
      )
    }
    <div class="divider-accent mt-6"></div>
  </div>
</section>
