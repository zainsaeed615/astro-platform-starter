---
interface Props {
    title: string;
    items: { icon: string; title: string; body: string }[];
}

const { title, items } = Astro.props;
---

<section class="section-breakout w-full bg-[var(--color-cream)] py-12 md:py-20">
    <div class="section-inner">
        <h3 class="section-title mb-8 text-center">{title}</h3>
        <div class="grid gap-5 md:grid-cols-3">
            {
                items.map((item) => (
                    <div class="group relative overflow-hidden rounded-2xl border border-[var(--color-peach)]/60 bg-[var(--color-white-soft)] p-6 shadow-[0_8px_32px_rgba(44,40,37,0.06)] transition duration-500 hover:-translate-y-1 hover:shadow-[0_16px_40px_rgba(44,40,37,0.1)]">
                        <div class="absolute -right-4 -top-4 text-5xl opacity-[0.07]">{item.icon}</div>
                        <span class="product-benefit-icon mb-4">{item.icon}</span>
                        <h4 class="mb-2 font-serif text-lg text-[var(--color-charcoal)]">{item.title}</h4>
                        <p class="story-body">{item.body}</p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
