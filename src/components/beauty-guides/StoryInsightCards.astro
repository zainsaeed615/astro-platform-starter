---
interface Props {
    title: string;
    items: { icon: string; title: string; body: string }[];
}

const { title, items } = Astro.props;
---

<section class="bg-[var(--color-cream)] py-16 md:py-24">
    <div class="section-inner">
        <h3 class="section-title mb-10 text-center">{title}</h3>
        <div class="grid gap-6 md:grid-cols-3">
            {
                items.map((item) => (
                    <div class="group relative overflow-hidden rounded-3xl border border-[var(--color-peach)]/60 bg-[var(--color-white-soft)] p-8 shadow-[0_8px_32px_rgba(44,40,37,0.06)] transition duration-500 hover:-translate-y-1 hover:shadow-[0_20px_48px_rgba(44,40,37,0.12)]">
                        <div class="absolute -right-4 -top-4 text-6xl opacity-[0.07]">{item.icon}</div>
                        <span class="product-benefit-icon mb-5">{item.icon}</span>
                        <h4 class="mb-3 font-serif text-xl">{item.title}</h4>
                        <p class="text-sm leading-relaxed text-[var(--color-muted)]">{item.body}</p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
