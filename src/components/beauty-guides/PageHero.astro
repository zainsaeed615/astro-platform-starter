---
import { site } from '../../data/beauty-guides';

interface Props {
    eyebrow?: string;
    title: string;
    subtitle?: string;
    image?: string;
    align?: 'left' | 'center';
    size?: 'default' | 'large';
}

const { eyebrow, title, subtitle, image = '/beauty-guides/mock2.png', align = 'center', size = 'default' } = Astro.props;
---

<section class="relative overflow-hidden">
    <div class="absolute inset-0">
        <img src={image} alt="" class="h-full w-full object-cover" />
        <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-charcoal)]/80 via-[var(--color-charcoal)]/60 to-[var(--color-charcoal)]/30"></div>
    </div>
    <div class={`relative mx-auto max-w-7xl px-4 py-20 md:px-6 md:py-28 ${align === 'center' ? 'text-center' : 'text-left'}`}>
        {eyebrow && <p class="section-eyebrow mb-4 text-[var(--color-peach)]">{eyebrow}</p>}
        <h1 class={`font-serif font-normal text-white ${size === 'large' ? 'text-4xl md:text-6xl' : 'text-3xl md:text-5xl'}`}>{title}</h1>
        {subtitle && <p class={`mt-4 max-w-2xl text-lg text-white/85 ${align === 'center' ? 'mx-auto' : ''}`}>{subtitle}</p>}
        <div class={`mt-8 flex flex-wrap gap-3 ${align === 'center' ? 'justify-center' : ''}`}>
            <a href={site.messengerUrl} target="_blank" rel="noopener" class="btn-tbg-messenger"> Message Me on Messenger </a>
            <a href="/complete-guide" class="btn-tbg-outline border-white text-white hover:bg-white hover:text-[var(--color-charcoal)]"> Get the Guide </a>
        </div>
    </div>
</section>
