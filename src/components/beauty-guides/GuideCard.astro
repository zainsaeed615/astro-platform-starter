---
interface Props {
    slug: string;
    number: number;
    title: string;
    description: string;
    image: string;
}

const { slug, number, title, description, image } = Astro.props;
---

<a href={`/guides/${slug}`} class="card-tbg group block no-underline">
    <div class="relative aspect-[4/5] overflow-hidden">
        <img src={image} alt={title} class="h-full w-full object-cover transition duration-700 group-hover:scale-110" loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-charcoal)]/85 via-[var(--color-charcoal)]/20 to-transparent"></div>
        <div class="absolute top-4 left-4 guide-number">{number}</div>
        <div class="absolute right-0 bottom-0 left-0 p-5">
            <h3 class="font-serif text-lg leading-snug text-white">{title}</h3>
        </div>
    </div>
    <div class="border-t border-[var(--color-peach)]/50 p-5">
        <p class="text-sm leading-relaxed text-[var(--color-muted)] line-clamp-3">{description}</p>
        <span class="mt-4 inline-flex items-center gap-1 text-[11px] font-bold uppercase tracking-wider text-[var(--color-taupe)] transition group-hover:gap-2">
            Preview guide <span aria-hidden="true">→</span>
        </span>
    </div>
</a>
