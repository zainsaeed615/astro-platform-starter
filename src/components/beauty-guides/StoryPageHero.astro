---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
  image: string;
  imageAlt?: string;
  badge?: string;
  stats?: { value: string; label: string }[];
}

const { eyebrow, title, subtitle, image, imageAlt, badge, stats = [] } = Astro.props;
---

<section class="relative w-full min-h-[60vh] overflow-hidden lg:min-h-[72vh]">
  <div class="absolute inset-0">
    <img src={image} alt={imageAlt || title} class="h-full w-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-charcoal)]/92 via-[var(--color-charcoal)]/72 to-[var(--color-charcoal)]/35"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-charcoal)]/75 via-transparent to-transparent"></div>
  </div>

  <div class="relative mx-auto flex min-h-[60vh] w-full max-w-7xl flex-col justify-end px-4 pb-12 pt-28 sm:px-6 lg:min-h-[72vh] lg:px-8 lg:pb-20">
    {eyebrow && (
      <p class="mb-3 text-[11px] font-bold uppercase tracking-[0.22em] text-[var(--color-peach-light)]">{eyebrow}</p>
    )}
    {badge && (
      <span class="mb-5 inline-flex w-fit items-center gap-2 rounded-full border border-[var(--color-taupe-light)]/30 bg-[var(--color-taupe)]/10 px-4 py-1.5 text-xs font-medium text-[var(--color-peach-light)] backdrop-blur-sm">
        <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-taupe-light)]"></span>
        {badge}
      </span>
    )}
    <h1 class="max-w-3xl font-serif text-[clamp(1.75rem,4vw,2.75rem)] leading-tight text-white">{title}</h1>
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-white/85 lg:text-lg">{subtitle}</p>

    {stats.length > 0 && (
      <div class="mt-8 flex flex-wrap gap-3 lg:gap-5">
        {stats.map((stat) => (
          <div class="rounded-xl border border-white/10 bg-white/5 px-5 py-3 backdrop-blur-sm">
            <div class="font-serif text-xl text-white lg:text-2xl">{stat.value}</div>
            <div class="mt-0.5 text-[10px] uppercase tracking-wider text-white/65">{stat.label}</div>
          </div>
        ))}
      </div>
    )}
  </div>
</section>

<div id="reading-progress" class="fixed left-0 top-[72px] z-50 h-0.5 w-0 bg-gradient-to-r from-[var(--color-taupe)] to-[var(--color-peach-light)] transition-[width] duration-150"></div>

<script>
  const bar = document.getElementById('reading-progress');
  if (bar) {
    const update = () => {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      bar.style.width = `${pct}%`;
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>
