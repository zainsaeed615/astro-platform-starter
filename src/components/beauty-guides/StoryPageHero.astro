---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle: string;
  image: string;
  imageAlt?: string;
  badge?: string;
  stats?: { value: string; label: string }[];
}

const { eyebrow, title, subtitle, image, imageAlt, badge, stats = [] } = Astro.props;
---

<section class="relative min-h-[70vh] overflow-hidden lg:min-h-[85vh]">
  <div class="absolute inset-0">
    <img src={image} alt={imageAlt || title} class="h-full w-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-r from-[var(--color-charcoal)]/95 via-[var(--color-charcoal)]/70 to-[var(--color-charcoal)]/30"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-charcoal)]/80 via-transparent to-transparent"></div>
  </div>

  <div class="relative mx-auto flex min-h-[70vh] max-w-7xl flex-col justify-end px-6 pb-16 pt-32 lg:min-h-[85vh] lg:px-8 lg:pb-24">
    {eyebrow && (
      <p class="mb-4 text-sm font-bold uppercase tracking-[0.25em] text-[var(--color-peach-light)]">{eyebrow}</p>
    )}
    {badge && (
      <span class="mb-6 inline-flex w-fit items-center gap-2 rounded-full border border-[var(--color-taupe-light)]/30 bg-[var(--color-taupe)]/10 px-5 py-2 text-sm font-medium text-[var(--color-peach-light)] backdrop-blur-sm">
        <span class="h-1.5 w-1.5 rounded-full bg-[var(--color-taupe-light)]"></span>
        {badge}
      </span>
    )}
    <h1 class="max-w-4xl font-serif text-4xl leading-tight text-white lg:text-6xl xl:text-7xl">{title}</h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-[var(--color-peach-light)]/90 lg:text-xl">{subtitle}</p>

    {stats.length > 0 && (
      <div class="mt-10 flex flex-wrap gap-4 lg:gap-6">
        {stats.map((stat) => (
          <div class="rounded-2xl border border-white/10 bg-white/5 px-6 py-4 backdrop-blur-sm">
            <div class="font-serif text-2xl text-white lg:text-3xl">{stat.value}</div>
            <div class="mt-1 text-xs uppercase tracking-wider text-[var(--color-peach-light)]/70">{stat.label}</div>
          </div>
        ))}
      </div>
    )}
  </div>

  <div class="absolute bottom-8 left-1/2 hidden -translate-x-1/2 lg:block">
    <div class="flex flex-col items-center gap-2 text-[var(--color-peach-light)]/60">
      <span class="text-xs uppercase tracking-widest">Scroll to read</span>
      <div class="h-10 w-6 rounded-full border-2 border-[var(--color-peach-light)]/30 p-1">
        <div class="mx-auto h-2 w-2 animate-bounce rounded-full bg-[var(--color-taupe-light)]"></div>
      </div>
    </div>
  </div>
</section>

<!-- Reading progress bar -->
<div id="reading-progress" class="fixed left-0 top-[72px] z-50 h-0.5 w-0 bg-gradient-to-r from-[var(--color-taupe)] to-[var(--color-peach-light)] transition-[width] duration-150"></div>

<script>
  const bar = document.getElementById('reading-progress');
  if (bar) {
    const update = () => {
      const scrollTop = window.scrollY;
      const docHeight = document.documentElement.scrollHeight - window.innerHeight;
      const pct = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
      bar.style.width = `${pct}%`;
    };
    window.addEventListener('scroll', update, { passive: true });
    update();
  }
</script>
