---
interface Props {
    items: { value: string; label: string }[];
    dark?: boolean;
}

const { items, dark = false } = Astro.props;
---

<section class={`section-breakout w-full py-10 md:py-14 ${dark ? 'bg-[var(--color-charcoal)] text-white' : 'bg-gradient-to-r from-[var(--color-peach-light)] via-[var(--color-white-soft)] to-[var(--color-peach-light)]'}`}>
    <div class="section-inner">
        <div class="grid grid-cols-2 gap-5 md:grid-cols-4 md:gap-6">
            {
                items.map((item) => (
                    <div class="text-center">
                        <p class={`font-serif text-2xl md:text-3xl ${dark ? 'text-[var(--color-peach-light)]' : 'text-gradient-gold'}`}>{item.value}</p>
                        <p class={`mt-1.5 text-[10px] font-bold uppercase tracking-[0.18em] ${dark ? 'text-white/60' : 'text-[var(--color-muted)]'}`}>{item.label}</p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
