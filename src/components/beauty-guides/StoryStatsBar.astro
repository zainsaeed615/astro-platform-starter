---
interface Props {
    items: { value: string; label: string }[];
    dark?: boolean;
}

const { items, dark = false } = Astro.props;
---

<section class={`py-12 md:py-16 ${dark ? 'bg-[var(--color-charcoal)] text-white' : 'bg-gradient-to-r from-[var(--color-peach-light)] via-[var(--color-white-soft)] to-[var(--color-peach-light)]'}`}>
    <div class="section-inner">
        <div class="grid grid-cols-2 gap-6 md:grid-cols-4 md:gap-8">
            {
                items.map((item) => (
                    <div class={`text-center ${dark ? '' : ''}`}>
                        <p class={`font-serif text-4xl md:text-5xl ${dark ? 'text-[var(--color-peach-light)]' : 'text-gradient-gold'}`}>{item.value}</p>
                        <p class={`mt-2 text-[11px] font-bold uppercase tracking-[0.2em] ${dark ? 'text-white/60' : 'text-[var(--color-muted)]'}`}>{item.label}</p>
                    </div>
                ))
            }
        </div>
    </div>
</section>
