---
import { site, footerColumns } from '../../data/beauty-guides';

interface Props {
    hideCta?: boolean;
}

const { hideCta = false } = Astro.props;
const year = new Date().getFullYear();
---

{
    !hideCta && (
        <section class="border-t border-[var(--color-peach)] bg-[var(--color-white-soft)] py-16">
            <div class="mx-auto grid max-w-7xl items-center gap-8 px-4 md:grid-cols-2 md:px-6">
                <div>
                    <p class="section-eyebrow mb-3">Still have questions?</p>
                    <h2 class="section-title mb-4">Ready to take the first step?</h2>
                    <p class="prose-tbg mb-6 max-w-md">
                        Send me a message on Messenger. I'm happy to share my experience and point you towards information on the site that may help.
                    </p>
                    <div class="flex flex-wrap gap-3">
                        <a href={site.messengerUrl} target="_blank" rel="noopener" class="btn-tbg-messenger"> Message Me on Messenger </a>
                        <a href="/complete-guide" class="btn-tbg-primary"> Get the Guide </a>
                    </div>
                </div>
                <div class="relative overflow-hidden rounded-3xl">
                    <img src="/beauty-guides/gen1.png" alt="" class="h-72 w-full object-cover object-top md:h-80" />
                </div>
            </div>
        </section>
    )
}

<footer class="border-t border-[var(--color-peach)] bg-[var(--color-charcoal)] text-[var(--color-cream)]">
    <div class="mx-auto max-w-7xl px-4 py-14 md:px-6">
        <div class="mb-10 flex flex-col gap-6 border-b border-white/10 pb-10 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="font-serif text-2xl">The Beauty Guides</p>
                <p class="mt-1 text-sm text-white/70">{site.tagline}</p>
            </div>
            <div class="flex gap-4">
                <a href={site.messengerUrl} target="_blank" rel="noopener" class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white no-underline hover:bg-white/20" aria-label="Messenger">
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.03 2 11c0 2.58 1.19 4.9 3.05 6.44L4 22l4.77-1.24C9.71 21.59 10.84 22 12 22c5.52 0 10-4.03 10-9S17.52 2 12 2z"/></svg>
                </a>
                <a href="#" class="flex h-10 w-10 items-center justify-center rounded-full bg-white/10 text-white no-underline hover:bg-white/20" aria-label="Instagram">
                    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.9.2 2.3.4.6.2 1 .5 1.5 1 .5.5.8.9 1 1.5.2.4.4 1.1.4 2.3.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.2 1.9-.4 2.3-.2.6-.5 1-1 1.5-.5.5-.9.8-1.5 1-.4.2-1.1.4-2.3.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.9-.2-2.3-.4-.6-.2-1-.5-1.5-1-.5-.5-.8-.9-1-1.5-.2-.4-.4-1.1-.4-2.3-.1-1.3-.1-1.7-.1-4.9s0-3.6.1-4.9c.1-1.2.2-1.9.4-2.3.2-.6.5-1 1-1.5.5-.5.9-.8 1.5-1 .4-.2 1.1-.4 2.3-.4C8.4 2.2 8.8 2.2 12 2.2zm0 1.8c-3.1 0-3.5 0-4.7.1-1 .0-1.6.2-2 .3-.5.2-.9.4-1.3.8-.4.4-.6.8-.8 1.3-.1.4-.3 1-.3 2-.1 1.2-.1 1.6-.1 4.7s0 3.5.1 4.7c0 1 .2 1.6.3 2 .2.5.4.9.8 1.3.4.4.8.6 1.3.8.4.1 1 .3 2 .3 1.2.1 1.6.1 4.7.1s3.5 0 4.7-.1c1 0 1.6-.2 2-.3.5-.2.9-.4 1.3-.8.4-.4.6-.8.8-1.3.1-.4.3-1 .3-2 .1-1.2.1-1.6.1-4.7s0-3.5-.1-4.7c0-1-.2-1.6-.3-2-.2-.5-.4-.9-.8-1.3-.4-.4-.8-.6-1.3-.8-.4-.1-1-.3-2-.3-1.2-.1-1.6-.1-4.7-.1z"/></svg>
                </a>
            </div>
        </div>

        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-5">
            {
                footerColumns.map((col) => (
                    <div>
                        <p class="mb-4 text-xs font-semibold uppercase tracking-widest text-white/50">{col.title}</p>
                        <ul class="space-y-2">
                            {col.links.map((link) => (
                                <li>
                                    <a href={link.href} class="text-sm text-white/80 no-underline hover:text-white">
                                        {link.label}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </div>
                ))
            }
        </div>

        <div class="mt-10 flex flex-col gap-4 border-t border-white/10 pt-8 text-xs text-white/50 md:flex-row md:items-center md:justify-between">
            <p>&copy; {year} The Beauty Guides. All rights reserved.</p>
            <p class="max-w-xl text-center md:text-right">
                Personal experience only — not medical advice. Kirsty is not a broker, adviser or patient coordinator.
            </p>
        </div>
    </div>
</footer>
