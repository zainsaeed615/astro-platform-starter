---
interface Props {
    slug: string;
    title: string;
    image: string;
    paragraphs: readonly string[];
    index: number;
}

const { title, image, paragraphs, index } = Astro.props;
const reversed = index % 2 === 1;
const isQuote = (p: string) => p.startsWith('"') || p.startsWith('When did') || p.startsWith('I don') || p.startsWith('Would they') || p.startsWith('Was it worth') || p.length < 80 && !p.endsWith('.');
---

<section id={Astro.props.slug} class={`scroll-mt-28 py-16 md:py-24 ${index % 2 === 0 ? 'bg-[var(--color-white-soft)]' : 'bg-[var(--color-cream)]'}`}>
    <div class="section-inner">
        <div class={`grid items-start gap-10 lg:grid-cols-12 lg:gap-14 ${reversed ? '' : ''}`}>
            <div class={`lg:col-span-5 ${reversed ? 'lg:order-2' : ''}`}>
                <div class="sticky top-28">
                    <div class="relative overflow-hidden rounded-[1.75rem] shadow-[0_20px_60px_rgba(44,40,37,0.12)]">
                        <img src={image} alt={title} class="aspect-[4/5] w-full object-cover" loading="lazy" />
                        <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-charcoal)]/25 to-transparent"></div>
                    </div>
                    <p class="mt-4 text-center text-[11px] font-bold uppercase tracking-[0.2em] text-[var(--color-taupe)]">{String(index + 1).padStart(2, '0')}</p>
                </div>
            </div>
            <div class={`lg:col-span-7 ${reversed ? 'lg:order-1' : ''}`}>
                <div class="mb-6 flex items-center gap-3">
                    <span class="h-px w-10 bg-[var(--color-taupe-light)]"></span>
                    <p class="section-eyebrow">Chapter</p>
                </div>
                <h2 class="section-title mb-8">{title}</h2>
                <div class="space-y-5">
                    {
                        paragraphs.map((p) =>
                            isQuote(p) ? (
                                <blockquote class="script-note border-l-4 border-[var(--color-taupe)] pl-6 !text-2xl">{p}</blockquote>
                            ) : (
                                <p class="prose-tbg text-base leading-[1.85] text-[var(--color-charcoal)]/90">{p}</p>
                            ),
                        )
                    }
                </div>
            </div>
        </div>
    </div>
</section>
