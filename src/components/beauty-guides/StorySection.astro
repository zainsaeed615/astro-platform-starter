---
interface Props {
  title: string;
  paragraphs: readonly string[];
  image?: string;
  imageAlt?: string;
  index: number;
  slug: string;
  variant?: 'default' | 'full-bleed' | 'quote-hero' | 'magazine' | 'split-reverse';
}

const { title, paragraphs, image, imageAlt, index, slug, variant = 'default' } = Astro.props;
---

<section id={slug} class="story-section scroll-mt-28" data-section-index={index}>
  {variant === 'full-bleed' && image && (
    <div class="relative mb-10 overflow-hidden rounded-2xl lg:mb-14">
      <div class="aspect-[21/9] lg:aspect-[21/8]">
        <img src={image} alt={imageAlt || title} class="h-full w-full object-cover" loading="lazy" />
      </div>
      <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-charcoal)]/90 via-[var(--color-charcoal)]/40 to-transparent"></div>
      <div class="absolute bottom-0 left-0 right-0 p-6 lg:p-10">
        <span class="mb-2 inline-block rounded-full bg-white/15 px-3 py-1 text-[10px] font-semibold uppercase tracking-widest text-white backdrop-blur-sm">
          Chapter {String(index + 1).padStart(2, '0')}
        </span>
        <h2 class="story-heading !text-white lg:text-[2rem]">{title}</h2>
      </div>
    </div>
  )}

  {variant === 'quote-hero' && (
    <div class="relative mb-10 overflow-hidden rounded-2xl bg-gradient-to-br from-[var(--color-charcoal)] to-[#2d2520] p-8 lg:mb-14 lg:p-12">
      <div class="relative grid gap-8 lg:grid-cols-2 lg:items-center">
        <div>
          <span class="mb-3 inline-block rounded-full bg-[var(--color-taupe)]/20 px-3 py-1 text-[10px] font-semibold uppercase tracking-widest text-[var(--color-peach-light)]">
            Chapter {String(index + 1).padStart(2, '0')}
          </span>
          <h2 class="story-heading !text-white">{title}</h2>
        </div>
        {paragraphs[0] && (
          <blockquote class="border-l-4 border-[var(--color-taupe-light)] pl-5">
            <p class="font-serif text-lg italic leading-relaxed text-[var(--color-peach-light)]">{paragraphs[0]}</p>
          </blockquote>
        )}
      </div>
      {paragraphs.length > 1 && (
        <div class="relative mt-8 grid gap-5 lg:grid-cols-2">
          {paragraphs.slice(1).map((p) => (
            <p class="story-body !text-[var(--color-peach-light)]/85">{p}</p>
          ))}
        </div>
      )}
    </div>
  )}

  {variant === 'magazine' && (
    <div class="mb-10 lg:mb-14">
      <div class="mb-6 flex items-end justify-between gap-4 border-b border-[var(--color-peach)] pb-5">
        <div>
          <span class="text-[10px] font-semibold uppercase tracking-widest text-[var(--color-taupe)]">Chapter {String(index + 1).padStart(2, '0')}</span>
          <h2 class="story-heading mt-1.5">{title}</h2>
        </div>
      </div>
      <div class="grid gap-8 lg:grid-cols-12">
        {image && (
          <div class="lg:col-span-5">
            <div class="sticky top-28 overflow-hidden rounded-xl shadow-lg">
              <img src={image} alt={imageAlt || title} class="aspect-[4/5] w-full object-cover" loading="lazy" />
            </div>
          </div>
        )}
        <div class={`space-y-4 ${image ? 'lg:col-span-7' : 'lg:col-span-12'}`}>
          {paragraphs.map((p, i) => (
            <p class={`story-body ${i === 0 ? 'font-medium text-[var(--color-charcoal)]' : ''}`}>{p}</p>
          ))}
        </div>
      </div>
    </div>
  )}

  {(variant === 'default' || variant === 'split-reverse') && (
    <div class={`mb-10 grid gap-8 lg:mb-14 lg:grid-cols-2 lg:items-center ${variant === 'split-reverse' ? 'lg:[direction:rtl]' : ''}`}>
      {image && (
        <div class={`relative ${variant === 'split-reverse' ? 'lg:[direction:ltr]' : ''}`}>
          <div class="overflow-hidden rounded-xl shadow-lg">
            <img src={image} alt={imageAlt || title} class="aspect-[4/3] w-full object-cover" loading="lazy" />
          </div>
        </div>
      )}
      <div class={`${variant === 'split-reverse' ? 'lg:[direction:ltr]' : ''} ${!image ? 'lg:col-span-2' : ''}`}>
        <span class="text-[10px] font-semibold uppercase tracking-widest text-[var(--color-taupe)]">Chapter {String(index + 1).padStart(2, '0')}</span>
        <h2 class="story-heading mt-1.5 mb-5">{title}</h2>
        <div class="space-y-4">
          {paragraphs.map((p) => (
            <p class="story-body">{p}</p>
          ))}
        </div>
      </div>
    </div>
  )}

  {variant === 'full-bleed' && (
    <div class="mx-auto max-w-3xl space-y-4">
      {paragraphs.map((p) => (
        <p class="story-body">{p}</p>
      ))}
    </div>
  )}
</section>
