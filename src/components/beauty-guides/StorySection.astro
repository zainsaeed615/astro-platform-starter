---
interface Props {
  title: string;
  paragraphs: readonly string[];
  image?: string;
  imageAlt?: string;
  index: number;
  slug: string;
  variant?: 'default' | 'full-bleed' | 'quote-hero' | 'magazine' | 'split-reverse';
}

const { title, paragraphs, image, imageAlt, index, slug, variant = 'default' } = Astro.props;
const content = paragraphs.join('\n\n');
const isEven = index % 2 === 0;
---

<section id={slug} class="story-section scroll-mt-28" data-section-index={index}>
  {variant === 'full-bleed' && image && (
    <div class="relative mb-12 overflow-hidden rounded-3xl lg:mb-16">
      <div class="aspect-[21/9] lg:aspect-[21/8]">
        <img src={image} alt={imageAlt || title} class="h-full w-full object-cover" loading="lazy" />
      </div>
      <div class="absolute inset-0 bg-gradient-to-t from-[var(--color-charcoal)]/90 via-[var(--color-charcoal)]/40 to-transparent"></div>
      <div class="absolute bottom-0 left-0 right-0 p-8 lg:p-12">
        <span class="mb-3 inline-block rounded-full bg-white/15 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-white backdrop-blur-sm">
          Chapter {String(index + 1).padStart(2, '0')}
        </span>
        <h2 class="font-serif text-3xl text-white lg:text-5xl">{title}</h2>
      </div>
    </div>
  )}

  {variant === 'quote-hero' && (
    <div class="relative mb-12 overflow-hidden rounded-3xl bg-gradient-to-br from-[var(--color-charcoal)] to-[#2d2520] p-10 lg:mb-16 lg:p-16">
      <div class="absolute right-0 top-0 h-64 w-64 rounded-full bg-[var(--color-taupe)]/10 blur-3xl"></div>
      <div class="absolute bottom-0 left-0 h-48 w-48 rounded-full bg-[var(--color-peach-light)]/5 blur-2xl"></div>
      <div class="relative grid gap-10 lg:grid-cols-2 lg:items-center">
        <div>
          <span class="mb-4 inline-block rounded-full bg-[var(--color-taupe)]/20 px-4 py-1.5 text-xs font-semibold uppercase tracking-widest text-[var(--color-peach-light)]">
            Chapter {String(index + 1).padStart(2, '0')}
          </span>
          <h2 class="font-serif text-3xl text-white lg:text-4xl">{title}</h2>
        </div>
        {paragraphs[0] && (
          <blockquote class="border-l-4 border-[var(--color-taupe-light)] pl-6">
            <p class="font-serif text-xl italic leading-relaxed text-[var(--color-peach-light)] lg:text-2xl">{paragraphs[0]}</p>
          </blockquote>
        )}
      </div>
      {paragraphs.length > 1 && (
        <div class="relative mt-10 grid gap-6 lg:grid-cols-2">
          {paragraphs.slice(1).map((p) => (
            <p class="leading-relaxed text-[var(--color-peach-light)]/80">{p}</p>
          ))}
        </div>
      )}
    </div>
  )}

  {variant === 'magazine' && (
    <div class="mb-12 lg:mb-16">
      <div class="mb-8 flex items-end justify-between gap-4 border-b border-[var(--color-peach)] pb-6">
        <div>
          <span class="text-xs font-semibold uppercase tracking-widest text-[var(--color-taupe)]">Chapter {String(index + 1).padStart(2, '0')}</span>
          <h2 class="mt-2 font-serif text-3xl text-[var(--color-charcoal)] lg:text-4xl">{title}</h2>
        </div>
      </div>
      <div class="grid gap-8 lg:grid-cols-12">
        {image && (
          <div class="lg:col-span-5">
            <div class="sticky top-28 overflow-hidden rounded-2xl shadow-xl">
              <img src={image} alt={imageAlt || title} class="aspect-[4/5] w-full object-cover" loading="lazy" />
            </div>
          </div>
        )}
        <div class={`space-y-6 ${image ? 'lg:col-span-7' : 'lg:col-span-12'}`}>
          {paragraphs.map((p, i) => (
            <p class={`leading-relaxed text-[var(--color-muted)] ${i === 0 ? 'text-lg font-medium text-[var(--color-charcoal)]' : ''}`}>{p}</p>
          ))}
        </div>
      </div>
    </div>
  )}

  {(variant === 'default' || variant === 'split-reverse') && (
    <div class={`mb-12 grid gap-10 lg:mb-16 lg:grid-cols-2 lg:items-center ${variant === 'split-reverse' ? 'lg:[direction:rtl]' : ''}`}>
      {image && (
        <div class={`relative ${variant === 'split-reverse' ? 'lg:[direction:ltr]' : ''}`}>
          <div class="overflow-hidden rounded-2xl shadow-xl">
            <img src={image} alt={imageAlt || title} class="aspect-[4/3] w-full object-cover transition-transform duration-700 hover:scale-105" loading="lazy" />
          </div>
          <div class="absolute -bottom-4 -right-4 hidden h-24 w-24 rounded-2xl bg-[var(--color-taupe)]/20 lg:block"></div>
        </div>
      )}
      <div class={`${variant === 'split-reverse' ? 'lg:[direction:ltr]' : ''} ${!image ? 'lg:col-span-2' : ''}`}>
        <span class="text-xs font-semibold uppercase tracking-widest text-[var(--color-taupe)]">Chapter {String(index + 1).padStart(2, '0')}</span>
        <h2 class="mt-2 mb-6 font-serif text-3xl text-[var(--color-charcoal)] lg:text-4xl">{title}</h2>
        <div class="space-y-5">
          {paragraphs.map((p) => (
            <p class="leading-relaxed text-[var(--color-muted)]">{p}</p>
          ))}
        </div>
      </div>
    </div>
  )}

  {variant === 'full-bleed' && (
    <div class="mx-auto max-w-3xl space-y-5 px-4 lg:px-0">
      {paragraphs.map((p) => (
        <p class="leading-relaxed text-[var(--color-muted)]">{p}</p>
      ))}
    </div>
  )}
</section>
