---
const year = new Date().getFullYear();
---

<footer class="bg-stone border-t border-sand/60 section-padding">
    <div class="container-narrow">
        <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4 mb-12">
            <div>
                <p class="font-serif text-xl mb-4">Mindfulness</p>
                <p class="text-warm-gray text-sm leading-relaxed">
                    Creating intentional moments of comfort, reflection, and connection—one experience at a time.
                </p>
            </div>
            <div>
                <p class="eyebrow mb-4">Explore</p>
                <ul class="space-y-2 text-sm">
                    <li><a href="/membership" class="text-warm-gray no-underline hover:text-charcoal">Membership</a></li>
                    <li><a href="/healthcare" class="text-warm-gray no-underline hover:text-charcoal">Healthcare</a></li>
                    <li><a href="/corporate" class="text-warm-gray no-underline hover:text-charcoal">Corporate Gifting</a></li>
                    <li><a href="/fundraising" class="text-warm-gray no-underline hover:text-charcoal">Fundraising</a></li>
                </ul>
            </div>
            <div>
                <p class="eyebrow mb-4">Shop</p>
                <ul class="space-y-2 text-sm">
                    <li><a href="https://mindfulnesscandle.store/" target="_blank" rel="noopener noreferrer" class="text-warm-gray no-underline hover:text-charcoal">Visit Store</a></li>
                    <li><a href="https://mindfulnesscandle.store/pages/about" target="_blank" rel="noopener noreferrer" class="text-warm-gray no-underline hover:text-charcoal">About</a></li>
                    <li><a href="https://mindfulnesscandle.store/pages/contact" target="_blank" rel="noopener noreferrer" class="text-warm-gray no-underline hover:text-charcoal">Contact</a></li>
                </ul>
            </div>
            <div>
                <p class="eyebrow mb-4">Inquiries</p>
                <ul class="space-y-2 text-sm">
                    <li><a href="mailto:info@mindfulnesscandle.store" class="text-warm-gray no-underline hover:text-charcoal">Corporate & Healthcare</a></li>
                    <li><a href="mailto:info@mindfulnesscandle.store" class="text-warm-gray no-underline hover:text-charcoal">Fundraising Partners</a></li>
                </ul>
            </div>
        </div>
        <p class="text-warm-gray text-xs text-center pt-8 border-t border-sand/60">
            &copy; {year} Mindfulness Candle Collection. All rights reserved.
        </p>
    </div>
</footer>
