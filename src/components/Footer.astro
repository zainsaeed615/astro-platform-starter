---
import { footerNav, socialLinks } from '../data/navigation';
import { siteConfig } from '../data/site';
---

<footer class="mt-auto border-t border-white/5 bg-brand-dark">
    <div class="section-container py-16">
        <div class="grid gap-12 lg:grid-cols-12">
            <div class="lg:col-span-4">
                <div class="flex items-center gap-3">
                    <img src="/logo.png" alt="Operation 17:2" class="h-14 w-14 rounded-full object-cover ring-1 ring-white/10" />
                    <div>
                        <div class="font-display text-lg font-bold uppercase tracking-wider">Operation 17:2</div>
                        <div class="text-xs uppercase tracking-[0.2em] text-brand-blue">{siteConfig.tagline}</div>
                    </div>
                </div>
                <p class="mt-4 max-w-sm text-sm leading-relaxed text-white/60">{siteConfig.mission.slice(0, 180)}...</p>
                <div class="mt-6 flex gap-3">
                    {
                        socialLinks.map((link) => (
                            <a
                                href={link.href}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="flex h-10 w-10 items-center justify-center rounded-lg border border-white/10 bg-white/5 text-white/70 no-underline transition-all hover:border-brand-blue/50 hover:text-brand-blue"
                                aria-label={link.label}
                            >
                                {link.icon === 'instagram' && (
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <rect width="20" height="20" x="2" y="2" rx="5" ry="5"></rect>
                                        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                                        <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                                    </svg>
                                )}
                                {link.icon === 'facebook' && (
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
                                    </svg>
                                )}
                                {link.icon === 'youtube' && (
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"></path>
                                        <path d="m10 15 5-3-5-3z"></path>
                                    </svg>
                                )}
                            </a>
                        ))
                    }
                </div>
            </div>

            <div class="grid grid-cols-2 gap-8 sm:grid-cols-4 lg:col-span-8">
                <div>
                    <h4 class="mb-4 font-display text-xs font-semibold uppercase tracking-widest text-brand-blue">Organization</h4>
                    <ul class="space-y-2">
                        {footerNav.organization.map((item) => (
                            <li><a href={item.href} class="text-sm text-white/60 no-underline hover:text-white">{item.label}</a></li>
                        ))}
                    </ul>
                </div>
                <div>
                    <h4 class="mb-4 font-display text-xs font-semibold uppercase tracking-widest text-brand-blue">Get Involved</h4>
                    <ul class="space-y-2">
                        {footerNav.getInvolved.map((item) => (
                            <li><a href={item.href} class="text-sm text-white/60 no-underline hover:text-white">{item.label}</a></li>
                        ))}
                    </ul>
                </div>
                <div>
                    <h4 class="mb-4 font-display text-xs font-semibold uppercase tracking-widest text-brand-blue">Support</h4>
                    <ul class="space-y-2">
                        {footerNav.support.map((item) => (
                            <li><a href={item.href} class="text-sm text-white/60 no-underline hover:text-white">{item.label}</a></li>
                        ))}
                    </ul>
                </div>
                <div>
                    <h4 class="mb-4 font-display text-xs font-semibold uppercase tracking-widest text-brand-blue">Legal</h4>
                    <ul class="space-y-2">
                        {footerNav.legal.map((item) => (
                            <li><a href={item.href} class="text-sm text-white/60 no-underline hover:text-white">{item.label}</a></li>
                        ))}
                    </ul>
                </div>
            </div>
        </div>

        <div class="mt-12 rounded-xl border border-white/10 bg-brand-gray/50 p-8">
            <div class="grid items-center gap-6 lg:grid-cols-2">
                <div>
                    <h4 class="font-display text-xl font-bold uppercase tracking-wide">Stay in the Fight</h4>
                    <p class="mt-2 text-sm text-white/60">Get mission updates, prayer call reminders, and new product drops.</p>
                </div>
                <form class="flex flex-col gap-3 sm:flex-row" onsubmit="event.preventDefault(); alert('Newsletter signup — connect to Mailchimp/Givebutter CRM at launch.');">
                    <input
                        type="email"
                        placeholder="Enter your email"
                        required
                        class="flex-1 rounded-lg border border-white/10 bg-black/50 px-4 py-3 text-sm text-white placeholder:text-white/40 focus:border-brand-blue/50 focus:outline-none focus:ring-1 focus:ring-brand-blue/30"
                    />
                    <button type="submit" class="btn-primary shrink-0 no-underline">Subscribe</button>
                </form>
            </div>
        </div>

        <div class="mt-10 flex flex-col items-center justify-between gap-4 border-t border-white/5 pt-8 text-center sm:flex-row sm:text-left">
            <p class="text-xs text-white/40">&copy; {new Date().getFullYear()} Operation 17:2. All rights reserved. {siteConfig.location}.</p>
            <p class="font-display text-xs uppercase tracking-widest text-brand-blue/80">Protecting Children · Hunting Predators · Bringing Justice</p>
        </div>
    </div>
</footer>
