---
import { pathTo } from '../utils/paths';

const year = new Date().getFullYear();
---

<footer class="section-bg-dark text-cream grain-overlay">
    <div class="relative z-10 container-narrow">
        <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-12 pb-16 border-b border-white/10">
            <div class="lg:col-span-4">
                <div class="flex items-center gap-3 mb-6">
                    <span class="flex items-center justify-center w-10 h-10 rounded-full bg-white/10">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="text-gold">
                            <path d="M12 2C8 6 4 8 4 13c0 4.4 3.6 8 8 8s8-3.6 8-8c0-5-4-7-8-11z" fill="currentColor" opacity="0.8"/>
                        </svg>
                    </span>
                    <span class="font-serif text-2xl font-light tracking-wide">Mindfulness</span>
                </div>
                <p class="text-cream/60 text-sm leading-relaxed max-w-xs mb-6">
                    Faith-centered wellness experiences designed to bring peace, reflection, and renewal into every season of life.
                </p>
                <a href="https://mindfulnesscandle.store/" target="_blank" rel="noopener noreferrer" class="btn btn-gold text-[0.625rem] !py-2.5 !px-5">Shop the Collection</a>
            </div>

            <div class="lg:col-span-2 lg:col-start-6">
                <p class="eyebrow eyebrow-light mb-5">Explore</p>
                <ul class="space-y-3 text-sm">
                    <li><a href={pathTo('/membership')} class="text-cream/60 no-underline hover:text-cream transition-colors">Membership</a></li>
                    <li><a href={pathTo('/healthcare')} class="text-cream/60 no-underline hover:text-cream transition-colors">Healthcare</a></li>
                    <li><a href={pathTo('/corporate')} class="text-cream/60 no-underline hover:text-cream transition-colors">Corporate Gifting</a></li>
                    <li><a href={pathTo('/fundraising')} class="text-cream/60 no-underline hover:text-cream transition-colors">Fundraising</a></li>
                    <li><a href={pathTo('/wholesale')} class="text-cream/60 no-underline hover:text-cream transition-colors">Wholesale</a></li>
                    <li><a href={pathTo('/stories')} class="text-cream/60 no-underline hover:text-cream transition-colors">Customer Stories</a></li>
                </ul>
            </div>

            <div class="lg:col-span-2">
                <p class="eyebrow eyebrow-light mb-5">Shop</p>
                <ul class="space-y-3 text-sm">
                    <li><a href="https://mindfulnesscandle.store/" target="_blank" rel="noopener noreferrer" class="text-cream/60 no-underline hover:text-cream transition-colors">Visit Store</a></li>
                    <li><a href={pathTo('/refocus-bundle')} class="text-cream/60 no-underline hover:text-cream transition-colors">Refocus Bundle</a></li>
                    <li><a href={pathTo('/#bundles')} class="text-cream/60 no-underline hover:text-cream transition-colors">Wellness Bundles</a></li>
                    <li><a href={pathTo('/#collections')} class="text-cream/60 no-underline hover:text-cream transition-colors">Collections</a></li>
                </ul>
            </div>

            <div class="lg:col-span-3">
                <p class="eyebrow eyebrow-light mb-5">Support & Policies</p>
                <ul class="space-y-3 text-sm">
                    <li><a href={pathTo('/contact')} class="text-cream/60 no-underline hover:text-cream transition-colors">Contact & Inquiries</a></li>
                    <li><a href={pathTo('/policies/shipping')} class="text-cream/60 no-underline hover:text-cream transition-colors">Shipping Policy</a></li>
                    <li><a href={pathTo('/policies/returns')} class="text-cream/60 no-underline hover:text-cream transition-colors">Return & Refund Policy</a></li>
                    <li><a href={pathTo('/policies/subscription')} class="text-cream/60 no-underline hover:text-cream transition-colors">Subscription Policy</a></li>
                    <li><a href="mailto:info@mindfulnesscandle.store" class="text-cream/60 no-underline hover:text-cream transition-colors">info@mindfulnesscandle.store</a></li>
                </ul>
            </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 py-8">
            <p class="text-cream/40 text-xs tracking-wide">
                &copy; {year} Mindfulness Candle Collection. All rights reserved.
            </p>
            <p class="text-cream/40 text-xs italic font-serif">
                Mindfulness begins with a single flame.
            </p>
        </div>
    </div>
</footer>
