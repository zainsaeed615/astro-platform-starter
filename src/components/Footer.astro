---
import { site, navigation } from '../data/site';
---

<footer class="border-t border-white/10 bg-[#0a0a0a]">
  <div class="container-site section-padding">
    <div class="grid gap-12 lg:grid-cols-4">
      <!-- Brand -->
      <div class="lg:col-span-1">
        <a href="/" class="group flex items-center gap-3 no-underline">
          <div class="flex h-10 w-10 items-center justify-center rounded-sm bg-gradient-accent text-sm font-bold text-white">
            17:2
          </div>
          <span class="font-display text-lg font-bold uppercase tracking-wider text-white">{site.name}</span>
        </a>
        <p class="mt-4 text-sm leading-relaxed text-white/50">{site.description.slice(0, 120)}...</p>
        <div class="mt-6 flex gap-3">
          {
            Object.entries(site.social).map(([platform, url]) => (
              <a
                href={url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex h-10 w-10 items-center justify-center rounded-sm border border-white/10 text-white/50 no-underline transition-all hover:border-blue-500 hover:text-blue-400"
                aria-label={platform}
              >
                {platform === 'facebook' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
                )}
                {platform === 'instagram' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg>
                )}
                {platform === 'youtube' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M2.5 17a24.12 24.12 0 0 1 0-10 2 2 0 0 1 1.4-1.4 49.56 49.56 0 0 1 16.2 0A2 2 0 0 1 21.5 7a24.12 24.12 0 0 1 0 10 2 2 0 0 1-1.4 1.4 49.55 49.55 0 0 1-16.2 0A2 2 0 0 1 2.5 17"/><path d="m10 15 5-3-5-3z"/></svg>
                )}
                {platform === 'x' && (
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                )}
              </a>
            ))
          }
        </div>
      </div>

      <!-- Quick Links -->
      <div>
        <h4 class="mb-4 text-sm font-semibold uppercase tracking-wider text-white">Quick Links</h4>
        <ul class="space-y-2">
          {
            navigation.slice(0, 6).map((item) => (
              <li>
                <a href={item.href} class="text-sm text-white/50 no-underline transition-colors hover:text-blue-400">
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Get Involved -->
      <div>
        <h4 class="mb-4 text-sm font-semibold uppercase tracking-wider text-white">Get Involved</h4>
        <ul class="space-y-2">
          <li><a href="/get-involved/apply" class="text-sm text-white/50 no-underline hover:text-blue-400">Apply to Join</a></li>
          <li><a href="/get-involved/prayer-team" class="text-sm text-white/50 no-underline hover:text-blue-400">Prayer Team</a></li>
          <li><a href="/get-involved/media-team" class="text-sm text-white/50 no-underline hover:text-blue-400">Media Team</a></li>
          <li><a href="/get-involved/online-decoy-team" class="text-sm text-white/50 no-underline hover:text-blue-400">Online Decoy Team</a></li>
          <li><a href="/get-involved/operations-team" class="text-sm text-white/50 no-underline hover:text-blue-400">Operations Team</a></li>
        </ul>
      </div>

      <!-- Newsletter -->
      <div>
        <h4 class="mb-4 text-sm font-semibold uppercase tracking-wider text-white">Stay Connected</h4>
        <p class="mb-4 text-sm text-white/50">Get mission updates, prayer requests, and news delivered to your inbox.</p>
        <form class="space-y-3" action="#" method="post">
          <input type="email" name="email" placeholder="Your email address" class="input-field" required />
          <button type="submit" class="btn-primary w-full">Subscribe</button>
        </form>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-8 sm:flex-row">
      <p class="text-sm text-white/40">&copy; {new Date().getFullYear()} {site.name}. All rights reserved.</p>
      <div class="flex gap-6">
        <a href="/privacy" class="text-sm text-white/40 no-underline hover:text-white">Privacy Policy</a>
        <a href="/terms" class="text-sm text-white/40 no-underline hover:text-white">Terms of Service</a>
        <a href="/contact" class="text-sm text-white/40 no-underline hover:text-white">Contact</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .bg-gradient-accent {
    background-image: linear-gradient(135deg, #1e40af, #3b82f6);
  }
  .font-display {
    font-family: 'Oswald', sans-serif;
  }
</style>
