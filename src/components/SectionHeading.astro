---
interface Props {
  label?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}

const { label, title, description, align = 'left' } = Astro.props;
---

<div class:list={[align === 'center' && 'text-center mx-auto max-w-3xl']}>
  {label && <span class="section-label">{label}</span>}
  <h2 class="mb-4">{title}</h2>
  {description && <p class="text-lg text-white/60 leading-relaxed">{description}</p>}
</div>
