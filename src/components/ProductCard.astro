---
interface Props {
    product: import('../data/products').Product;
    featured?: boolean;
}

const { product, featured = false } = Astro.props;
---

<a href={`/shop/product/${product.slug}`} class="group product-card-premium block no-underline">
    <div class="relative aspect-[4/5] overflow-hidden bg-black">
        <img
            src={product.image}
            alt={product.name}
            class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-110"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent opacity-80"></div>
        {product.badge && (
            <span class="absolute left-4 top-4 rounded-sm bg-brand-blue px-3 py-1.5 font-display text-xs uppercase tracking-widest text-white shadow-lg shadow-brand-blue/30">
                {product.badge}
            </span>
        )}
        <div class="absolute bottom-4 left-4 right-4 translate-y-2 opacity-0 transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100">
            <span class="inline-flex items-center gap-2 font-display text-xs uppercase tracking-widest text-brand-blue">
                View Product
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </span>
        </div>
    </div>
    <div class="border-t border-white/[0.06] p-6">
        <p class="font-display text-[10px] uppercase tracking-[0.25em] text-white/40">{product.category}</p>
        <h3 class="mt-2 font-display text-xl uppercase tracking-wide text-white transition-colors group-hover:text-brand-blue">{product.name}</h3>
        <div class="mt-4 flex items-center justify-between">
            <span class="font-display text-2xl tracking-wide text-brand-blue">${product.price.toFixed(2)}</span>
            {featured && <span class="text-[10px] uppercase tracking-widest text-white/30">Supports the mission</span>}
        </div>
    </div>
</a>
