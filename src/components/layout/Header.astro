---
import { site, navItems } from '../../content/site';
---

<header
  id="site-header"
  class="sticky top-0 z-50 border-b border-pdq-border/60 bg-white/95 backdrop-blur-md transition-shadow duration-300"
>
  <div class="container-pdq">
    <div class="flex h-20 lg:h-24 items-center justify-between gap-4">
      <a href="/" class="flex shrink-0 items-center no-underline" aria-label={site.name}>
        <img
          src={site.logo}
          alt={site.name}
          class="h-12 w-auto md:h-14"
          width="180"
          height="58"
        />
      </a>

      <nav class="hidden xl:flex items-center gap-1" aria-label="Primary">
        {
          navItems.map((item) => (
            <a href={item.href} class="link-nav px-3 py-2">
              {item.label}
            </a>
          ))
        }
      </nav>

      <div class="hidden md:flex items-center gap-4 lg:gap-5">
        <a
          href={site.phoneHref}
          class="no-underline text-sm font-bold text-pdq-navy hover:text-pdq-red transition"
        >
          {site.phone}
        </a>
        <a href="/contact" class="btn-primary !py-3 !px-5 text-xs">Get Free Estimate</a>
      </div>

      <button
        id="menu-toggle"
        type="button"
        class="xl:hidden inline-flex h-11 w-11 items-center justify-center border border-pdq-border text-pdq-navy"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="menu-icon flex flex-col gap-1.5">
          <span class="block h-0.5 w-5 bg-current"></span>
          <span class="block h-0.5 w-5 bg-current"></span>
          <span class="block h-0.5 w-5 bg-current"></span>
        </span>
      </button>
    </div>
  </div>

  <div
    id="mobile-menu"
    class="hidden xl:hidden border-t border-pdq-border bg-white"
  >
    <nav class="container-pdq flex flex-col gap-1 py-6" aria-label="Mobile">
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class="no-underline px-2 py-3 text-base font-semibold uppercase tracking-wide text-pdq-navy hover:text-pdq-red"
          >
            {item.label}
          </a>
        ))
      }
      <a href={site.phoneHref} class="no-underline px-2 py-3 font-bold text-pdq-navy">
        {site.phone}
      </a>
      <a href="/contact" class="btn-primary mt-3 w-full">Get Free Estimate</a>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  const onScroll = () => {
    if (!header) return;
    if (window.scrollY > 8) {
      header.classList.add('shadow-md', 'shadow-pdq-navy/5');
    } else {
      header.classList.remove('shadow-md', 'shadow-pdq-navy/5');
    }
  };

  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
  });
</script>
