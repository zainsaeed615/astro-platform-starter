---
interface Stat {
    value: string;
    label: string;
}

interface Props {
    stats: Stat[];
}

const { stats } = Astro.props;
---

<div class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
    {stats.map((stat) => (
        <div class="text-center">
            <p class="font-serif text-3xl sm:text-4xl text-charcoal font-light mb-2">{stat.value}</p>
            <p class="text-xs uppercase tracking-[0.15em] text-muted">{stat.label}</p>
        </div>
    ))}
</div>
