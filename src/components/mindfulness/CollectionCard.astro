---
interface Props {
    title: string;
    subtitle: string;
    description: string;
    highlights?: string[];
    ctaText: string;
    ctaHref: string;
    image: string;
    imageAlt: string;
}

const { title, subtitle, description, highlights = [], ctaText, ctaHref, image, imageAlt } = Astro.props;
---

<article class="card group flex flex-col h-full overflow-hidden">
    <div class="aspect-[16/10] overflow-hidden relative">
        <img
            src={image}
            alt={imageAlt}
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
            loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-charcoal/70 via-charcoal/20 to-transparent"></div>
        <div class="absolute bottom-6 left-6 right-6">
            <p class="text-gold-light text-[0.625rem] uppercase tracking-[0.2em] font-semibold mb-2">{subtitle}</p>
            <h3 class="text-cream text-2xl font-light">{title}</h3>
        </div>
    </div>
    <div class="p-8 sm:p-10 flex flex-col flex-1">
        <p class="text-warm-gray leading-relaxed text-[0.9375rem] mb-6 flex-1">{description}</p>
        {highlights.length > 0 && (
            <div class="flex flex-wrap gap-2 mb-8">
                {highlights.map((item) => (
                    <span class="pill text-xs !py-1.5 !px-3">{item}</span>
                ))}
            </div>
        )}
        <a href={ctaHref} class="inline-flex items-center gap-2 text-[0.6875rem] uppercase tracking-[0.15em] text-gold-dark font-semibold no-underline group-hover:gap-3 transition-all duration-300">
            {ctaText}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M5 12h14M12 5l7 7-7 7" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </a>
    </div>
</article>
