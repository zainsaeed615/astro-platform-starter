---
interface Props {
    eyebrow?: string;
    title: string;
    subtitle?: string;
    image: string;
    imageAlt: string;
    align?: 'left' | 'center';
    overlay?: boolean;
    minHeight?: string;
}

const { eyebrow, title, subtitle, image, imageAlt, align = 'left', overlay = true, minHeight = 'min-h-[90vh]' } = Astro.props;
---

<section class={`relative ${minHeight} flex items-end overflow-hidden`}>
    <div class="absolute inset-0 overflow-hidden">
        <img
            src={image}
            alt={imageAlt}
            class="absolute inset-0 w-full h-full object-cover animate-ken-burns"
            loading="eager"
        />
    </div>

    {overlay && (
        <>
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal via-charcoal/55 to-charcoal/15"></div>
            <div class="absolute inset-0 bg-gradient-to-r from-charcoal/50 via-transparent to-charcoal/20"></div>
            <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,transparent_0%,rgba(23,21,19,0.25)_100%)]"></div>
        </>
    )}

    <div class={`relative z-10 container-narrow pb-24 pt-44 sm:pb-32 sm:pt-52 animate-fade-up ${align === 'center' ? 'text-center mx-auto' : ''}`}>
        {eyebrow && (
            <div class={`flex items-center gap-5 mb-8 ${align === 'center' ? 'justify-center' : ''}`}>
                <span class="w-12 h-px bg-gradient-to-r from-transparent to-gold"></span>
                <p class="eyebrow eyebrow-light !mb-0">{eyebrow}</p>
                {align === 'center' && <span class="w-12 h-px bg-gradient-to-l from-transparent to-gold"></span>}
            </div>
        )}
        <h1 class={`text-cream max-w-5xl mb-8 font-light display-title ${align === 'center' ? 'mx-auto' : ''}`}>{title}</h1>
        {subtitle && (
            <p class={`text-cream/85 text-lg sm:text-xl lg:text-2xl max-w-2xl leading-relaxed font-light ${align === 'center' ? 'mx-auto' : ''}`}>
                {subtitle}
            </p>
        )}
        {Astro.slots.has('actions') && (
            <div class={`mt-12 flex flex-wrap gap-4 ${align === 'center' ? 'justify-center' : ''}`}>
                <slot name="actions" />
            </div>
        )}
    </div>

    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 z-10 hidden sm:flex flex-col items-center gap-3 animate-float">
        <span class="text-cream/35 text-[0.5625rem] uppercase tracking-[0.35em]">Discover</span>
        <span class="w-px h-10 bg-gradient-to-b from-gold/60 to-transparent"></span>
    </div>
</section>
