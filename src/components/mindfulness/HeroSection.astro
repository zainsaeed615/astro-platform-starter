---
interface Props {
    eyebrow?: string;
    title: string;
    subtitle?: string;
    image: string;
    imageAlt: string;
    align?: 'left' | 'center';
    overlay?: boolean;
    minHeight?: string;
}

const { eyebrow, title, subtitle, image, imageAlt, align = 'left', overlay = true, minHeight = 'min-h-[85vh]' } = Astro.props;
---

<section class={`relative ${minHeight} flex items-end overflow-hidden`}>
    <img
        src={image}
        alt={imageAlt}
        class="absolute inset-0 w-full h-full object-cover scale-105"
        loading="eager"
    />
    {overlay && (
        <div class="absolute inset-0 bg-gradient-to-t from-charcoal/90 via-charcoal/50 to-charcoal/20"></div>
    )}
    <div class="absolute inset-0 bg-gradient-to-r from-charcoal/30 to-transparent"></div>

    <div class={`relative z-10 container-narrow pb-20 pt-40 sm:pb-28 animate-fade-up ${align === 'center' ? 'text-center mx-auto' : ''}`}>
        {eyebrow && (
            <div class={`flex items-center gap-4 mb-6 ${align === 'center' ? 'justify-center' : ''}`}>
                <span class="w-8 h-px bg-gold"></span>
                <p class="eyebrow eyebrow-light !mb-0">{eyebrow}</p>
                {align === 'center' && <span class="w-8 h-px bg-gold"></span>}
            </div>
        )}
        <h1 class="text-cream max-w-4xl mb-8 font-light">{title}</h1>
        {subtitle && (
            <p class={`text-cream/80 text-lg sm:text-xl max-w-2xl leading-relaxed font-light ${align === 'center' ? 'mx-auto' : ''}`}>
                {subtitle}
            </p>
        )}
        {Astro.slots.has('actions') && (
            <div class={`mt-10 flex flex-wrap gap-4 ${align === 'center' ? 'justify-center' : ''}`}>
                <slot name="actions" />
            </div>
        )}
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 z-10 hidden sm:flex flex-col items-center gap-2 animate-float">
        <span class="text-cream/40 text-[0.625rem] uppercase tracking-[0.2em]">Scroll</span>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" class="text-cream/40">
            <path d="M12 5v14M5 12l7 7 7-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
    </div>
</section>
