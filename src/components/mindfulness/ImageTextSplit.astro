---
interface Props {
    title: string;
    description: string;
    image: string;
    imageAlt: string;
    reverse?: boolean;
    eyebrow?: string;
}

const { title, description, image, imageAlt, reverse = false, eyebrow } = Astro.props;
---

<section class="section-padding overflow-hidden">
    <div class={`container-narrow grid gap-12 lg:gap-20 items-center lg:grid-cols-2 ${reverse ? 'lg:[&>*:first-child]:order-2' : ''}`}>
        <div class="image-frame aspect-[4/3] group">
            <img
                src={image}
                alt={imageAlt}
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                loading="lazy"
            />
        </div>
        <div class={reverse ? 'lg:pr-8' : 'lg:pl-8'}>
            {eyebrow && (
                <div class="flex items-center gap-4 mb-5">
                    <span class="w-8 h-px bg-gold"></span>
                    <p class="eyebrow !mb-0">{eyebrow}</p>
                </div>
            )}
            <h2 class="mb-7 font-light">{title}</h2>
            <div class="text-warm-gray text-lg leading-relaxed space-y-5 font-light">
                <slot />
                {!Astro.slots.has('default') && <p>{description}</p>}
            </div>
            {Astro.slots.has('actions') && (
                <div class="mt-10 flex flex-wrap gap-4">
                    <slot name="actions" />
                </div>
            )}
        </div>
    </div>
</section>
