---
interface Props {
    title: string;
    description: string;
    image: string;
    imageAlt: string;
    reverse?: boolean;
    eyebrow?: string;
}

const { title, description, image, imageAlt, reverse = false, eyebrow } = Astro.props;
---

<section class="section-padding">
    <div class={`container-narrow grid gap-10 lg:gap-16 items-center lg:grid-cols-2 ${reverse ? 'lg:[&>*:first-child]:order-2' : ''}`}>
        <div class="aspect-[4/3] overflow-hidden rounded-sm shadow-lg">
            <img src={image} alt={imageAlt} class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div>
            {eyebrow && <p class="eyebrow">{eyebrow}</p>}
            <h2 class="mb-6">{title}</h2>
            <div class="text-warm-gray text-lg leading-relaxed space-y-4">
                <slot />
                {!Astro.slots.has('default') && <p>{description}</p>}
            </div>
            {Astro.slots.has('actions') && (
                <div class="mt-8 flex flex-wrap gap-4">
                    <slot name="actions" />
                </div>
            )}
        </div>
    </div>
</section>
