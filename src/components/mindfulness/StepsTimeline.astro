---
interface Step {
    title: string;
    description: string;
}

interface Props {
    steps: Step[];
}

const { steps } = Astro.props;
---

<ol class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {steps.map((step, index) => (
        <li class="relative pl-0">
            <div class="flex items-start gap-4">
                <span class="flex-shrink-0 w-10 h-10 rounded-full bg-sage-dark text-cream flex items-center justify-center font-semibold text-sm">
                    {index + 1}
                </span>
                <div>
                    <h3 class="text-lg mb-2">{step.title}</h3>
                    <p class="text-warm-gray text-sm leading-relaxed">{step.description}</p>
                </div>
            </div>
        </li>
    ))}
</ol>
