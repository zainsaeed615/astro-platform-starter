---
interface Props {
    eyebrow?: string;
    title: string;
    description?: string;
    align?: 'left' | 'center';
}

const { eyebrow, title, description, align = 'left' } = Astro.props;
---

<div class={`mb-16 sm:mb-20 ${align === 'center' ? 'text-center max-w-3xl mx-auto' : 'max-w-3xl'}`}>
    {eyebrow && (
        <div class={`flex items-center gap-5 mb-6 ${align === 'center' ? 'justify-center' : ''}`}>
            <span class="w-10 h-px bg-gradient-to-r from-gold/80 to-transparent"></span>
            <p class="eyebrow !mb-0">{eyebrow}</p>
            {align === 'center' && <span class="w-10 h-px bg-gradient-to-l from-gold/80 to-transparent"></span>}
        </div>
    )}
    <h2 class="mb-6 font-light">{title}</h2>
    {description && <p class="lead">{description}</p>}
</div>
