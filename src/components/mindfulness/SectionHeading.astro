---
interface Props {
    eyebrow?: string;
    title: string;
    description?: string;
    align?: 'left' | 'center';
}

const { eyebrow, title, description, align = 'left' } = Astro.props;
---

<div class={`mb-12 ${align === 'center' ? 'text-center max-w-3xl mx-auto' : 'max-w-3xl'}`}>
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <h2 class="mb-4">{title}</h2>
    {description && <p class="text-warm-gray text-lg leading-relaxed">{description}</p>}
</div>
