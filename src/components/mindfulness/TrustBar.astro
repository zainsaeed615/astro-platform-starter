---
const stats = [
    { value: '10', label: 'Signature Intentions' },
    { value: '100%', label: 'Clean-Burning Soy' },
    { value: '10%', label: 'Community Impact' },
    { value: 'USA', label: 'Handcrafted With Care' },
];
---

<section class="trust-bar section-padding-sm">
    <div class="container-narrow">
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12">
            {stats.map((stat) => (
                <div class="text-center group">
                    <p class="font-serif text-3xl sm:text-4xl text-charcoal font-light mb-2 group-hover:text-sage-dark transition-colors duration-500">{stat.value}</p>
                    <p class="text-[0.625rem] uppercase tracking-[0.22em] text-muted font-medium">{stat.label}</p>
                </div>
            ))}
        </div>
    </div>
</section>
