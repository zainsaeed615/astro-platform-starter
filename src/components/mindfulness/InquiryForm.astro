---
import SectionHeading from './SectionHeading.astro';

interface Props {
    id?: string;
    showIntro?: boolean;
}

const { id = 'contact', showIntro = true } = Astro.props;

const inquiryTypes = [
    'Healthcare Proposal',
    'Corporate Gifting',
    'Fundraising Partnership',
    'Wholesale Application',
    'General Inquiry',
];
---

<section id={id} class="section-padding bg-cream">
    <div class="container-narrow max-w-3xl mx-auto">
        {showIntro && (
            <div class="text-center mb-12">
                <SectionHeading
                    eyebrow="Partner With Us"
                    title="Let's Create a Meaningful Experience"
                    description="Thank you for your interest in partnering with Mindfulness Candle Collection. Please complete the form below with as much information as possible. A member of the Mindfulness Team will respond within two business days."
                    align="center"
                />
            </div>
        )}

        <form class="card-static p-8 sm:p-12 space-y-6" action="mailto:info@mindfulnesscandle.store" method="post" enctype="text/plain">
            <div class="grid gap-6 sm:grid-cols-2">
                <div>
                    <label for="name" class="block text-xs uppercase tracking-[0.15em] text-muted font-semibold mb-2">Name *</label>
                    <input type="text" id="name" name="name" required class="form-input" placeholder="Your full name" />
                </div>
                <div>
                    <label for="organization" class="block text-xs uppercase tracking-[0.15em] text-muted font-semibold mb-2">Organization</label>
                    <input type="text" id="organization" name="organization" class="form-input" placeholder="Organization name" />
                </div>
            </div>

            <div class="grid gap-6 sm:grid-cols-2">
                <div>
                    <label for="title" class="block text-xs uppercase tracking-[0.15em] text-muted font-semibold mb-2">Job Title</label>
                    <input type="text" id="title" name="title" class="form-input" placeholder="Your role" />
                </div>
                <div>
                    <label for="email" class="block text-xs uppercase tracking-[0.15em] text-muted font-semibold mb-2">Email *</label>
                    <input type="email" id="email" name="email" required class="form-input" placeholder="you@organization.com" />
                </div>
            </div>

            <div class="grid gap-6 sm:grid-cols-2">
                <div>
                    <label for="telephone" class="block text-xs uppercase tracking-[0.15em] text-muted font-semibold mb-2">Telephone</label>
                    <input type="tel" id="telephone" name="telephone" class="form-input" placeholder="(555) 000-0000" />
                </div>
                <div>
                    <label for="website" class="block text-xs uppercase tracking-[0.15em] text-muted font-semibold mb-2">Organization Website</label>
                    <input type="url" id="website" name="website" class="form-input" placeholder="https://" />
                </div>
            </div>

            <div class="grid gap-6 sm:grid-cols-2">
                <div>
                    <label for="inquiry-type" class="block text-xs uppercase tracking-[0.15em] text-muted font-semibold mb-2">Type of Inquiry *</label>
                    <select id="inquiry-type" name="inquiry-type" required class="form-input">
                        <option value="">Select inquiry type</option>
                        {inquiryTypes.map((type) => (
                            <option value={type}>{type}</option>
                        ))}
                    </select>
                </div>
                <div>
                    <label for="quantity" class="block text-xs uppercase tracking-[0.15em] text-muted font-semibold mb-2">Estimated Quantity</label>
                    <input type="text" id="quantity" name="quantity" class="form-input" placeholder="e.g. 50–500 units" />
                </div>
            </div>

            <div class="grid gap-6 sm:grid-cols-2">
                <div>
                    <label for="budget" class="block text-xs uppercase tracking-[0.15em] text-muted font-semibold mb-2">Estimated Budget</label>
                    <input type="text" id="budget" name="budget" class="form-input" placeholder="e.g. $5,000–$25,000" />
                </div>
                <div>
                    <label for="delivery-date" class="block text-xs uppercase tracking-[0.15em] text-muted font-semibold mb-2">Desired Delivery Date</label>
                    <input type="date" id="delivery-date" name="delivery-date" class="form-input" />
                </div>
            </div>

            <div>
                <label for="customization" class="block text-xs uppercase tracking-[0.15em] text-muted font-semibold mb-2">Customization Needs</label>
                <textarea id="customization" name="customization" rows="3" class="form-input resize-none" placeholder="Branded messaging, custom inserts, product combinations..."></textarea>
            </div>

            <div>
                <label for="shipping" class="block text-xs uppercase tracking-[0.15em] text-muted font-semibold mb-2">Shipping Locations</label>
                <input type="text" id="shipping" name="shipping" class="form-input" placeholder="Single location or multiple destinations" />
            </div>

            <div>
                <label for="additional" class="block text-xs uppercase tracking-[0.15em] text-muted font-semibold mb-2">Additional Information</label>
                <textarea id="additional" name="additional" rows="4" class="form-input resize-none" placeholder="Tell us about your goals, audience, and vision..."></textarea>
            </div>

            <button type="submit" class="btn btn-lg w-full justify-center">Submit Inquiry</button>
        </form>
    </div>
</section>
