---
interface Props {
    name: string;
    price: string;
    tagline: string;
    description: string;
    includes: string[];
    ctaText: string;
    ctaHref: string;
    featured?: boolean;
    image?: string;
}

const { name, price, tagline, description, includes, ctaText, ctaHref, featured = false, image } = Astro.props;
---

<article class={`card-luxe flex flex-col h-full overflow-hidden ${featured ? 'card-featured' : ''}`}>
    {featured && (
        <div class="bg-gradient-to-r from-gold-dark via-gold to-gold-light text-charcoal text-[0.625rem] uppercase tracking-[0.22em] font-semibold text-center py-3">
            Most Cherished
        </div>
    )}
    {image && (
        <div class="aspect-[16/10] overflow-hidden relative">
            <img src={image} alt={name} class="w-full h-full object-cover transition-transform duration-700 hover:scale-105" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-charcoal/40 to-transparent"></div>
        </div>
    )}
    <div class="p-8 sm:p-10 lg:p-12 flex flex-col flex-1">
        <p class="eyebrow !mb-3 !text-sage-dark">{name}</p>
        <p class="text-4xl font-serif text-charcoal mb-2 font-light">{price}</p>
        <p class="text-gold-dark italic font-serif text-xl mb-6">{tagline}</p>
        <div class="w-12 h-px bg-gradient-to-r from-gold to-transparent mb-6"></div>
        <p class="text-warm-gray leading-relaxed text-[0.975rem] mb-8">{description}</p>
        <p class="text-[0.625rem] uppercase tracking-[0.22em] text-muted font-semibold mb-4">Includes</p>
        <ul class="space-y-3 mb-10 flex-1">
            {includes.map((item) => (
                <li class="text-sm text-charcoal flex items-start gap-3">
                    <span class="flex-shrink-0 w-5 h-5 rounded-full bg-gradient-to-br from-sage-dark/15 to-gold/10 flex items-center justify-center mt-0.5 ring-1 ring-gold/15">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" class="text-sage-dark">
                            <path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </span>
                    {item}
                </li>
            ))}
        </ul>
        <a href={ctaHref} class="btn w-full justify-center text-[0.6875rem]">{ctaText}</a>
    </div>
</article>
