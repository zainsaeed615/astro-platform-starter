---
import '../styles/globals.css';
import '@fontsource-variable/dm-sans/wght.css';
import dmSansWoff2 from '@fontsource-variable/dm-sans/files/dm-sans-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = 'UltraHMB™ (β-Hydroxy β-MethylButyrate Calcium) — clinically researched HMB-Ca for sports nutrition, healthy aging, and cognitive health formulations.'
} = Astro.props;
const fullTitle = title.includes('UltraHMB') ? title : `${title} | UltraHMB™`;
const pathname = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>{fullTitle}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="preload" as="font" type="font/woff2" href={dmSansWoff2} crossorigin />
    </head>
    <body class="flex min-h-screen flex-col overflow-x-hidden" data-path={pathname}>
        <div id="cursor-glow" class="cursor-glow" aria-hidden="true"></div>
        <Header currentPath={pathname} />
        <main class="page-enter grow"><slot /></main>
        <Footer />
        <script>
            import '../scripts/ui.ts';
        </script>
    </body>
</html>
