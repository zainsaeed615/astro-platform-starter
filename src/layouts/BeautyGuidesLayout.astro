---
import '../styles/beauty-guides.css';
import Header from '../components/beauty-guides/Header.astro';
import Footer from '../components/beauty-guides/Footer.astro';
import { site } from '../data/beauty-guides';

interface Props {
    title: string;
    description?: string;
    hideFooterCta?: boolean;
}

const { title, description = site.tagline, hideFooterCta = false } = Astro.props;
const fullTitle = title === site.name ? title : `${title} — ${site.name}`;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>{fullTitle}</title>
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <meta name="generator" content={Astro.generator} />
        <link rel="icon" type="image/png" href="/beauty-guides/logo.png" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap"
            rel="stylesheet"
        />
    </head>
    <body class="bg-page antialiased" style="font-family: var(--font-sans);">
        <Header />
        <main>
            <slot />
        </main>
        <Footer hideCta={hideFooterCta} />
    </body>
</html>
