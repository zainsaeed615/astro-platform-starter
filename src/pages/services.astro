---
import Layout from '../layouts/Layout.astro';
import { site, coreServices, supportServices, processSteps } from '../content/vidian';
---

<Layout title={`Services | ${site.name}`} description="Explore Vidian Capital property investment, portfolio strategy, and support services across the UK and Dubai." noHeaderOverlay>
    <section class="bg-luxury pt-36 pb-20 text-white sm:pb-28">
        <div class="section-shell max-w-5xl">
            <p class="eyebrow">End-to-End Support</p>
            <h1>Our Services</h1>
            <p class="mt-6 max-w-3xl text-lg leading-8 text-white/72">
                Comprehensive property investment solutions designed for global investors seeking security and growth in the UK and Dubai markets.
            </p>
        </div>
    </section>

    <section class="py-20 sm:py-28">
        <div class="section-shell">
            <div class="reveal max-w-3xl">
                <p class="eyebrow">Investment Strategy</p>
                <h2>What We Do</h2>
            </div>
            <div class="mt-12 grid gap-6 md:grid-cols-2">
                {coreServices.map((service) => (
                    <a href={`/services/${service.slug}`} class="premium-card group grid overflow-hidden p-0 lg:grid-cols-[0.9fr_1.1fr]">
                        <img src={service.image} alt="" class="h-full min-h-72 w-full object-cover transition duration-500 group-hover:scale-105" />
                        <div class="p-7">
                            <h3 class="text-2xl">{service.title}</h3>
                            <p class="mt-4 leading-7">{service.summary}</p>
                            <ul class="mt-6 space-y-2 text-sm">
                                {service.bullets.map((item) => <li class="flex gap-2"><span class="text-gold">-</span>{item}</li>)}
                            </ul>
                            <span class="mt-7 inline-flex text-sm font-bold text-primary">Learn More -></span>
                        </div>
                    </a>
                ))}
            </div>
        </div>
    </section>

    <section class="bg-white py-20 sm:py-28">
        <div class="section-shell">
            <div class="reveal max-w-3xl">
                <p class="eyebrow">Acquisition Support</p>
                <h2>Support services for a clearer investment journey.</h2>
                <p class="mt-5 text-lg leading-8">The existing Vidian support services help investors move from financing and legals to reservation, furnishing, lettings, and management.</p>
            </div>
            <div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
                {supportServices.map((service) => (
                    <a href={`/services/${service.slug}`} class="premium-card reveal">
                        <h3>{service.title}</h3>
                        <p class="mt-4 leading-7">{service.summary}</p>
                        <span class="mt-7 inline-flex text-sm font-bold text-primary">Learn More -></span>
                    </a>
                ))}
            </div>
        </div>
    </section>

    <section class="py-20 sm:py-28">
        <div class="section-shell">
            <div class="reveal max-w-3xl">
                <p class="eyebrow">Investment Process</p>
                <h2>Our Process - 6 Step Investment Framework</h2>
            </div>
            <div class="mt-12 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                {processSteps.map((step) => <div class="premium-card reveal"><p class="font-accent text-6xl italic text-gold">{step.number}</p><h3 class="mt-5">{step.title}</h3><p class="mt-3 leading-7">{step.text}</p></div>)}
            </div>
        </div>
    </section>
</Layout>
