---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { siteConfig } from '../../data/site';
---

<Layout title="Live Prayer Calls" description="Join Operation 17:2 twice-monthly live Zoom prayer calls.">
    <PageHero label="Live Prayer" title="Prayer Calls" description="Twice-monthly corporate prayer covering the mission, victims, and teams in the field." />

    <section class="section-container py-16 md:py-24">
        <div class="mx-auto max-w-3xl">
            <p class="mb-10 text-center text-white/70">
                No operation moves without prayer behind it. Join us live via Zoom for corporate prayer — register below and add to your calendar.
            </p>

            <div class="space-y-6">
                {
                    siteConfig.prayerCalls.map((call) => (
                        <div class="card-surface flex flex-col gap-4 p-8 sm:flex-row sm:items-center sm:justify-between">
                            <div>
                                <p class="font-display text-xs uppercase tracking-widest text-brand-blue">
                                    {new Date(call.date).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' })}
                                </p>
                                <h3 class="mt-2 font-display text-xl font-semibold uppercase">{call.title}</h3>
                                <p class="mt-1 text-sm text-white/50">{call.time}</p>
                                <p class="mt-3 text-sm text-white/60">{call.description}</p>
                            </div>
                            <button class="btn-primary shrink-0" onclick="alert('Zoom registration — connect at launch')">Register</button>
                        </div>
                    ))
                }
            </div>

            <div class="card-surface mt-12 p-8 text-center">
                <h3 class="font-display text-lg font-semibold uppercase">Want to Lead a Prayer Call?</h3>
                <p class="mt-3 text-sm text-white/60">Prayer Team members may be invited to help lead calls.</p>
                <a href="/get-involved/prayer-team" class="btn-outline mt-6 inline-flex no-underline">Join Prayer Team</a>
            </div>
        </div>
    </section>
</Layout>

<script></script>
