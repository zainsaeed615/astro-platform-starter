---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
---

<Layout title="Terms of Service" description="Operation 17:2 Terms of Service.">
    <PageHero label="Legal" title="Terms of Service" />

    <section class="section-container py-16">
        <div class="mx-auto max-w-3xl space-y-6 text-white/70">
            <p><em>[Draft — requires legal review before launch]</em></p>
            <p>By using the Operation 17:2 website, shop, and services, you agree to these terms.</p>
            <h3 class="font-display text-lg uppercase text-white">Use of Services</h3>
            <p>Our website, shop, donation platform, and volunteer applications are provided for lawful purposes aligned with our mission. Misuse, harassment, or unauthorized access is prohibited.</p>
            <h3 class="font-display text-lg uppercase text-white">Shop & Donations</h3>
            <p>All purchases and donations are processed through secure third-party platforms. Refund and return policies for apparel are governed by our shop terms at checkout.</p>
            <h3 class="font-display text-lg uppercase text-white">Volunteer Applications</h3>
            <p>Submission of an application does not guarantee acceptance. All roles require background screening and leadership approval.</p>
            <h3 class="font-display text-lg uppercase text-white">Intellectual Property</h3>
            <p>Operation 17:2 branding, logo, and content are protected. Unauthorized use is prohibited.</p>
        </div>
    </section>
</Layout>
