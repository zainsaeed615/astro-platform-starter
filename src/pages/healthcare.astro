---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/mindfulness/HeroSection.astro';
import SectionHeading from '../components/mindfulness/SectionHeading.astro';
import ImageTextSplit from '../components/mindfulness/ImageTextSplit.astro';
import CTABand from '../components/mindfulness/CTABand.astro';
import InquiryForm from '../components/mindfulness/InquiryForm.astro';
import { images } from '../data/images';
import { pathTo } from '../utils/paths';

const solutions = [
    'Patient welcome and comfort packages',
    'Discharge and recovery gifts',
    'Caregiver appreciation programs',
    'Healthcare employee wellness gifts',
    'Hospital foundation and donor gifts',
    'Bereavement and remembrance packages',
    'Chronic and rare disease support initiatives',
    'Conference and patient-education gifts',
    'Custom organizational wellness programs',
];

const whyHealthcare = [
    'Flame-free product options',
    'Faith-sensitive and inclusive messaging',
    'Patient- and caregiver-centered experiences',
    'Custom gift notes and organizational inserts',
    'Volume and recurring-order opportunities',
    'Products suitable for recognition, encouragement, and comfort',
];

const bundleIncludes = [
    'One Reed Diffuser',
    'One Vehicle Diffuser',
    'One Comfort Blanket',
    'One Mindfulness Journal',
    'One Set of Affirmation Cards',
];
---

<Layout
    title="Mindfulness Healthcare"
    description="Comfort, reflection, and flame-free wellness for patients, caregivers, healthcare professionals, and organizations."
>
    <HeroSection
        eyebrow="Mindfulness Healthcare"
        title="Comfort, Reflection, and Flame-Free Wellness"
        subtitle="Healing is more than physical. Mindfulness Healthcare provides thoughtfully curated wellness products designed to support moments of comfort, reflection, encouragement, and intentional self-care."
        image={images.healthcare.hero}
        imageAlt="Person in calm setting with journal and reed diffuser"
    >
        <div slot="actions">
            <a href="#contact" class="btn btn-lg btn-gold">Request Healthcare Pricing</a>
            <a href="#flame-free" class="btn btn-lg btn-outline text-cream border-cream/60 hover:bg-cream/10 hover:text-cream">Flame-Free Bundle</a>
        </div>
    </HeroSection>

    <section class="section-padding bg-cream">
        <div class="container-narrow max-w-3xl mx-auto text-center">
            <p class="lead mb-8">
                Patients, caregivers, healthcare professionals, and families often navigate stress, uncertainty, exhaustion, grief, and life-changing transitions.
            </p>
            <p class="text-warm-gray leading-relaxed font-light">
                Our flame-free experiences are appropriate for hospitals, rehabilitation centers, senior-living communities, patient-support organizations, caregiver programs, medical practices, and other settings where open flames may not be permitted.
            </p>
        </div>
    </section>

    <section class="section-padding section-bg-stone">
        <div class="container-narrow">
            <SectionHeading eyebrow="Healthcare Solutions" title="Wellness Designed for Real Healthcare Environments" align="center" />
            <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 max-w-5xl mx-auto feature-list">
                {solutions.map((item) => (
                    <li class="card-static p-5 text-sm font-medium text-charcoal">{item}</li>
                ))}
            </ul>
        </div>
    </section>

    <section id="flame-free" class="section-padding bg-cream">
        <div class="container-narrow">
            <div class="grid gap-14 lg:grid-cols-2 items-center">
                <div>
                    <SectionHeading
                        eyebrow="Featured Bundle"
                        title="The Flame-Free Healthcare Bundle"
                        description="A carefully curated wellness experience created for patients, caregivers, and healthcare environments."
                    />
                    <ul class="space-y-3 mb-8">
                        {bundleIncludes.map((item) => (
                            <li class="text-sm text-charcoal flex items-center gap-2.5">
                                <span class="flex-shrink-0 w-5 h-5 rounded-full bg-sage-dark/10 flex items-center justify-center">
                                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" class="text-sage-dark"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </span>
                                {item}
                            </li>
                        ))}
                    </ul>
                    <p class="text-warm-gray text-sm leading-relaxed mb-8 font-light italic">
                        Customization, branded messaging, and volume pricing may be available for qualifying orders.
                    </p>
                    <a href="#contact" class="btn">Request Healthcare Pricing</a>
                </div>
                <div class="image-frame aspect-square">
                    <img src={images.healthcare.flameFree} alt="Flame-free healthcare wellness bundle" class="w-full h-full object-cover" loading="lazy" />
                </div>
            </div>
        </div>
    </section>

    <ImageTextSplit
        eyebrow="Why Mindfulness Healthcare?"
        title="Patient- and Caregiver-Centered Experiences"
        description=""
        image={images.healthcare.caregiver}
        imageAlt="Caregiver and loved one sharing a meaningful moment"
        reverse={true}
    >
        <ul class="space-y-3 mb-8">
            {whyHealthcare.map((item) => (
                <li class="text-sm text-warm-gray flex items-start gap-2.5">
                    <span class="flex-shrink-0 w-5 h-5 rounded-full bg-sage-dark/10 flex items-center justify-center mt-0.5">
                        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" class="text-sage-dark"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </span>
                    {item}
                </li>
            ))}
        </ul>
        <p class="text-xs text-muted leading-relaxed italic">
            Our products are intended to support general wellness, comfort, and reflection. They are not intended to diagnose, treat, cure, or prevent any medical or mental-health condition and are not a substitute for professional care.
        </p>
    </ImageTextSplit>

    <CTABand title="Request a Healthcare Proposal" subtitle="Tell us about your organization, audience, budget, desired quantity, and delivery timeline. A member of the Mindfulness Team will respond within two business days.">
        <a href="#contact" class="btn btn-lg btn-gold">Request Healthcare Pricing</a>
        <a href={pathTo('/corporate')} class="btn btn-lg btn-outline text-cream border-cream/60 hover:bg-cream/10 hover:text-cream">Corporate & Healthcare Inquiries</a>
    </CTABand>

    <InquiryForm id="contact" showIntro={false} />
</Layout>
