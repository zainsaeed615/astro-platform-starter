---
import BeautyGuidesLayout from '../../layouts/BeautyGuidesLayout.astro';
import { guideTopics, site } from '../../data/beauty-guides';
---

<BeautyGuidesLayout title="Customer Portal" description="Access your Complete Vietnam Surgery Companion guides." hideFooterCta>
    <section class="border-b border-[var(--color-peach)] bg-[var(--color-charcoal)] py-8 text-white">
        <div class="mx-auto flex max-w-6xl flex-col gap-4 px-4 md:flex-row md:items-center md:justify-between md:px-6">
            <div>
                <p class="text-xs uppercase tracking-widest text-white/60">Customer Portal · Mockup</p>
                <h1 class="font-serif text-2xl">Welcome back, Sarah</h1>
                <p class="text-sm text-white/70">The Complete Vietnam Surgery Companion</p>
            </div>
            <a href="/complete-guide" class="btn-tbg-outline border-white/30 text-white hover:bg-white hover:text-[var(--color-charcoal)]">Account Settings</a>
        </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 py-12 md:px-6">
        <p class="prose-tbg mb-8 max-w-2xl">
            This mockup shows Kirsty's preferred customer portal experience — organised chapters behind tiles rather than a collection of PDFs. Click any guide to open the full chapter.
        </p>

        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            {
                guideTopics.map((guide) => (
                    <a href={`/account/guides/${guide.slug}`} class="card-tbg block p-5 no-underline">
                        <span class="font-serif text-3xl text-[var(--color-taupe)]">{guide.number}</span>
                        <h2 class="mt-2 font-serif text-lg leading-snug">{guide.title}</h2>
                        <p class="mt-2 text-xs text-[var(--color-muted)] line-clamp-2">{guide.description}</p>
                        <span class="mt-3 inline-block text-xs font-semibold uppercase text-[var(--color-taupe)]">Open chapter →</span>
                    </a>
                ))
            }
            <a href="/account/guides/downloads" class="card-tbg flex flex-col justify-center border-2 border-dashed border-[var(--color-taupe)] bg-[var(--color-cream)] p-5 no-underline">
                <span class="text-2xl">📋</span>
                <h2 class="mt-2 font-serif text-lg">Checklists, Templates & Downloads</h2>
                <p class="mt-2 text-xs text-[var(--color-muted)]">Packing lists, question banks and printable resources.</p>
            </a>
        </div>

        <div class="mt-12 rounded-2xl bg-[var(--color-white-soft)] p-6 text-center">
            <p class="mb-2 font-serif text-xl">Mockup portal demo</p>
            <p class="prose-tbg mb-4 text-sm">In production, access is granted after Shopify checkout. This demo is open for preview.</p>
            <a href="/" class="btn-tbg-outline">← Back to Website</a>
        </div>
    </section>
</BeautyGuidesLayout>
