---
import BeautyGuidesLayout from '../../layouts/BeautyGuidesLayout.astro';
import GuideCard from '../../components/beauty-guides/GuideCard.astro';
import { guideTopics, site } from '../../data/beauty-guides';
---

<BeautyGuidesLayout title="Customer Portal" description="Access your Complete Vietnam Surgery Companion guides." hideFooterCta>
    <section class="relative overflow-hidden border-b border-[var(--color-peach)] bg-[var(--color-charcoal)] py-10 text-white">
        <div class="absolute inset-0 opacity-20">
            <img src="/beauty-guides/sections/product-companion.png" alt="" class="h-full w-full object-cover" />
        </div>
        <div class="section-inner relative flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
            <div>
                <p class="text-[11px] font-bold uppercase tracking-[0.25em] text-white/50">Customer Portal · Mockup</p>
                <h1 class="mt-2 font-serif text-3xl">Welcome back, Sarah</h1>
                <p class="mt-1 text-sm text-white/70">The Complete Vietnam Surgery Companion · 130+ pages</p>
            </div>
            <a href="/complete-guide" class="btn-tbg-outline !border-white/30 !text-white hover:!bg-white hover:!text-[var(--color-charcoal)]">Account Settings</a>
        </div>
    </section>

    <section class="section-inner py-12 md:py-16">
        <p class="prose-tbg mx-auto mb-10 max-w-2xl text-center">
            Kirsty's preferred experience — organised chapters behind tiles in a mobile-friendly portal, with downloadable checklists as a secondary option.
        </p>

        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            {
                guideTopics.map((guide) => (
                    <a href={`/account/guides/${guide.slug}`} class="card-tbg group block overflow-hidden no-underline">
                        <img src={guide.image} alt="" class="h-32 w-full object-cover transition duration-500 group-hover:scale-105" loading="lazy" />
                        <div class="p-5">
                            <span class="guide-number">{guide.number}</span>
                            <h2 class="mt-3 font-serif text-lg leading-snug">{guide.title}</h2>
                            <p class="mt-2 text-xs text-[var(--color-muted)] line-clamp-2">{guide.description}</p>
                            <span class="mt-3 inline-block text-[11px] font-bold uppercase tracking-wider text-[var(--color-taupe)]">Open chapter →</span>
                        </div>
                    </a>
                ))
            }
            <a href="/account/guides/downloads" class="card-tbg flex flex-col justify-center border-2 border-dashed border-[var(--color-taupe)] bg-[var(--color-cream)] p-6 no-underline">
                <span class="product-benefit-icon mb-3">📋</span>
                <h2 class="font-serif text-lg">Checklists, Templates & Downloads</h2>
                <p class="mt-2 text-xs text-[var(--color-muted)]">Packing lists, question banks and printable resources.</p>
            </a>
        </div>

        <div class="mx-auto mt-14 max-w-xl glass-panel text-center">
            <p class="mb-2 font-serif text-xl">Mockup portal demo</p>
            <p class="prose-tbg mb-4 text-sm">In production, access is granted after Shopify checkout.</p>
            <a href="/" class="btn-tbg-outline">← Back to Website</a>
        </div>
    </section>
</BeautyGuidesLayout>
