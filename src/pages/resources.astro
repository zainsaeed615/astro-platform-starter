---
import MainLayout from '../layouts/MainLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { resources } from '../data/site';
---

<MainLayout title="Resources" description="Educational resources, guides, and materials from Operation 17:2 to help protect children and support the mission.">
  <section class="border-b border-white/10 bg-[#0a0a0a]">
    <div class="container-site py-16 sm:py-20">
      <span class="section-label">Knowledge Base</span>
      <h1 class="mb-4">Resources</h1>
      <p class="max-w-2xl text-lg text-white/60">
        Educational materials, guides, and resources to help you understand our mission and protect the children in your community.
      </p>
    </div>
  </section>

  <section class="section-padding">
    <div class="container-site">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {
          resources.map((resource) => (
            <div class="card group cursor-pointer">
              <div class="mb-3 flex items-center justify-between">
                <span class="rounded-sm bg-blue-500/10 px-2 py-1 text-xs font-semibold uppercase tracking-wider text-blue-400">
                  {resource.category}
                </span>
                <span class="text-xs uppercase tracking-wider text-white/30">{resource.type}</span>
              </div>
              <h3 class="mb-2 text-lg group-hover:text-blue-400 transition-colors">{resource.title}</h3>
              <p class="text-sm text-white/50">{resource.description}</p>
              <span class="mt-4 inline-block text-sm font-medium uppercase tracking-wider text-blue-400 opacity-0 transition-opacity group-hover:opacity-100">
                Read More →
              </span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ Section from old site -->
  <section class="border-t border-white/10 bg-[#0a0a0a] section-padding">
    <div class="container-site max-w-3xl">
      <SectionHeading label="FAQ" title="Frequently Asked Questions" align="center" />
      <div class="mt-10 space-y-4">
        {
          [
            {
              q: 'How does my purchase help Operation 17:2 protect children?',
              a: 'The money goes directly back into our mission. This includes funding critical expenses such as decoy phone bills, travel for operations, and other necessary resources to identify and pursue child predators.',
            },
            {
              q: 'What should I know about your apparel?',
              a: 'Our apparel is designed for comfort and durability. Sizing guides are available on each product page. Most items are made from soft cotton blends and are machine washable.',
            },
            {
              q: 'How do shipping and returns work?',
              a: 'As every sale directly supports our vital mission, we do not accept returns. All sales are final. Shipping typically takes 5–7 business days within the United States.',
            },
            {
              q: 'What if I have a question not answered here?',
              a: 'Email us directly at op17two@gmail.com. We\'re here to help and ensure you have all the information you need.',
            },
          ].map((faq) => (
            <details class="card group">
              <summary class="cursor-pointer font-semibold text-white group-open:text-blue-400">{faq.q}</summary>
              <p class="mt-3 text-sm text-white/50">{faq.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</MainLayout>
