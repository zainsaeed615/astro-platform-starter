---
import Layout from '../../layouts/Layout.astro';
import { areaGuides, developments, site } from '../../content/vidian';

export function getStaticPaths() {
    return areaGuides.map((area) => ({ params: { city: area.city.toLowerCase() }, props: { area } }));
}

const { area } = Astro.props;
const cityDevelopments = developments.filter((item) => item.location.toLowerCase().includes(area.city.toLowerCase()) || area.city === 'London' || area.city === 'Nottingham').slice(0, 3);
---

<Layout title={`${area.city} Property Investment | ${site.name}`} description={`${area.city} property investment area guide from Vidian Capital.`} noHeaderOverlay>
    <section class="bg-luxury pt-40 pb-24 text-white sm:pb-32"><div class="section-shell grid items-center gap-12 lg:grid-cols-[1fr_0.9fr]"><div><p class="eyebrow">UK Investment Area Guide</p><h1>{area.city} Property Investment</h1><p class="mt-6 text-xl leading-9 text-white/75">{area.text}</p></div><img src={area.image} alt="" class="h-[28rem] w-full object-cover shadow-2xl shadow-black/30" /></div></section>
    <section class="py-24 sm:py-32"><div class="section-shell grid gap-6 md:grid-cols-3"><div class="premium-card"><p class="eyebrow">Yield</p><h2>{area.yield}</h2></div><div class="premium-card"><p class="eyebrow">5yr Growth</p><h2>{area.growth}</h2></div><div class="premium-card"><p class="eyebrow">Market</p><h2>UK</h2></div></div></section>
    <section class="bg-white py-24 sm:py-32"><div class="section-shell"><p class="eyebrow">Featured Developments</p><h2>Relevant Opportunities</h2><div class="mt-10 grid gap-6 md:grid-cols-3">{cityDevelopments.map((item) => <article class="premium-card"><h3>{item.title}</h3><p class="mt-3">{item.price}</p><p class="mt-3">{item.text}</p></article>)}</div></div></section>
    <section class="bg-luxury py-24 text-white sm:py-32"><div class="section-shell grid items-center gap-8 lg:grid-cols-[1fr_auto]"><div><p class="eyebrow">Ready to Explore {area.city}?</p><h2 class="text-white">Contact our team to review available opportunities and strategy fit.</h2></div><a href="/contact-us" class="btn btn-gold">Book a Consultation</a></div></section>
</Layout>
