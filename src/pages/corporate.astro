---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/mindfulness/HeroSection.astro';
import SectionHeading from '../components/mindfulness/SectionHeading.astro';
import ImageTextSplit from '../components/mindfulness/ImageTextSplit.astro';
import ImpactSection from '../components/mindfulness/ImpactSection.astro';
import CTABand from '../components/mindfulness/CTABand.astro';
import InquiryForm from '../components/mindfulness/InquiryForm.astro';
import { images } from '../data/images';

const opportunities = [
    'Employee appreciation',
    'Executive and leadership gifts',
    'Client and customer recognition',
    'Conference and event gifts',
    'New-hire welcome packages',
    'Workplace wellness initiatives',
    'Holiday and year-end gifting',
    'Retirement and milestone recognition',
    'Sympathy, encouragement, and bereavement gifts',
    'Diversity, equity, inclusion, and belonging initiatives',
];

const customization = [
    'Branded gift messages',
    'Custom affirmation cards',
    'Organizational inserts',
    'Curated product combinations',
    'Coordinated packaging',
    'Multiple-recipient shipping',
    'Recurring employee-wellness programs',
];
---

<Layout
    title="Corporate Gifting"
    description="Corporate gifting with purpose — show appreciation, encourage wellness, and create a lasting impression."
>
    <HeroSection
        eyebrow="Corporate Gifting"
        title="Corporate Gifting With Purpose"
        subtitle="Show appreciation. Encourage wellness. Create a lasting impression. Traditional gifts are often opened and forgotten. Mindfulness corporate gifts are designed to create meaningful moments of peace, reflection, gratitude, and connection."
        image={images.corporate.hero}
        imageAlt="Premium Mindfulness corporate gift box"
        align="center"
    >
        <div slot="actions" class="flex flex-wrap gap-4 justify-center">
            <a href="#contact" class="btn btn-lg btn-gold">Request a Corporate Proposal</a>
        </div>
    </HeroSection>

    <section class="section-padding bg-cream">
        <div class="container-narrow max-w-3xl mx-auto text-center">
            <p class="lead">
                Whether you are recognizing employees, welcoming clients, celebrating leadership, supporting workplace wellness, or commemorating an important milestone, we will help you create an experience that reflects your organization's values.
            </p>
        </div>
    </section>

    <section class="section-padding section-bg-stone">
        <div class="container-narrow">
            <SectionHeading eyebrow="Corporate Gifting Opportunities" title="Programs for Every Occasion" align="center" />
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 max-w-5xl mx-auto">
                {opportunities.map((item) => (
                    <div class="card-static p-6 text-center group hover:shadow-lg transition-all duration-500">
                        <p class="text-sm font-medium group-hover:text-sage-dark transition-colors">{item}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <section class="section-padding bg-cream">
        <div class="container-narrow">
            <SectionHeading
                eyebrow="Customization Options"
                title="Qualifying Orders May Include"
                description="Select corporate programs can be customized to create an experience unique to your organization."
                align="center"
            />
            <div class="flex flex-wrap gap-3 justify-center max-w-4xl mx-auto">
                {customization.map((item) => (
                    <span class="pill">{item}</span>
                ))}
            </div>
        </div>
    </section>

    <ImageTextSplit
        eyebrow="Purposeful Giving"
        title="Every Qualifying Purchase Creates Community Impact"
        description=""
        image={images.corporate.experience}
        imageAlt="Professionals opening Mindfulness gift boxes"
    >
        <p class="mb-6">
            Every qualifying purchase also helps advance education, patient advocacy, caregiver wellness, and community empowerment through our partnership with Friendship That Gives.
        </p>
        <p class="text-warm-gray font-light">
            Imagine opening an elegant Mindfulness gift box containing a beautifully curated combination of fragrance, reflection, comfort, and inspiration — all accompanied by a personalized message from your organization. That's more than promotional merchandise. That's an experience.
        </p>
    </ImageTextSplit>

    <ImpactSection />

    <CTABand title="Request a Corporate Gifting Proposal" subtitle="Share your anticipated quantity, budget, delivery date, recipient profile, and customization needs. A member of the Mindfulness Team will respond within two business days.">
        <a href="#contact" class="btn btn-lg btn-gold">Request a Corporate Proposal</a>
    </CTABand>

    <InquiryForm id="contact" showIntro={false} />
</Layout>
