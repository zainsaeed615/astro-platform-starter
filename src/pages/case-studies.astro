---
import Layout from '../layouts/Layout.astro';
import { site, developments, opportunities } from '../content/vidian';
---

<Layout title={`Case Studies | ${site.name}`} description="Review Vidian Capital featured opportunity notes and portfolio-style case studies." noHeaderOverlay>
    <section class="bg-luxury pt-36 pb-20 text-white sm:pb-28">
        <div class="section-shell max-w-5xl">
            <p class="eyebrow">Featured Opportunities / Case Studies</p>
            <h1>Case Studies</h1>
            <p class="mt-6 max-w-3xl text-lg leading-8 text-white/72">
                A premium overview of selected UK and Dubai opportunity themes used to guide investor conversations around income, growth, and portfolio balance.
            </p>
        </div>
    </section>

    <section class="py-20 sm:py-28">
        <div class="section-shell grid gap-8">
            {developments.map((item, index) => (
                <article class="premium-card reveal grid overflow-hidden p-0 lg:grid-cols-[0.9fr_1.1fr]">
                    <img src={item.image} alt="" class="h-full min-h-80 w-full object-cover" />
                    <div class="p-8 sm:p-10">
                        <p class="font-display text-5xl text-gold">0{index + 1}</p>
                        <p class="mt-5 text-sm font-bold uppercase tracking-[0.22em] text-gold">{item.location}</p>
                        <h2 class="mt-3 text-4xl">{item.title}</h2>
                        <p class="mt-5 text-lg leading-8 text-slate-600">{item.text}</p>
                        <div class="mt-8 grid gap-4 sm:grid-cols-3">
                            {['Market fit', 'Investor objective', 'Portfolio role'].map((label) => <div class="rounded-2xl bg-slate-50 p-4 text-sm font-semibold text-slate-700">{label}</div>)}
                        </div>
                    </div>
                </article>
            ))}
        </div>
    </section>

    <section class="bg-slate-50 py-20 sm:py-28">
        <div class="section-shell">
            <div class="reveal max-w-3xl">
                <p class="eyebrow">Portfolio Themes</p>
                <h2>UK income and Dubai growth, structured around investor priorities.</h2>
            </div>
            <div class="mt-12 grid gap-6 lg:grid-cols-2">
                {opportunities.map((item) => <div class="premium-card reveal"><h3>{item.title}</h3><p class="mt-4 leading-7 text-slate-600">{item.text}</p></div>)}
            </div>
        </div>
    </section>
</Layout>
