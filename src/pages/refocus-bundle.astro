---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/mindfulness/HeroSection.astro';
import SectionHeading from '../components/mindfulness/SectionHeading.astro';
import CTABand from '../components/mindfulness/CTABand.astro';
import { images } from '../data/images';

const includes = [
    'One Signature Candle',
    'One Reed Diffuser',
    'One Vehicle Diffuser',
];

const perfectFor = [
    'Personal wellness routines',
    'Work-from-home spaces',
    'Encouragement gifts',
    'Professional appreciation',
    'New beginnings',
    'Birthdays and special occasions',
];
---

<Layout
    title="The Refocus Bundle"
    description="The Refocus Bundle — return to what matters with a connected fragrance experience for home, workspace, and vehicle."
>
    <HeroSection
        eyebrow="Curated Wellness Bundle"
        title="The Refocus Bundle"
        subtitle="Return to what matters. Bring intention into every space with a connected fragrance experience for your home, workspace, and vehicle."
        image={images.bundles.refocus}
        imageAlt="Refocus Bundle with candle, reed diffuser, and vehicle diffuser"
        align="center"
        minHeight="min-h-[70vh]"
    >
        <div slot="actions" class="flex flex-wrap gap-4 justify-center">
            <a href="https://mindfulnesscandle.store/" target="_blank" rel="noopener noreferrer" class="btn btn-lg btn-gold">Shop the Refocus Bundle — $75</a>
        </div>
    </HeroSection>

    <section class="section-padding bg-cream">
        <div class="container-narrow max-w-3xl mx-auto text-center">
            <p class="lead mb-8">
                The Refocus Bundle was created for busy seasons, major transitions, demanding schedules, and moments when you need to quiet distractions and reconnect with your priorities.
            </p>
            <div class="divider-gold"></div>
            <p class="text-warm-gray leading-relaxed font-light italic font-serif text-xl">
                More than a bundle—it is an invitation to pause, clear your mind, and move forward with renewed intention.
            </p>
        </div>
    </section>

    <section class="section-padding section-bg-stone">
        <div class="container-narrow">
            <div class="grid gap-14 lg:grid-cols-2 items-start">
                <div>
                    <SectionHeading eyebrow="Your Bundle Includes" title="A Connected Fragrance Experience" />
                    <ul class="space-y-4 mb-10">
                        {includes.map((item) => (
                            <li class="text-charcoal flex items-center gap-3">
                                <span class="flex-shrink-0 w-6 h-6 rounded-full bg-sage-dark/10 flex items-center justify-center">
                                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" class="text-sage-dark"><path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                                </span>
                                <span class="font-medium">{item}</span>
                            </li>
                        ))}
                    </ul>
                    <p class="text-warm-gray leading-relaxed font-light mb-6">
                        Use the candle during prayer, journaling, meditation, or your evening wind-down. Allow the reed diffuser to create a continuous fragrance experience in your favorite space, and carry that sense of intention with you through the vehicle diffuser.
                    </p>
                </div>
                <div class="card-static p-10">
                    <p class="eyebrow !mb-3">Perfect For</p>
                    <ul class="space-y-3">
                        {perfectFor.map((item) => (
                            <li class="text-sm text-warm-gray flex items-start gap-2.5">
                                <span class="text-gold mt-1">•</span>
                                {item}
                            </li>
                        ))}
                    </ul>
                    <div class="mt-10 pt-8 border-t border-sand/40">
                        <p class="text-3xl font-serif text-charcoal font-light mb-4">$75</p>
                        <a href="https://mindfulnesscandle.store/" target="_blank" rel="noopener noreferrer" class="btn w-full justify-center">Shop the Refocus Bundle</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <CTABand title="Return to What Matters" subtitle="Create a continuous fragrance experience at home, at work, and while traveling.">
        <a href="https://mindfulnesscandle.store/" target="_blank" rel="noopener noreferrer" class="btn btn-lg btn-gold">Shop the Refocus Bundle</a>
    </CTABand>
</Layout>
