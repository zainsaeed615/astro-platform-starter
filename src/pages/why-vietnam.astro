---
import BeautyGuidesLayout from '../layouts/BeautyGuidesLayout.astro';
import PageHero from '../components/beauty-guides/PageHero.astro';
import { vietnamCards } from '../data/beauty-guides';
---

<BeautyGuidesLayout title="Why Vietnam" description="Kirsty's personal observations about cosmetic surgery in Vietnam — facilities, costs and care.">
    <PageHero
        eyebrow="Why Vietnam"
        title="Why Vietnam?"
        subtitle="World-class care. A different cost equation. An experience I'll never forget — shared as my personal journey, not a promise for everyone."
        image="/beauty-guides/mock2.png"
    />

    <section class="mx-auto max-w-3xl px-4 py-16 md:px-6">
        <div class="prose-tbg">
            <p>
                I chose Vietnam after extensive independent research. This page shares what I personally experienced — not universal guarantees. Every person's journey, outcomes and costs are different.
            </p>
        </div>
    </section>

    {
        vietnamCards.map((card, i) => (
            <section id={['facilities', 'costs', 'care'][i]} class={`py-16 ${i % 2 === 0 ? 'bg-[var(--color-cream)]' : 'bg-[var(--color-white-soft)]'}`}>
                <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 md:grid-cols-2 md:px-6">
                    <div class={i % 2 === 1 ? 'md:order-2' : ''}>
                        <img src={card.image} alt={card.title} class="rounded-3xl shadow-lg" loading="lazy" />
                    </div>
                    <div class={i % 2 === 1 ? 'md:order-1' : ''}>
                        <p class="section-eyebrow mb-3">Personal observation</p>
                        <h2 class="section-title mb-4">{card.title}</h2>
                        <p class="prose-tbg mb-6">{card.copy}</p>
                        <p class="prose-tbg text-sm">
                            {i === 0 && 'I describe the facilities, equipment and hospital environment I personally saw, with photographs where approved.'}
                            {i === 1 && 'A dated personal cost comparison covering procedures, travel, accommodation and recovery — not a quote or offer.'}
                            {i === 2 && 'The people who cared for me during recovery. Your experience may differ.'}
                        </p>
                    </div>
                </div>
            </section>
        ))
    }

    <section class="py-16 text-center">
        <a href="/plan-your-trip" class="btn-tbg-primary">Plan Your Trip</a>
    </section>
</BeautyGuidesLayout>
