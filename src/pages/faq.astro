---
import Layout from '../layouts/Layout.astro';
import { site, faqs } from '../content/vidian';
---

<Layout title={`FAQ | ${site.name}`} description="Frequently asked questions about Vidian Capital property investment strategy and advisory support." noHeaderOverlay>
    <section class="bg-luxury pt-36 pb-20 text-white sm:pb-28">
        <div class="section-shell max-w-5xl">
            <p class="eyebrow">Investor FAQ</p>
            <h1>Frequently Asked Questions</h1>
            <p class="mt-6 max-w-3xl text-lg leading-8 text-white/72">Common questions about Vidian Capital, UK and Dubai property investment, and the six-step investment framework.</p>
        </div>
    </section>

    <section class="py-20 sm:py-28">
        <div class="section-shell max-w-4xl space-y-4">
            {faqs.map((item) => (
                <details class="faq-item reveal rounded-3xl border border-slate-200 bg-white p-6 shadow-lg shadow-slate-950/5">
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-bold text-slate-950">
                        {item.question}
                        <span class="text-2xl text-gold">+</span>
                    </summary>
                    <p class="mt-4 leading-8 text-slate-600">{item.answer}</p>
                </details>
            ))}
        </div>
    </section>
</Layout>
