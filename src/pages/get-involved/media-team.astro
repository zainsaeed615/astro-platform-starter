---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
---

<Layout title="Media Team" description="Join the Operation 17:2 Media Team — document the mission with integrity.">
    <PageHero label="Get Involved" title="Media Team" description="Documenting the mission. Your footage tells the truth." />

    <section class="section-container py-16 md:py-24">
        <div class="mx-auto max-w-3xl">
            <div class="card-surface mb-8 p-8">
                <h3 class="font-display text-lg font-semibold uppercase text-brand-blue">What You'll Do</h3>
                <ul class="mt-4 space-y-2 text-white/70">
                    <li>• Accompany operations into the field and capture clear, accurate footage.</li>
                    <li>• Document events without interfering with the operation or law enforcement.</li>
                    <li>• Protect the integrity of what you record.</li>
                    <li>• Work entirely within our recording, consent, and publication policy.</li>
                </ul>
            </div>
            <div class="card-surface mb-8 p-8">
                <h3 class="font-display text-lg font-semibold uppercase text-brand-blue">What We Expect</h3>
                <ul class="mt-4 space-y-2 text-white/70">
                    <li>• Strong technical skill and steady hands in tense, fast-moving situations.</li>
                    <li>• Composure to keep filming — and wisdom to stay out of the way.</li>
                    <li>• Emotional readiness; you will witness confrontations up close.</li>
                    <li>• Strict adherence to what may and may not be published.</li>
                    <li>• Confidentiality and careful handling of footage.</li>
                </ul>
            </div>
            <blockquote class="border-l-4 border-brand-blue pl-6 text-lg italic text-white/80">
                The camera tells the truth. Your job is to let it.
            </blockquote>
            <a href="/get-involved/apply" class="btn-primary mt-10 inline-flex no-underline">Apply for Media Team</a>
        </div>
    </section>
</Layout>
