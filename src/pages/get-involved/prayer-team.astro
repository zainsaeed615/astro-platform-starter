---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
---

<Layout title="Prayer Team" description="Join the Operation 17:2 Prayer Team — the spiritual foundation of the mission.">
    <PageHero label="Get Involved" title="Prayer Team" description="The foundation everything else is built on. No operation moves without prayer behind it." />

    <section class="section-container py-16 md:py-24">
        <div class="mx-auto max-w-3xl">
            <div class="card-surface mb-8 p-8">
                <h3 class="font-display text-lg font-semibold uppercase text-brand-blue">What You'll Do</h3>
                <ul class="mt-4 space-y-2 text-white/70">
                    <li>• Commit to praying faithfully for the mission, victims, and the work.</li>
                    <li>• Pray for predators — that they would be stopped, exposed, and brought to repentance.</li>
                    <li>• Cover decoys, media, and operations members who carry heavy weight.</li>
                    <li>• Pray for leaders and every new team as we expand.</li>
                    <li>• Join twice-monthly live prayer calls — some will help lead them.</li>
                </ul>
            </div>
            <div class="card-surface mb-8 p-8">
                <h3 class="font-display text-lg font-semibold uppercase text-brand-blue">What We Expect</h3>
                <ul class="mt-4 space-y-2 text-white/70">
                    <li>• Faithfulness to the commitment, even when the work is unseen.</li>
                    <li>• Confidentiality — you may become aware of sensitive matters.</li>
                    <li>• Emotional and spiritual resilience; this mission involves heavy subject matter.</li>
                    <li>• A heart for both the protection of children and the souls of the lost.</li>
                </ul>
            </div>
            <blockquote class="border-l-4 border-brand-blue pl-6 text-lg italic text-white/80">
                We don't pray because we've run out of other options. We pray because it's where the mission starts.
            </blockquote>
            <a href="/get-involved/apply" class="btn-primary mt-10 inline-flex no-underline">Apply for Prayer Team</a>
        </div>
    </section>
</Layout>
