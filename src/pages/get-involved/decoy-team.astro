---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
---

<Layout title="Online Decoy Team" description="Join the Operation 17:2 Online Decoy Team — the hardest seat on the team.">
    <PageHero label="Get Involved" title="Online Decoy Team" description="The hardest seat on the team — and one of the most crucial." />

    <section class="section-container py-16 md:py-24">
        <div class="mx-auto max-w-3xl">
            <div class="card-surface mb-8 border-yellow-500/20 p-8">
                <h3 class="font-display text-lg font-semibold uppercase text-yellow-400">What This Role Really Involves</h3>
                <ul class="mt-4 space-y-2 text-white/70">
                    <li>• Exposure to explicit, disturbing, and manipulative material directed at you.</li>
                    <li>• Meticulous, repetitive work that is at times deeply unpleasant.</li>
                    <li>• Everything is trained, supervised, documented, and done strictly within the law.</li>
                    <li>• You never operate alone or off-script from leadership.</li>
                </ul>
            </div>
            <div class="card-surface mb-8 p-8">
                <h3 class="font-display text-lg font-semibold uppercase text-brand-blue">What We Require</h3>
                <ul class="mt-4 space-y-2 text-white/70">
                    <li>• Mental and emotional maturity — the non-negotiable.</li>
                    <li>• A real support system — people, faith, and willingness to use counseling.</li>
                    <li>• Honesty to step back when you need to.</li>
                    <li>• Discipline, patience, confidentiality, and full submission to training.</li>
                </ul>
            </div>
            <div class="card-surface mb-8 p-8">
                <h3 class="font-display text-lg font-semibold uppercase text-brand-blue">What We Give You</h3>
                <ul class="mt-4 space-y-2 text-white/70">
                    <li>• Training before you ever begin.</li>
                    <li>• Ongoing supervision, documentation support, and a team that has your back.</li>
                    <li>• Prayer covering and access to support for the weight you'll carry.</li>
                </ul>
            </div>
            <p class="text-sm text-white/50">[Legal review required before launch]</p>
            <a href="/get-involved/apply" class="btn-primary mt-8 inline-flex no-underline">Apply for Decoy Team</a>
        </div>
    </section>
</Layout>
