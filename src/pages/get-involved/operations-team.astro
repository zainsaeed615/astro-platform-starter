---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
---

<Layout title="Operations Team" description="Join the Operation 17:2 Operations Team — confronting predators with courage and restraint.">
    <PageHero label="Get Involved" title="Operations Team" description="Confronting predators — with courage and restraint." />

    <section class="section-container py-16 md:py-24">
        <div class="mx-auto max-w-3xl">
            <div class="card-surface mb-8 p-8">
                <h3 class="font-display text-lg font-semibold uppercase text-brand-blue">What You'll Do</h3>
                <ul class="mt-4 space-y-2 text-white/70">
                    <li>• Be physically present for confrontations of suspected predators.</li>
                    <li>• Keep every encounter calm, controlled, lawful, and on-camera.</li>
                    <li>• De-escalate, never escalate.</li>
                    <li>• Coordinate with and defer to law enforcement.</li>
                    <li>• Follow your team lead's direction without exception.</li>
                </ul>
            </div>
            <div class="card-surface mb-8 border-red-500/20 p-8">
                <h3 class="font-display text-lg font-semibold uppercase text-red-400">Non-Negotiables</h3>
                <ul class="mt-4 space-y-2 text-white/70">
                    <li>• Non-violent and lawful. No physical contact.</li>
                    <li>• No detaining anyone. No weapons. Ever.</li>
                    <li>• Stand down the moment your team lead says so.</li>
                    <li>• Goal is exposure, accountability, and lawful handoff — not vigilante justice.</li>
                </ul>
            </div>
            <blockquote class="border-l-4 border-brand-blue pl-6 text-lg italic text-white/80">
                The strongest person in the room is the one who keeps it under control.
            </blockquote>
            <p class="mt-6 text-sm text-white/50">[Legal review required before launch]</p>
            <a href="/get-involved/apply" class="btn-primary mt-8 inline-flex no-underline">Apply for Operations Team</a>
        </div>
    </section>
</Layout>
