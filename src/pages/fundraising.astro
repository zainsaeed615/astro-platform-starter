---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/mindfulness/HeroSection.astro';
import SectionHeading from '../components/mindfulness/SectionHeading.astro';
import StepsTimeline from '../components/mindfulness/StepsTimeline.astro';
import CTABand from '../components/mindfulness/CTABand.astro';
import InquiryForm from '../components/mindfulness/InquiryForm.astro';
import { images } from '../data/images';

const steps = [
    { title: 'Submit a Partnership Inquiry', description: 'Tell us about your organization, fundraising goal, campaign dates, and intended audience.' },
    { title: 'Identify Products & Structure', description: 'We help identify the appropriate products and fundraising structure for your community.' },
    { title: 'Receive Campaign Information', description: 'Your organization receives its customized campaign information and resources.' },
    { title: 'Supporters Purchase', description: 'Supporters purchase approved Mindfulness products through your campaign experience.' },
    { title: 'Receive Fundraising Proceeds', description: 'Your organization receives the agreed-upon fundraising proceeds based on verified eligible sales.' },
];

const idealPartners = [
    'Churches and faith-based organizations',
    'Schools and educational programs',
    'Sororities and fraternities',
    'Civic and professional associations',
    'Nonprofit organizations',
    'Health and patient-advocacy groups',
    'Sports teams and youth programs',
    'Alumni chapters and affinity groups',
];

const whyPartner = [
    'Purpose-driven products',
    'Broad gifting appeal',
    'Faith-centered and wellness-focused messaging',
    'Options for in-person and digital campaigns',
    'Clearly defined campaign periods',
    'Supportive campaign resources',
    'Meaningful products supporters can enjoy beyond the fundraiser',
];
---

<Layout
    title="Fundraising Partnerships"
    description="Fundraising that inspires wellness — raise funds while giving your community something meaningful."
>
    <HeroSection
        eyebrow="Fundraising Partnerships"
        title="Fundraising That Inspires Wellness"
        subtitle="Raise funds while giving your community something meaningful. Instead of selling another ordinary product, your organization can offer a meaningful experience that people will be proud to purchase, use, and share."
        image={images.fundraising.hero}
        imageAlt="Community fundraising with Mindfulness wellness products"
        align="center"
    >
        <div slot="actions" class="flex flex-wrap gap-4 justify-center">
            <a href="#contact" class="btn btn-lg btn-gold">Start Your Fundraiser</a>
        </div>
    </HeroSection>

    <section class="section-padding bg-cream">
        <div class="container-narrow max-w-3xl mx-auto text-center">
            <p class="lead">
                Mindfulness Fundraising Partnerships help nonprofit organizations, schools, churches, sororities, fraternities, civic organizations, alumni associations, athletic programs, and community groups raise funds through products centered on wellness, encouragement, and intentional living.
            </p>
        </div>
    </section>

    <section class="section-padding section-bg-stone">
        <div class="container-narrow">
            <SectionHeading eyebrow="How the Program Works" title="Five Simple Steps" align="center" />
            <StepsTimeline steps={steps} />
        </div>
    </section>

    <section class="section-padding bg-cream">
        <div class="container-narrow">
            <SectionHeading eyebrow="Ideal Fundraising Partners" title="Organizations We Support" align="center" />
            <div class="flex flex-wrap gap-3 justify-center max-w-5xl mx-auto">
                {idealPartners.map((org) => (
                    <span class="pill">{org}</span>
                ))}
            </div>
        </div>
    </section>

    <section class="section-padding section-bg-stone">
        <div class="container-narrow">
            <SectionHeading eyebrow="Why Partner With Mindfulness?" title="Purpose-Driven Fundraising" align="center" />
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 max-w-5xl mx-auto">
                {whyPartner.map((item) => (
                    <div class="card-static p-6 text-center group hover:shadow-lg transition-all duration-500">
                        <p class="text-sm font-medium group-hover:text-sage-dark transition-colors">{item}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <CTABand title="Start a Fundraising Partnership" subtitle="Tell us about your organization, fundraising goal, campaign dates, estimated number of participants, and intended audience. A member of the Mindfulness Team will respond within two business days.">
        <a href="#contact" class="btn btn-lg btn-gold">Start Your Fundraiser</a>
    </CTABand>

    <InquiryForm id="contact" showIntro={false} />
</Layout>
