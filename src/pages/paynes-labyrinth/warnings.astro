---
import LabyrinthLayout from '../../layouts/LabyrinthLayout.astro';
import { labyrinthWarnings } from '../../data/labyrinth';
---

<LabyrinthLayout title="Warnings | Payne's Labyrinth">
  <section class="page-hero">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="section-label">Read Before Entering</p>
      <h1 class="text-4xl md:text-6xl font-bold font-[Bebas_Neue] tracking-wider text-white mb-4">Warnings</h1>
      <p class="text-gray-400 max-w-xl mx-auto">Payne's Labyrinth is an intense haunted attraction. Please review all advisories before purchasing tickets.</p>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-6 pb-20 space-y-4">
    {labyrinthWarnings.map((warning) => (
      <div class={`content-card border-l-4 ${warning.severity === 'high' ? 'border-l-red-500' : 'border-l-[#f3a641]'}`}>
        <div class="flex items-start gap-4">
          <div class={`shrink-0 w-10 h-10 rounded-lg flex items-center justify-center ${warning.severity === 'high' ? 'bg-red-500/10 text-red-400' : 'bg-[#f3a641]/10 text-[#f3a641]'}`}>
            {warning.severity === 'high' ? (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/></svg>
            ) : (
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            )}
          </div>
          <div>
            <h2 class="text-lg font-bold text-white mb-2">{warning.title}</h2>
            <p class="text-gray-400 leading-relaxed text-sm">{warning.content}</p>
          </div>
        </div>
      </div>
    ))}
  </section>
</LabyrinthLayout>
