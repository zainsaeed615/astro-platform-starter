---
import LabyrinthLayout from '../../../layouts/LabyrinthLayout.astro';
import EmploymentForm from '../../../components/EmploymentForm';
---

<LabyrinthLayout title="Employment | Payne's Labyrinth">
  <section class="page-hero">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="section-label">Join the Cast</p>
      <h1 class="text-4xl md:text-6xl font-bold font-[Bebas_Neue] tracking-wider text-white mb-4">Employment</h1>
      <p class="text-gray-400 max-w-xl mx-auto">Love Halloween and all its magic? Looking for a fun seasonal job? Apply below.</p>
    </div>
  </section>

  <section class="max-w-2xl mx-auto px-6 pb-20">
    <EmploymentForm client:load theme="labyrinth" />
    <p class="text-center mt-8 text-sm text-gray-500">
      Have questions? Visit our <a href="/paynes-labyrinth/employment/faq" class="text-[#f3a641] no-underline hover:underline">Employment FAQs</a>.
    </p>
  </section>
</LabyrinthLayout>
