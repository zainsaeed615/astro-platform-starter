---
import LabyrinthLayout from '../../../layouts/LabyrinthLayout.astro';
import FaqAccordion from '../../../components/FaqAccordion';
import { employmentFaq } from '../../../data/shared';
---

<LabyrinthLayout title="Employment FAQ | Payne's Labyrinth">
  <section class="page-hero">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="section-label">Working With Us</p>
      <h1 class="text-4xl md:text-6xl font-bold font-[Bebas_Neue] tracking-wider text-white mb-4">Employment FAQ</h1>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-6 pb-20">
    <FaqAccordion client:load items={employmentFaq} theme="labyrinth" />
    <div class="text-center mt-10">
      <a href="/paynes-labyrinth/employment" class="btn-primary-labyrinth">Apply Now</a>
    </div>
  </section>
</LabyrinthLayout>
