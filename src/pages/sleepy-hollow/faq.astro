---
import SleepyHollowLayout from '../../layouts/SleepyHollowLayout.astro';
import FaqAccordion from '../../components/FaqAccordion';
import { sleepyHollowFaq } from '../../data/sleepy-hollow';
---

<SleepyHollowLayout title="FAQ | Ichabod Payne's Sleepy Hollow">
  <section class="page-hero">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="section-label">Got Questions?</p>
      <h1 class="text-4xl md:text-5xl font-bold font-[Cinzel] text-[#f4ead5] mb-4">Frequently Asked Questions</h1>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-6 pb-20">
    <FaqAccordion client:load items={sleepyHollowFaq} theme="ipsh" />
  </section>
</SleepyHollowLayout>
