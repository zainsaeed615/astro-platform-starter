---
import SleepyHollowLayout from '../../layouts/SleepyHollowLayout.astro';
import { weatherContent } from '../../data/shared';
---

<SleepyHollowLayout title="Weather Policy | Ichabod Payne's Sleepy Hollow">
  <section class="page-hero">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="section-label">Stay Informed</p>
      <h1 class="text-4xl md:text-5xl font-bold font-[Cinzel] text-[#f4ead5] mb-4">Weather Info</h1>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-6 pb-20 space-y-8">
    <div class="content-card text-center py-10">
      <svg class="w-12 h-12 mx-auto mb-4 text-[#c9a227]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"/></svg>
      <p class="text-xl font-[Cormorant_Garamond] italic text-[#f4ead5]">{weatherContent.defaultMessage}</p>
    </div>

    <div>
      <h2 class="text-2xl font-bold font-[Cinzel] text-[#f4ead5] mb-6">Bad Weather Policy</h2>
      <div class="space-y-4">
        {weatherContent.policy.map((paragraph) => (
          <div class="content-card">
            <p class="text-[#f4ead5]/70 leading-relaxed">{paragraph}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</SleepyHollowLayout>
