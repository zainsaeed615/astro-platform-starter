---
import SleepyHollowLayout from '../../../layouts/SleepyHollowLayout.astro';
import EmploymentForm from '../../../components/EmploymentForm';
---

<SleepyHollowLayout title="Employment | Ichabod Payne's Sleepy Hollow">
  <section class="page-hero">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="section-label">Join Our Team</p>
      <h1 class="text-4xl md:text-5xl font-bold font-[Cinzel] text-[#f4ead5] mb-4">Employment</h1>
      <p class="text-[#f4ead5]/60 max-w-xl mx-auto">Love Halloween and all its magic? Looking for a fun seasonal job? Apply below.</p>
    </div>
  </section>

  <section class="max-w-2xl mx-auto px-6 pb-20">
    <EmploymentForm client:load theme="ipsh" />
    <p class="text-center mt-8 text-sm text-[#f4ead5]/50">
      Have questions? Visit our <a href="/sleepy-hollow/employment/faq" class="text-[#c9a227] no-underline hover:underline">Employment FAQs</a>.
    </p>
  </section>
</SleepyHollowLayout>
