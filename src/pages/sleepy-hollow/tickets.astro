---
import SleepyHollowLayout from '../../layouts/SleepyHollowLayout.astro';
import { sleepyHollowTickets } from '../../data/sleepy-hollow';
import { siteInfo } from '../../data/shared';
---

<SleepyHollowLayout title="Tickets & Pricing | Ichabod Payne's Sleepy Hollow">
  <section class="page-hero">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="section-label">Plan Your Visit</p>
      <h1 class="text-4xl md:text-5xl font-bold font-[Cinzel] text-[#f4ead5] mb-4">Tickets & Pricing</h1>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-8">
    <div class="content-card mb-8">
      <ul class="space-y-2 text-[#f4ead5]/70 text-sm">
        {sleepyHollowTickets.notes.map((note) => (
          <li class="flex gap-2"><span class="text-[#c9a227]">•</span>{note}</li>
        ))}
      </ul>
    </div>
  </section>

  <section id="sleepy-hollow" class="max-w-5xl mx-auto px-6 pb-12 scroll-mt-24">
    <h2 class="text-2xl font-bold font-[Cinzel] text-[#f4ead5] mb-6 flex items-center gap-3">
      <span class="w-8 h-px bg-[#c9a227]"></span> Sleepy Hollow Tickets
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {sleepyHollowTickets.tickets.map((ticket) => (
        <div class="content-card">
          <div class="flex items-start justify-between mb-4">
            <h3 class="text-xl font-bold text-[#f4ead5]">{ticket.name}</h3>
            {ticket.badge && <span class="text-xs font-bold uppercase tracking-wider text-[#c9a227] bg-[#c9a227]/10 px-2 py-1 rounded">{ticket.badge}</span>}
          </div>
          <p class="text-3xl font-bold text-[#c9a227] mb-1">{ticket.price}{ticket.per && <span class="text-base font-normal text-[#f4ead5]/50 ml-1">{ticket.per}</span>}</p>
          {ticket.age && <p class="text-sm text-[#f4ead5]/50 mb-3">{ticket.age}</p>}
          <p class="text-[#f4ead5]/70 text-sm leading-relaxed">{ticket.description}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="combo" class="max-w-5xl mx-auto px-6 pb-12 scroll-mt-24">
    <div class="ornate-divider"><span class="text-[#c9a227]">✦</span></div>
    <h2 class="text-2xl font-bold font-[Cinzel] text-[#f4ead5] mb-6 flex items-center gap-3">
      <span class="w-8 h-px bg-[#c9a227]"></span> Combo & Season Passes
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {sleepyHollowTickets.comboTickets.filter(t => t.id !== 'fast-pass').map((ticket) => (
        <div class="content-card">
          <h3 class="text-xl font-bold text-[#f4ead5] mb-2">{ticket.name}</h3>
          <p class="text-3xl font-bold text-[#c9a227] mb-1">{ticket.price}{ticket.per && <span class="text-base font-normal text-[#f4ead5]/50 ml-1">{ticket.per}</span>}</p>
          {ticket.age && <p class="text-sm text-[#f4ead5]/50 mb-3">{ticket.age}</p>}
          <p class="text-[#f4ead5]/70 text-sm leading-relaxed">{ticket.description}</p>
        </div>
      ))}
    </div>
  </section>

  <section id="fast-pass" class="max-w-5xl mx-auto px-6 pb-20 scroll-mt-24">
    <h2 class="text-2xl font-bold font-[Cinzel] text-[#f4ead5] mb-6 flex items-center gap-3">
      <span class="w-8 h-px bg-[#c9a227]"></span> Fast Pass
    </h2>
    {sleepyHollowTickets.comboTickets.filter(t => t.id === 'fast-pass').map((ticket) => (
      <div class="content-card border-[#c9a227]/30">
        {ticket.warning && (
          <div class="mb-4 p-4 rounded-lg bg-[#c9a227]/10 border border-[#c9a227]/30 text-[#c9a227] text-sm font-medium">
            ⚠ {ticket.warning}
          </div>
        )}
        <h3 class="text-xl font-bold text-[#f4ead5] mb-2">{ticket.name}</h3>
        <p class="text-3xl font-bold text-[#c9a227] mb-3">{ticket.price}</p>
        <p class="text-[#f4ead5]/70 text-sm leading-relaxed">{ticket.description}</p>
      </div>
    ))}
    <div class="text-center mt-10">
      <a href={siteInfo.ticketsUrl} class="btn-primary-ipsh">Purchase Tickets</a>
    </div>
  </section>
</SleepyHollowLayout>
