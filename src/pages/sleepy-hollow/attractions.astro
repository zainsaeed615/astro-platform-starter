---
import SleepyHollowLayout from '../../layouts/SleepyHollowLayout.astro';
import { sleepyHollowAttractions } from '../../data/sleepy-hollow';

const iconPaths: Record<string, string> = {
  compass: 'M12 2L15.09 8.26L22 9.27L17 14.14L18.18 21.02L12 17.77L5.82 21.02L7 14.14L2 9.27L8.91 8.26L12 2Z',
  utensils: 'M3 2v7c0 1.1.9 2 2 2h4a2 2 0 002-2V2M7 2v20M21 15V2v0a5 5 0 00-5 5v6c0 1.1.9 2 2 2h3zM21 15v7',
  sparkles: 'M12 3l1.5 4.5L18 9l-4.5 1.5L12 15l-1.5-4.5L6 9l4.5-1.5L12 3z',
  tractor: 'M14 18V6a2 2 0 00-2-2H4a2 2 0 00-2 2v11M14 18H2M14 18h2a2 2 0 002-2v-3.65M22 18h-2M18 18V9a2 2 0 00-2-2h-1M6 18a2 2 0 100-4 2 2 0 000 4zM18 18a2 2 0 100-4 2 2 0 000 4z',
  'gamepad-2': 'M6 12h4M8 10v4M15 13h.01M18 11h.01M17 4h-2.5a2 2 0 00-1.6.8l-1.4 1.87A2 2 0 0010.5 8H7a4 4 0 00-4 4v1a4 4 0 004 4h10a4 4 0 004-4v-1a4 4 0 00-4-4h-1',
  eye: 'M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8zM12 15a3 3 0 100-6 3 3 0 000 6z',
  gem: 'M6 3h12l4 6-10 13L2 9l4-6zM11 3L8 9l4 13 4-13-3-6M2 9h20',
  palette: 'M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10c.926 0 1.648-.746 1.648-1.688 0-.437-.18-.835-.437-1.125-.29-.289-.438-.652-.438-1.125a1.64 1.64 0 011.668-1.668h1.996c3.051 0 5.555-2.503 5.555-5.554C21.965 6.012 17.461 2 12 2zM7 13a1 1 0 110-2 1 1 0 010 2zM10 9a1 1 0 110-2 1 1 0 010 2zM14 9a1 1 0 110-2 1 1 0 010 2zM17 13a1 1 0 110-2 1 1 0 010 2z',
};
---

<SleepyHollowLayout title="Attractions | Ichabod Payne's Sleepy Hollow">
  <section class="page-hero">
    <div class="max-w-4xl mx-auto px-6 text-center">
      <p class="section-label">Adventures Await</p>
      <h1 class="text-4xl md:text-5xl font-bold font-[Cinzel] text-[#f4ead5] mb-4">Attractions</h1>
      <p class="text-[#f4ead5]/60 max-w-2xl mx-auto">Family-friendly Halloween adventures designed for explorers of all ages.</p>
    </div>
  </section>

  <section class="max-w-5xl mx-auto px-6 pb-20 space-y-6">
    {sleepyHollowAttractions.map((attraction, i) => (
      <article class="content-card group">
        <div class="flex flex-col md:flex-row gap-6">
          <div class="shrink-0 w-14 h-14 rounded-xl bg-[#c9a227]/10 border border-[#c9a227]/30 flex items-center justify-center">
            <svg class="w-7 h-7 text-[#c9a227]" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5">
              <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[attraction.icon] || iconPaths.compass} />
            </svg>
          </div>
          <div class="flex-1">
            <div class="flex flex-wrap items-start justify-between gap-2 mb-2">
              <h2 class="text-2xl font-bold font-[Cinzel] text-[#f4ead5]">{attraction.name}</h2>
              {attraction.price && (
                <span class="text-sm font-semibold text-[#c9a227] bg-[#c9a227]/10 px-3 py-1 rounded-full">{attraction.price}</span>
              )}
            </div>
            <p class="text-[#c9a227] font-[Cormorant_Garamond] italic text-lg mb-3">{attraction.tagline}</p>
            <p class="text-[#f4ead5]/70 leading-relaxed">{attraction.description}</p>
          </div>
        </div>
      </article>
    ))}
  </section>
</SleepyHollowLayout>
