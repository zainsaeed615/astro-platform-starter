---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
import { siteConfig } from '../../data/site';
---

<Layout title="Contact" description="Contact Operation 17:2 — questions, support, and general inquiries.">
    <PageHero label="Contact" title="Get In Touch" description={`Based in ${siteConfig.location}. Our impact is global — reach out anytime.`} />

    <section class="section-container py-16 md:py-24">
        <div class="grid gap-12 lg:grid-cols-2">
            <form class="card-surface space-y-6 p-8" onsubmit="event.preventDefault(); alert('Contact form — connect to CRM/email at launch.');">
                <div>
                    <label class="mb-2 block text-xs uppercase tracking-wider text-white/60">Name *</label>
                    <input required type="text" class="w-full rounded-lg border border-white/10 bg-black/50 px-4 py-3 text-sm focus:border-brand-blue/50 focus:outline-none" />
                </div>
                <div>
                    <label class="mb-2 block text-xs uppercase tracking-wider text-white/60">Email *</label>
                    <input required type="email" class="w-full rounded-lg border border-white/10 bg-black/50 px-4 py-3 text-sm focus:border-brand-blue/50 focus:outline-none" />
                </div>
                <div>
                    <label class="mb-2 block text-xs uppercase tracking-wider text-white/60">Subject</label>
                    <select class="w-full rounded-lg border border-white/10 bg-black/50 px-4 py-3 text-sm focus:border-brand-blue/50 focus:outline-none">
                        <option>General Inquiry</option>
                        <option>Volunteer / Application</option>
                        <option>Donations</option>
                        <option>Shop / Orders</option>
                        <option>Media / Press</option>
                    </select>
                </div>
                <div>
                    <label class="mb-2 block text-xs uppercase tracking-wider text-white/60">Message *</label>
                    <textarea required rows="5" class="w-full rounded-lg border border-white/10 bg-black/50 px-4 py-3 text-sm focus:border-brand-blue/50 focus:outline-none"></textarea>
                </div>
                <button type="submit" class="btn-primary w-full">Send Message</button>
            </form>

            <div class="space-y-6">
                <div class="card-surface p-8">
                    <h3 class="font-display text-lg font-semibold uppercase text-brand-blue">Our Hub</h3>
                    <p class="mt-4 text-white/70">Located in {siteConfig.location}. Operation 17:2 is an online organization with global impact.</p>
                </div>
                <div class="card-surface p-8">
                    <h3 class="font-display text-lg font-semibold uppercase text-brand-blue">Donations</h3>
                    <p class="mt-4 text-white/70">
                        Venmo: {siteConfig.donations.venmo}<br />
                        PayPal: {siteConfig.donations.paypal}
                    </p>
                </div>
                <div class="card-surface p-8">
                    <h3 class="font-display text-lg font-semibold uppercase text-brand-blue">Follow Us</h3>
                    <a href="https://www.instagram.com/officialgarrettgross" target="_blank" rel="noopener noreferrer" class="mt-4 inline-block text-brand-blue no-underline hover:underline">
                        @officialgarrettgross on Instagram →
                    </a>
                </div>
            </div>
        </div>
    </section>
</Layout>
