---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/mindfulness/HeroSection.astro';
import SectionHeading from '../components/mindfulness/SectionHeading.astro';
import CollectionCard from '../components/mindfulness/CollectionCard.astro';
import BundleCard from '../components/mindfulness/BundleCard.astro';
import SubscriptionCard from '../components/mindfulness/SubscriptionCard.astro';
import ImpactSection from '../components/mindfulness/ImpactSection.astro';
import TestimonialSection from '../components/mindfulness/TestimonialSection.astro';
import CTABand from '../components/mindfulness/CTABand.astro';
import TrustBar from '../components/mindfulness/TrustBar.astro';
import IntentionStrip from '../components/mindfulness/IntentionStrip.astro';
import { images } from '../data/images';
import { pathTo } from '../utils/paths';

const intentions = [
    'Empower', 'Reboot', 'Rebound', 'Revive', 'Reclaim',
    'Recharge', 'Refocus', 'Rebuild', 'Reflect', 'Recommit',
];

const wellnessFragrances = ['Breathe Easy', 'Peace Within', 'Grounded Soul', 'Caregiver Reset'];

const partnerLinks = [
    { title: 'Healthcare', description: 'Flame-free wellness for patients, caregivers, and organizations.', href: '/healthcare', tag: 'B2B' },
    { title: 'Corporate Gifting', description: 'Meaningful appreciation gifts that create lasting impressions.', href: '/corporate', tag: 'Enterprise' },
    { title: 'Fundraising', description: 'Raise funds with purpose-driven wellness products.', href: '/fundraising', tag: 'Community' },
    { title: 'Wholesale', description: 'Bring purposeful wellness to your retail customers.', href: '/wholesale', tag: 'Retail' },
];
---

<Layout
    title="Home"
    description="Mindfulness Candle Collection — faith-centered candles, wellness essentials, and thoughtfully curated gifts designed to bring peace, reflection, and renewal."
>
    <!-- 1. Hero -->
    <HeroSection
        eyebrow="Mindfulness Candle Collection"
        title="Mindfulness Begins With a Single Flame"
        subtitle="Faith-centered candles, wellness essentials, and thoughtfully curated gifts designed to bring peace, reflection, and renewal into every season of life."
        image={images.home.hero}
        imageAlt="Premium Mindfulness candle creating a warm, peaceful atmosphere"
        align="center"
        minHeight="min-h-[92vh]"
    >
        <div slot="actions" class="flex flex-col items-center gap-6">
            <p class="text-cream/70 text-base sm:text-lg max-w-2xl leading-relaxed font-light text-center -mt-2 mb-2">
                More than products—meaningful experiences created to nurture the mind, restore the spirit, and encourage intentional self-care.
            </p>
            <div class="flex flex-wrap gap-4 justify-center">
                <a href="https://mindfulnesscandle.store/" target="_blank" rel="noopener noreferrer" class="btn btn-lg btn-gold">Shop the Collection</a>
                <a href="#bundles" class="btn btn-lg btn-outline text-cream border-cream/60 hover:bg-cream/10 hover:text-cream">Explore Wellness Bundles</a>
            </div>
        </div>
    </HeroSection>

    <TrustBar />
    <IntentionStrip />

    <!-- 2. Brand Introduction -->
    <section class="section-padding section-bg-premium">
        <div class="container-narrow">
            <div class="grid gap-16 lg:grid-cols-2 items-center">
                <div class="image-frame-offset aspect-[4/5] lg:aspect-auto lg:min-h-[620px]">
                    <img src={images.home.brand} alt="Mindfulness wellness ritual with candle, journal, and blanket" class="w-full h-full object-cover" loading="lazy" />
                </div>
                <div>
                    <SectionHeading
                        eyebrow="Our Story"
                        title="More Than a Candle. A Moment Created for You."
                    />
                    <div class="space-y-5 text-warm-gray leading-relaxed font-light">
                        <p>
                            Life can be demanding. Between professional responsibilities, caregiving, health challenges, grief, family obligations, and everyday uncertainty, we often forget to pause and care for ourselves.
                        </p>
                        <p>
                            <em class="text-charcoal font-serif text-lg not-italic">Mindfulness Candle Collection</em> creates faith-centered wellness experiences that invite you to slow down, breathe deeply, reflect intentionally, and reconnect with what matters most.
                        </p>
                        <p>
                            From our clean-burning soy candles and flame-free fragrance products to our journals, affirmation cards, comforting blankets, and curated wellness bundles, every item is designed to help transform ordinary moments into meaningful rituals of peace, prayer, restoration, and renewal.
                        </p>
                    </div>
                    <a href="https://mindfulnesscandle.store/pages/about" target="_blank" rel="noopener noreferrer" class="btn mt-10">Discover Mindfulness</a>
                </div>
            </div>
        </div>
    </section>

    <!-- 3. Product Collections -->
    <section id="collections" class="section-padding bg-cream">
        <div class="container-narrow">
            <SectionHeading
                eyebrow="Shop by Experience"
                title="Collections Designed for Every Season"
                description="Each collection represents an invitation to move forward with faith, clarity, resilience, and purpose."
                align="center"
            />
            <div class="grid gap-8 lg:grid-cols-3">
                <CollectionCard
                    title="The Signature Journey Collection"
                    subtitle="Ten Intentions"
                    description="Ten intentions. Ten stages of personal renewal. Each fragrance represents an invitation to move forward with faith, clarity, resilience, and purpose."
                    highlights={intentions}
                    ctaText="Shop the Signature Journey"
                    ctaHref="https://mindfulnesscandle.store/collections/signature-journey"
                    image={images.collections.signature}
                    imageAlt="Signature Journey candle collection"
                />
                <CollectionCard
                    title="The Wellness Collection"
                    subtitle="Room to Breathe"
                    description="Fragrances created for the moments when your mind, body, and spirit need room to breathe—designed to complement prayer, reflection, rest, and everyday self-care."
                    highlights={wellnessFragrances}
                    ctaText="Shop the Wellness Collection"
                    ctaHref="https://mindfulnesscandle.store/collections/wellness"
                    image={images.collections.wellness}
                    imageAlt="Wellness collection fragrances"
                />
                <CollectionCard
                    title="The Seasonal Collection"
                    subtitle="Life's Important Moments"
                    description="Meaningful fragrances and gifts for holidays, celebrations, encouragement, remembrance, and life's most important moments. Limited-edition collections help you give more than a gift."
                    highlights={['Holidays', 'Encouragement', 'Remembrance', 'Celebrations']}
                    ctaText="Explore Seasonal Collections"
                    ctaHref="https://mindfulnesscandle.store/collections/seasonal"
                    image={images.collections.seasonal}
                    imageAlt="Seasonal Mindfulness gift collections"
                />
            </div>
        </div>
    </section>

    <!-- 4. Bundles -->
    <section id="bundles" class="section-padding section-bg-stone">
        <div class="container-narrow">
            <SectionHeading
                eyebrow="Curated Wellness Experiences"
                title="Bundle, Save, and Give With Purpose"
                description="Every Mindfulness bundle is thoughtfully assembled to make self-care, gifting, and caregiving more meaningful."
                align="center"
            />
            <div class="grid gap-8 lg:grid-cols-3 lg:items-start">
                <BundleCard
                    name="The Refocus Bundle"
                    price="$75"
                    tagline="Return to what matters."
                    description="Create a continuous fragrance experience at home, at work, and while traveling. Designed for anyone seeking greater clarity, focus, and intentionality throughout the day."
                    includes={['One Signature Candle', 'One Reed Diffuser', 'One Vehicle Diffuser']}
                    ctaText="Shop the Refocus Bundle"
                    ctaHref={pathTo('/refocus-bundle')}
                    image={images.bundles.refocus}
                />
                <BundleCard
                    name="The Renew Bundle"
                    price="$110"
                    tagline="Refresh your surroundings."
                    description="An immersive sensory experience created to refresh your surroundings and renew your spirit. An ideal choice for personal renewal, celebrations, encouragement, or thoughtful gifting."
                    includes={['Two Signature Candles', 'One Reed Diffuser', 'One Vehicle Diffuser']}
                    ctaText="Shop the Renew Bundle"
                    ctaHref="https://mindfulnesscandle.store/"
                    featured={true}
                    image={images.bundles.renew}
                />
                <BundleCard
                    name="The Caregiver Wellness Bundle"
                    price="$165"
                    tagline="Crafted for those who give."
                    description="A meaningful expression of appreciation, encouragement, comfort, and restoration for family caregivers and professional care partners."
                    includes={[
                        'Two Signature Candles',
                        'One Reed Diffuser',
                        'One Vehicle Diffuser',
                        'One Mindfulness Journal',
                        'One Comfort Blanket',
                        'One Set of 180 Days of Hope™ Affirmation Cards',
                    ]}
                    ctaText="Shop the Caregiver Wellness Bundle"
                    ctaHref="https://mindfulnesscandle.store/"
                    image={images.bundles.caregiver}
                />
            </div>
        </div>
    </section>

    <!-- 5 & 6. Subscriptions -->
    <section id="membership" class="section-padding section-bg-premium">
        <div class="container-narrow">
            <div class="grid gap-12 lg:grid-cols-2 items-center mb-16 max-w-6xl mx-auto">
                <div class="image-frame aspect-[4/3] lg:aspect-auto lg:min-h-[420px] order-2 lg:order-1">
                    <img src={images.membership.hero} alt="Mindfulness Monthly membership unboxing" class="w-full h-full object-cover" loading="lazy" />
                </div>
                <div class="order-1 lg:order-2 text-center lg:text-left">
                    <SectionHeading
                        eyebrow="Mindfulness Membership"
                        title="Make Self-Care a Standing Commitment"
                        description="More than a monthly delivery—it is a recurring reminder that your well-being deserves time, attention, and intention."
                    />
                </div>
            </div>
            <div class="grid gap-8 lg:grid-cols-2 lg:items-start max-w-5xl mx-auto">
                <SubscriptionCard
                    name="Mindfulness Monthly"
                    price="$59 per month"
                    tagline="Make self-care a standing commitment."
                    description="Mindfulness Monthly brings an intentional wellness experience directly to your door each month. Every delivery is designed to help you pause, reset, and create space for reflection, gratitude, prayer, and renewal."
                    benefits={[
                        'One rotating Signature Candle',
                        'Monthly affirmations',
                        'Exclusive wellness content',
                        'Member-only product discounts',
                        'Early access to select collections and experiences',
                    ]}
                    disclaimer="Subscription automatically renews monthly until canceled in accordance with our Subscription and Cancellation Policy."
                    ctaText="Begin Your Membership"
                    ctaHref={pathTo('/membership')}
                />
                <SubscriptionCard
                    name="Premium Mindfulness Monthly"
                    price="$79 per month"
                    tagline="An elevated monthly wellness experience."
                    description="Premium Mindfulness Monthly surrounds you with intentional fragrance, reflection, and renewal—wherever life takes you. Created for individuals who want to make mindfulness, faith, and intentional self-care part of their everyday lifestyle."
                    benefits={[
                        'One rotating Signature Candle each month',
                        'One Vehicle Diffuser each month',
                        'Exclusive guided journal content',
                        'Monthly affirmations and wellness resources',
                        'One Reed Diffuser every quarter',
                        'Premium member discounts',
                        'Early access to new and limited-edition collections',
                    ]}
                    disclaimer="Subscription automatically renews monthly until canceled in accordance with our Subscription and Cancellation Policy."
                    ctaText="Choose Premium Mindfulness"
                    ctaHref={pathTo('/membership')}
                    featured={true}
                    image={images.membership.sanctuary}
                />
            </div>
        </div>
    </section>

    <!-- Partner Programs -->
    <section class="section-padding bg-cream">
        <div class="container-narrow">
            <SectionHeading
                eyebrow="Beyond the Store"
                title="Wellness Experiences for Organizations & Communities"
                align="center"
            />
            <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
                {partnerLinks.map((link) => (
                    <a href={pathTo(link.href)} class="card-luxe p-9 no-underline group text-center">
                        <span class="inline-block px-4 py-1.5 text-[0.5625rem] uppercase tracking-[0.22em] bg-gradient-to-r from-sage-dark/10 to-gold/10 text-sage-dark rounded-full mb-5 font-semibold ring-1 ring-gold/15">{link.tag}</span>
                        <h3 class="text-charcoal mb-3 group-hover:text-sage-dark transition-colors duration-500">{link.title}</h3>
                        <p class="text-warm-gray text-sm leading-relaxed font-light">{link.description}</p>
                    </a>
                ))}
            </div>
        </div>
    </section>

    <!-- 11. Impact -->
    <ImpactSection />

    <!-- 12. Testimonials -->
    <TestimonialSection />

    <!-- Final CTA -->
    <CTABand title="Begin Your Mindfulness Journey" subtitle="Faith-centered wellness experiences designed to bring peace, reflection, and renewal into every season of life.">
        <a href="https://mindfulnesscandle.store/" target="_blank" rel="noopener noreferrer" class="btn btn-lg btn-gold">Shop the Collection</a>
        <a href={pathTo('/contact')} class="btn btn-lg btn-outline text-cream border-cream/60 hover:bg-cream/10 hover:text-cream">Partner With Us</a>
    </CTABand>
</Layout>
