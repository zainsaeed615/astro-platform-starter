---
import Layout from '../layouts/Layout.astro';
import { site, stats, coreServices, processSteps, opportunities, developments, testimonials, faqs } from '../content/vidian';
---

<Layout title={site.title} description={site.description}>
    <section class="relative isolate min-h-screen overflow-hidden bg-luxury pt-32 text-white">
        <video class="absolute inset-0 -z-20 h-full w-full object-cover opacity-45" src="/images/vidian/hero-video.mp4" autoplay muted loop playsinline preload="metadata" poster="/images/vidian/london-skyline.png"></video>
        <div class="absolute inset-0 -z-10 bg-gradient-to-r from-[#0e1824] via-[#0e1824]/85 to-[#0e1824]/35"></div>
        <div class="section-shell grid min-h-[calc(100vh-8rem)] items-center gap-12 py-16 lg:grid-cols-[1.05fr_0.95fr]">
            <div class="reveal">
                <p class="eyebrow">{site.tagline}</p>
                <h1 class="max-w-5xl text-balance">Build Your Wealth Through Strategic Property Investment</h1>
                <p class="mt-7 max-w-2xl text-xl leading-9 text-white/75">{site.description}</p>
                <div class="mt-10 flex flex-col gap-4 sm:flex-row">
                    <a class="btn btn-gold btn-lg" href="/contact-us">Book Your Strategy Call</a>
                    <a class="btn btn-outline btn-lg" href="/how-it-works">Our Process</a>
                </div>
            </div>
            <div class="reveal grid gap-5 sm:grid-cols-2">
                {stats.map((item) => <div class="dark-card"><p class="font-display text-5xl text-gold">{item.value}</p><p class="mt-4 text-xs font-semibold uppercase tracking-[0.22em] text-white/60">{item.label}</p></div>)}
            </div>
        </div>
    </section>

    <section class="bg-[#0e1824] py-8 text-white">
        <div class="section-shell grid gap-4 md:grid-cols-4">
            {stats.map((item) => <div class="border border-white/10 bg-white/[0.04] p-6"><strong class="font-display text-4xl text-gold">{item.value}</strong><span class="mt-2 block text-xs uppercase tracking-[0.2em] text-white/55">{item.label}</span></div>)}
        </div>
    </section>

    <section class="py-24 sm:py-32">
        <div class="section-shell grid items-center gap-14 lg:grid-cols-[0.95fr_1.05fr]">
            <div class="reveal">
                <img src="/images/vidian/brand-logo.png" alt="Vidian Capital office logo" class="aspect-[4/3] w-full object-cover shadow-2xl shadow-slate-950/15" />
            </div>
            <div class="reveal">
                <p class="eyebrow">About Us</p>
                <h2>A Smarter Approach to Property Investment</h2>
                <p class="mt-6 text-lg leading-9">With years of hands-on experience in property investment, our visionary team at VIDIAN CAPITAL has created a new approach to building wealth through real estate. We do not just sell properties, we craft investment opportunities that are Strategic. Secure. Scalable.</p>
                <div class="mt-8 grid gap-4 sm:grid-cols-3">
                    <div class="premium-card"><strong class="font-display text-4xl text-primary">20+</strong><span class="mt-2 block text-xs uppercase tracking-[0.2em]">Years Combined Experience</span></div>
                    <div class="premium-card"><strong class="font-display text-4xl text-primary">50+</strong><span class="mt-2 block text-xs uppercase tracking-[0.2em]">Live Developments</span></div>
                    <div class="premium-card"><strong class="font-display text-4xl text-primary">&pound;350M</strong><span class="mt-2 block text-xs uppercase tracking-[0.2em]">Transactions Supported</span></div>
                </div>
            </div>
        </div>
    </section>

    <section class="bg-white py-24 sm:py-32">
        <div class="section-shell">
            <div class="reveal max-w-4xl">
                <p class="eyebrow">Featured Developments</p>
                <h2>Discover Exceptional High-Growth Investments</h2>
            </div>
            <div class="mt-12 grid gap-6 md:grid-cols-3">
                {developments.slice(0, 3).map((item) => (
                    <article class="premium-card group overflow-hidden p-0">
                        <img src={item.image} alt="" class="h-72 w-full object-cover transition duration-500 group-hover:scale-105" />
                        <div class="p-7">
                            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">{item.country} - {item.location}</p>
                            <h3 class="mt-4">{item.title}</h3>
                            <p class="mt-4 font-semibold text-ink">{item.price} · {item.yield}</p>
                            <a href="/developments" class="mt-6 inline-flex text-sm font-bold uppercase tracking-[0.08em] text-primary">View Developments</a>
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section class="py-24 sm:py-32">
        <div class="section-shell">
            <div class="reveal max-w-4xl">
                <p class="eyebrow">Curated Portfolio</p>
                <h2>Discover Our Selection of Featured Rental Properties</h2>
            </div>
            <div class="mt-12 grid gap-7 lg:grid-cols-2">
                {opportunities.map((item) => (
                    <article class="premium-card overflow-hidden p-0">
                        <img src={item.image} alt="" class="h-80 w-full object-cover" />
                        <div class="p-8">
                            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-gold">{item.location}</p>
                            <h3 class="mt-4 text-4xl">{item.title}</h3>
                            <p class="mt-5 text-lg leading-8">{item.text}</p>
                            <div class="mt-6 flex flex-wrap gap-2">{item.tags.map((tag) => <span class="bg-cream px-4 py-2 text-xs font-bold uppercase tracking-[0.08em] text-primary">{tag}</span>)}</div>
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section class="bg-white py-24 sm:py-32">
        <div class="section-shell">
            <div class="reveal max-w-4xl">
                <p class="eyebrow">Our Services</p>
                <h2>What We Do?</h2>
                <p class="mt-5 text-lg leading-8">Strategic property investment solutions across the UK and Dubai, designed to grow and protect your wealth.</p>
            </div>
            <div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
                {coreServices.map((service) => <a href={`/services/${service.slug}`} class="premium-card"><h3>{service.title}</h3><p class="mt-4 leading-7">{service.summary}</p></a>)}
            </div>
            <a href="/contact-us" class="btn btn-gold mt-10">Book Your Strategy Call</a>
        </div>
    </section>

    <section class="bg-luxury py-24 text-white sm:py-32">
        <div class="section-shell grid gap-14 lg:grid-cols-[0.9fr_1.1fr]">
            <div class="reveal">
                <p class="eyebrow">Why Investors Choose Vidian Capital</p>
                <h2 class="text-white">Every Recommendation Is Backed By Strategy</h2>
                <p class="mt-6 text-lg leading-9 text-white/70">Every recommendation is backed by data-driven research, market insight, and a clear investment strategy designed to support your long-term financial goals.</p>
            </div>
            <div class="grid gap-5 sm:grid-cols-2">
                {['Strategy Led', 'End To End Support', 'Market Specialists', 'Trusted Expertise'].map((item) => <div class="dark-card"><span class="font-accent text-5xl italic text-gold">0{['Strategy Led', 'End To End Support', 'Market Specialists', 'Trusted Expertise'].indexOf(item) + 1}</span><h3 class="mt-6 text-white">{item}</h3></div>)}
            </div>
        </div>
    </section>

    <section class="py-24 sm:py-32">
        <div class="section-shell">
            <div class="reveal max-w-4xl">
                <p class="eyebrow">Our Process</p>
                <h2>The Vidian Capital Proven 6 Step Investment Framework</h2>
                <p class="mt-5 text-lg leading-8">A structured, disciplined approach designed to take you from initial strategy to long-term portfolio growth.</p>
            </div>
            <div class="mt-12 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
                {processSteps.map((step) => <article class="premium-card"><span class="font-accent text-6xl italic text-gold">{step.number}</span><h3 class="mt-6">{step.title}</h3><p class="mt-4 leading-7">{step.text}</p></article>)}
            </div>
        </div>
    </section>

    <section class="bg-luxury py-24 text-white sm:py-32">
        <div class="section-shell">
            <div class="reveal grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
                <div>
                    <p class="eyebrow">Testimonials</p>
                    <h2 class="text-white">Building Investor Success Through Trusted Partnerships</h2>
                    <p class="mt-6 leading-8 text-white/70">For years, Vidian Capital has helped investors confidently navigate the property market, providing expert guidance, exclusive opportunities, and tailored investment strategies.</p>
                    <a href="/contact-us" class="btn btn-gold mt-8">Book Your Strategy Call</a>
                </div>
                <div id="testimonial-slider" class="testimonial-track flex snap-x gap-5 overflow-x-auto scroll-smooth pb-4">
                    {testimonials.map((item) => <figure class="dark-card min-w-[85%] snap-start sm:min-w-[28rem]"><blockquote class="text-xl leading-9">"{item.quote}"</blockquote><figcaption class="mt-8 text-gold">{item.name}<br /><span class="text-white/55">{item.location}</span></figcaption></figure>)}
                </div>
            </div>
        </div>
    </section>

    <section class="py-24 sm:py-32">
        <div class="section-shell grid gap-12 lg:grid-cols-[0.8fr_1.2fr]">
            <div class="reveal">
                <p class="eyebrow">Frequently Asked Questions</p>
                <h2>Answers to Common Property Investment Questions</h2>
                <p class="mt-5 text-lg leading-8">Explore answers to common questions about property investment, portfolio management, opportunities, and services.</p>
                <a href="/how-it-works" class="btn mt-8">Our Process</a>
            </div>
            <div class="space-y-4">
                {faqs.map((item) => <details class="faq-item premium-card"><summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-lg font-bold text-ink">{item.question}<span class="text-gold">+</span></summary><p class="mt-4 leading-8">{item.answer}</p></details>)}
            </div>
        </div>
    </section>

    <section class="bg-white py-24 sm:py-32">
        <div class="section-shell grid gap-12 lg:grid-cols-[0.85fr_1.15fr]">
            <div class="reveal">
                <p class="eyebrow">Our Services</p>
                <h2>Let's Discuss Your Investment Goals Today</h2>
                <p class="mt-5 text-lg leading-8">Whether you are ready to invest, exploring your options, or simply have a few questions, our experienced team is here to provide expert guidance and support.</p>
                <div class="mt-8 space-y-5">
                    <p><strong class="text-ink">Phone</strong><br />{site.phone}</p>
                    <p><strong class="text-ink">Email</strong><br />{site.email}</p>
                    <p><strong class="text-ink">London Office</strong><br />{site.address}</p>
                </div>
            </div>
            <form name="home-inquiry" method="POST" data-netlify="true" class="premium-card reveal grid gap-5">
                <input type="hidden" name="form-name" value="home-inquiry" />
                <h3>Send Us Inquiry</h3>
                <div class="grid gap-5 sm:grid-cols-2">
                    <input class="field" name="first-name" placeholder="First Name" required />
                    <input class="field" name="last-name" placeholder="Last Name" required />
                </div>
                <input class="field" type="email" name="email" placeholder="Email" required />
                <input class="field" name="phone" placeholder="Phone Number" required />
                <textarea class="field min-h-36" name="message" placeholder="Message" required></textarea>
                <button class="btn btn-gold justify-self-start" type="submit">Send Message</button>
            </form>
        </div>
    </section>
</Layout>
