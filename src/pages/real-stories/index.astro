---
import BeautyGuidesLayout from '../../layouts/BeautyGuidesLayout.astro';
import PageHero from '../../components/beauty-guides/PageHero.astro';
import { realStories } from '../../data/beauty-guides';
---

<BeautyGuidesLayout title="Real Stories" description="Real women sharing their cosmetic surgery journeys in Vietnam.">
    <PageHero
        eyebrow="Real Stories"
        title="Real women. Real stories. Real inspiration."
        subtitle="Individual lived experiences — not endorsements, referrals or guarantees of outcomes."
        image="/beauty-guides/home-pages.png"
    />

    <section class="mx-auto max-w-7xl px-4 py-16 md:px-6">
        <div class="grid gap-8 md:grid-cols-2">
            {
                realStories.map((story) => (
                    <a href={`/real-stories/${story.slug}`} class="card-tbg flex flex-col overflow-hidden no-underline md:flex-row">
                        <img src={story.image} alt={story.displayName} class="h-64 w-full object-cover object-top md:h-auto md:w-2/5" loading="lazy" />
                        <div class="flex flex-1 flex-col p-6">
                            <h2 class="font-serif text-2xl">{story.name}</h2>
                            <p class="mt-1 text-xs uppercase tracking-wider text-[var(--color-taupe)]">{story.summary} · {story.destination}</p>
                            <p class="prose-tbg mt-4 flex-1">{story.excerpt}</p>
                            <span class="mt-4 text-sm font-semibold uppercase text-[var(--color-taupe)]">Read full story →</span>
                        </div>
                    </a>
                ))
            }
        </div>
    </section>
</BeautyGuidesLayout>
