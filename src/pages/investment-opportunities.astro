---
import Layout from '../layouts/Layout.astro';
import { site, opportunities, developments } from '../content/vidian';
---

<Layout title={`Investment Opportunities | ${site.name}`} description="Explore Vidian Capital UK and Dubai property investment opportunities." noHeaderOverlay>
    <section class="bg-luxury pt-36 pb-20 text-white sm:pb-28">
        <div class="section-shell max-w-5xl">
            <p class="eyebrow">Curated Portfolio</p>
            <h1>Investment Opportunities</h1>
            <p class="mt-6 max-w-3xl text-lg leading-8 text-white/72">
                Hand-picked developments across the UK and Dubai, rigorously vetted for yield, growth, and security.
            </p>
        </div>
    </section>

    <section class="py-20 sm:py-28">
        <div class="section-shell grid gap-6 lg:grid-cols-2">
            {opportunities.map((item) => (
                <article class="premium-card reveal overflow-hidden p-0">
                    <img src={item.image} alt="" class="h-80 w-full object-cover" />
                    <div class="p-8">
                        <p class="text-sm font-bold uppercase tracking-[0.22em] text-gold">{item.location}</p>
                        <h2 class="mt-3 text-4xl">{item.title}</h2>
                        <div class="mt-5 flex flex-wrap gap-2">{item.tags.map((tag) => <span class="rounded-full bg-blue-50 px-3 py-1 text-xs font-bold text-primary">{tag}</span>)}</div>
                        <p class="mt-5 text-lg leading-8 text-slate-600">{item.text}</p>
                        <a href="/contact-us" class="btn mt-8">View Developments</a>
                    </div>
                </article>
            ))}
        </div>
    </section>

    <section class="bg-slate-50 py-20 sm:py-28">
        <div class="section-shell">
            <div class="reveal flex flex-col justify-between gap-6 md:flex-row md:items-end">
                <div>
                    <p class="eyebrow">Live Listings</p>
                    <h2>Featured Developments</h2>
                    <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">A selection of current opportunities available through Vidian Capital - explore floorplans, yields, and investment terms with the team.</p>
                </div>
                <a href="/contact-us" class="btn">Request Details</a>
            </div>
            <div class="mt-12 grid gap-6 md:grid-cols-3">
                {developments.map((item) => (
                    <article class="premium-card reveal p-0">
                        <img src={item.image} alt="" class="h-56 w-full rounded-t-[2rem] object-cover" />
                        <div class="p-6">
                            <p class="text-xs font-bold uppercase tracking-[0.2em] text-gold">{item.location}</p>
                            <h3 class="mt-3">{item.title}</h3>
                            <p class="mt-3 text-sm leading-7 text-slate-600">{item.text}</p>
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </section>
</Layout>
