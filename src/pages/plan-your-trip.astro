---
import BeautyGuidesLayout from '../layouts/BeautyGuidesLayout.astro';
import PageHero from '../components/beauty-guides/PageHero.astro';
import GuideCard from '../components/beauty-guides/GuideCard.astro';
import SectionHeader from '../components/beauty-guides/SectionHeader.astro';
import { pageHeroes, guideTopics } from '../data/beauty-guides';

const hero = pageHeroes['plan-your-trip'];
const planningGuides = guideTopics.filter((g) => g.number >= 5);
---

<BeautyGuidesLayout title="Plan Your Trip" description="Practical planning guidance for cosmetic surgery travel to Vietnam.">
    <PageHero {...hero} />

    <section class="section-inner py-16 md:py-20">
        <div class="mx-auto max-w-3xl prose-tbg text-lg">
            <p>Planning a surgery trip overseas involves far more than booking a flight. These guides cover the timeline, packing, apps, accommodation and recovery logistics I navigated during my own journey.</p>
        </div>
    </section>

    <!-- Featured: Travelling Alone -->
    <section class="section-breakout relative w-full overflow-hidden border-y border-[var(--color-peach)]/50 bg-[var(--color-charcoal)] py-16 text-white md:py-20">
        <img src="/beauty-guides/travelling-alone/travel-hero.png" alt="" class="absolute inset-0 h-full w-full object-cover opacity-30" loading="lazy" />
        <div class="section-inner relative grid items-center gap-10 lg:grid-cols-2">
            <div>
                <p class="section-eyebrow mb-3 !text-[var(--color-peach-light)]">Section 5.3</p>
                <h2 class="section-title !text-white">Travelling alone</h2>
                <p class="story-body mt-4 max-w-xl !text-white/85">
                    One of the biggest questions is whether you can travel alone. I did — and between Grab, delivery apps, hospital support and sensible accommodation, it was far easier than I'd imagined.
                </p>
                <a href="/travelling-alone" class="btn-tbg-primary mt-8 inline-flex">Read the full guide →</a>
            </div>
            <div class="overflow-hidden rounded-3xl shadow-2xl">
                <img src="/beauty-guides/travelling-alone/travel-phone.png" alt="Essential apps for solo travel" class="aspect-[4/3] w-full object-cover" loading="lazy" />
            </div>
        </div>
    </section>

    <section class="bg-[var(--color-cream)] py-20 md:py-28">
        <div class="section-inner">
            <SectionHeader centered title="Planning guides" subtitle="From booking your timeline to flying home — every practical detail." />
            <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
                {planningGuides.map((guide) => <GuideCard {...guide} />)}
            </div>
        </div>
    </section>
</BeautyGuidesLayout>
