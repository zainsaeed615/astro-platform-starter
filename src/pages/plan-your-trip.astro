---
import BeautyGuidesLayout from '../layouts/BeautyGuidesLayout.astro';
import PageHero from '../components/beauty-guides/PageHero.astro';
import GuideCard from '../components/beauty-guides/GuideCard.astro';
import SectionHeader from '../components/beauty-guides/SectionHeader.astro';
import { pageHeroes, guideTopics } from '../data/beauty-guides';

const hero = pageHeroes['plan-your-trip'];
const planningGuides = guideTopics.filter((g) => g.number >= 5);
---

<BeautyGuidesLayout title="Plan Your Trip" description="Practical planning guidance for cosmetic surgery travel to Vietnam.">
    <PageHero {...hero} />

    <section class="section-inner py-16 md:py-20">
        <div class="mx-auto max-w-3xl prose-tbg text-lg">
            <p>Planning a surgery trip overseas involves far more than booking a flight. These guides cover the timeline, packing, apps, accommodation and recovery logistics I navigated during my own journey.</p>
        </div>
    </section>

    <section class="bg-[var(--color-cream)] py-20 md:py-28">
        <div class="section-inner">
            <SectionHeader centered title="Planning guides" subtitle="From booking your timeline to flying home — every practical detail." />
            <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
                {planningGuides.map((guide) => <GuideCard {...guide} />)}
            </div>
        </div>
    </section>
</BeautyGuidesLayout>
