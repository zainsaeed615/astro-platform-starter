---
import BeautyGuidesLayout from '../layouts/BeautyGuidesLayout.astro';
import PageHero from '../components/beauty-guides/PageHero.astro';
import { procedures, site } from '../data/beauty-guides';
---

<BeautyGuidesLayout title="My Story" description="Kirsty Strowger's personal cosmetic surgery journey in Vietnam.">
    <PageHero
        eyebrow="My Story"
        title="Nine days that changed my life."
        subtitle="What began as one planned procedure became a journey I never expected — and one I would still choose again."
        image="/beauty-guides/home.png"
        size="large"
    />

    <section class="mx-auto max-w-3xl px-4 py-16 md:px-6 md:py-24">
        <div class="prose-tbg">
            <p>
                I travelled to Vietnam alone. I had researched for months, but nothing fully prepared me for the reality of consultations, hospital stays, recovery in another country and the emotional side of returning home changed.
            </p>
            <p>
                This site is not here to tell you what decision to make. It's here so you can learn from someone who has already lived through the decision you're considering.
            </p>
        </div>
    </section>

    <section id="journey" class="bg-[var(--color-white-soft)] py-16">
        <div class="mx-auto max-w-5xl px-4 md:px-6">
            <p class="section-eyebrow mb-3 text-center">The journey</p>
            <h2 class="section-title mb-8 text-center">What happened in nine days</h2>
            <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
                {procedures.map((p, i) => (
                    <div class="rounded-xl border border-[var(--color-peach)] bg-[var(--color-cream)] px-4 py-3 text-sm">
                        <span class="font-semibold text-[var(--color-taupe)]">{i + 1}.</span> {p}
                    </div>
                ))}
            </div>
            <p class="script-note mt-8 text-center">And yes… knowing what I know now, I would still do it again.</p>
            <p class="mt-4 text-center text-xs text-[var(--color-muted)]">Procedure names pending Kirsty's final approval.</p>
        </div>
    </section>

    <section class="mx-auto max-w-3xl px-4 py-16 md:px-6">
        <div class="prose-tbg space-y-6">
            <h2 class="font-serif text-2xl">Why I'm sharing this</h2>
            <p>
                I made mistakes. I asked awkward questions. I discovered things no brochure explained. The Complete Vietnam Surgery Companion is everything I wish someone had told me before I got on the plane.
            </p>
            <div class="flex flex-wrap gap-3 pt-4">
                <a href="/complete-guide" class="btn-tbg-primary">Explore the Complete Guide</a>
                <a href={site.messengerUrl} target="_blank" rel="noopener" class="btn-tbg-outline">Message Me</a>
            </div>
        </div>
    </section>
</BeautyGuidesLayout>
