---
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/mindfulness/HeroSection.astro';
import SectionHeading from '../components/mindfulness/SectionHeading.astro';
import SubscriptionCard from '../components/mindfulness/SubscriptionCard.astro';
import QuoteBlock from '../components/mindfulness/QuoteBlock.astro';
import CTABand from '../components/mindfulness/CTABand.astro';
import InquiryForm from '../components/mindfulness/InquiryForm.astro';
import { images } from '../data/images';
import { pathTo } from '../utils/paths';
---

<Layout
    title="Mindfulness Membership"
    description="Mindfulness Monthly and Premium Mindfulness Monthly — recurring wellness experiences designed to make self-care a standing commitment."
>
    <HeroSection
        eyebrow="Mindfulness Membership"
        title="Make Self-Care a Standing Commitment"
        subtitle="Mindfulness Monthly brings an intentional wellness experience directly to your door each month—designed to help you pause, reset, and create space for reflection, gratitude, prayer, and renewal."
        image={images.membership.hero}
        imageAlt="Upscale home sanctuary with candle, diffuser, journal, and blanket"
        align="center"
    >
        <div slot="actions" class="flex flex-wrap gap-4 justify-center">
            <a href="#plans" class="btn btn-lg btn-gold">Begin Your Membership</a>
            <a href={pathTo('/policies/subscription')} class="btn btn-lg btn-outline text-cream border-cream/60 hover:bg-cream/10 hover:text-cream">Subscription Policy</a>
        </div>
    </HeroSection>

    <section class="section-padding bg-cream">
        <div class="container-narrow max-w-3xl mx-auto text-center">
            <p class="lead mb-8">
                This is more than a monthly delivery. It is a recurring reminder that your well-being deserves time, attention, and intention.
            </p>
            <div class="divider-gold"></div>
            <p class="text-warm-gray leading-relaxed font-light">
                Whether you are beginning your wellness journey, caring for someone you love, navigating a demanding season of life, or simply creating more peaceful moments in your everyday routine, Mindfulness Membership is designed to meet you where you are.
            </p>
        </div>
    </section>

    <section id="plans" class="section-padding section-bg-stone">
        <div class="container-narrow">
            <SectionHeading
                eyebrow="Choose Your Experience"
                title="Two Paths to Intentional Living"
                description="Select the membership experience that best supports your wellness rhythm and lifestyle."
                align="center"
            />
            <div class="grid gap-8 lg:grid-cols-2 lg:items-start max-w-5xl mx-auto">
                <SubscriptionCard
                    name="Mindfulness Monthly Membership"
                    price="$59 per month"
                    tagline="Make self-care a standing commitment."
                    description="Every delivery is designed to help you pause, reset, and create space for reflection, gratitude, prayer, and renewal."
                    benefits={[
                        'One rotating Signature Candle',
                        'Monthly affirmations',
                        'Exclusive wellness content',
                        'Member-only product discounts',
                        'Early access to select collections and experiences',
                    ]}
                    disclaimer="Subscription automatically renews monthly until canceled in accordance with our Subscription and Cancellation Policy."
                    ctaText="Begin Your Membership"
                    ctaHref="https://mindfulnesscandle.store/"
                />
                <SubscriptionCard
                    name="Premium Mindfulness Membership"
                    price="$79 per month"
                    tagline="An elevated monthly wellness experience."
                    description="Created for individuals who want to make mindfulness, faith, and intentional self-care part of their everyday lifestyle—wherever life takes you."
                    benefits={[
                        'One rotating Signature Candle each month',
                        'One Vehicle Diffuser each month',
                        'Exclusive guided journal content',
                        'Monthly affirmations and wellness resources',
                        'One Reed Diffuser every quarter',
                        'Premium member discounts',
                        'Early access to new and limited-edition collections',
                    ]}
                    disclaimer="Subscription automatically renews monthly until canceled in accordance with our Subscription and Cancellation Policy."
                    ctaText="Choose Premium Mindfulness"
                    ctaHref="https://mindfulnesscandle.store/"
                    featured={true}
                />
            </div>
        </div>
    </section>

    <section class="section-padding bg-cream">
        <div class="container-narrow">
            <QuoteBlock
                quote="Membership is about more than receiving products. It's about creating rituals that remind you to slow down, breathe, reflect, restore, and live intentionally."
            />
        </div>
    </section>

    <CTABand title="Your Well-Being Deserves Intention" subtitle="Join a community that makes wellness a way of life.">
        <a href="https://mindfulnesscandle.store/" target="_blank" rel="noopener noreferrer" class="btn btn-lg btn-gold">Begin Your Membership</a>
        <a href={pathTo('/healthcare')} class="btn btn-lg btn-outline text-cream border-cream/60 hover:bg-cream/10 hover:text-cream">Explore Healthcare Wellness</a>
    </CTABand>

    <InquiryForm showIntro={false} />
</Layout>
