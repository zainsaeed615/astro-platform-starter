---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Checkout" description="Complete your Operation 17:2 purchase.">
    <section class="section-container py-20">
        <div class="mx-auto max-w-lg text-center">
            <div class="card-surface p-10">
                <img src="/logo.png" alt="" class="mx-auto h-20 w-20 rounded-full opacity-60" />
                <h1 class="mt-6 text-2xl font-bold">Checkout Preview</h1>
                <p class="mt-4 text-white/60">
                    This draft connects to Shopify checkout at launch. Your cart items are saved locally — full payment processing via Shopify Payments + Printful fulfillment.
                </p>
                <a href="/shop" class="btn-primary mt-8 inline-flex no-underline">Continue Shopping</a>
            </div>
        </div>
    </section>
</Layout>
