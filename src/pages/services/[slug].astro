---
import Layout from '../../layouts/Layout.astro';
import { allServices, site, processSteps } from '../../content/vidian';

export function getStaticPaths() {
    return allServices.map((service) => ({
        params: { slug: service.slug },
        props: { service }
    }));
}

const { service } = Astro.props;
---

<Layout title={`${service.title} | ${site.name}`} description={service.summary} noHeaderOverlay>
    <section class="bg-luxury pt-36 pb-20 text-white sm:pb-28">
        <div class="section-shell grid items-center gap-12 lg:grid-cols-[1fr_0.9fr]">
            <div class="reveal">
                <p class="eyebrow">Vidian Capital Services</p>
                <h1>{service.title}</h1>
                <p class="mt-6 max-w-3xl text-lg leading-8 text-white/72">{service.description}</p>
                <div class="mt-9 flex flex-col gap-4 sm:flex-row">
                    <a href="/contact-us" class="btn btn-gold">Discuss Your Portfolio</a>
                    <a href="/services" class="btn btn-outline">View All Services</a>
                </div>
            </div>
            <div class="reveal dark-card">
                <p class="text-sm font-bold uppercase tracking-[0.22em] text-gold">Strategic. Secure. Scalable.</p>
                <ul class="mt-6 space-y-4">
                    {service.bullets.map((item) => <li class="rounded-2xl bg-white/[0.06] p-4 text-white/75">{item}</li>)}
                </ul>
            </div>
        </div>
    </section>

    <section class="py-20 sm:py-28">
        <div class="section-shell grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
            <div class="reveal">
                {service.image ? <img src={service.image} alt="" class="aspect-[4/3] rounded-[2rem] object-cover shadow-2xl shadow-slate-950/15" /> : <img src="/images/vidian/investment-meeting.png" alt="" class="aspect-[4/3] rounded-[2rem] object-cover shadow-2xl shadow-slate-950/15" />}
            </div>
            <div class="reveal">
                <p class="eyebrow">Service Overview</p>
                <h2>Designed around investor objectives, capital, and long-term priorities.</h2>
                <p class="mt-6 text-lg leading-8 text-slate-600">{service.description}</p>
                <div class="mt-8 grid gap-4 sm:grid-cols-2">
                    {service.bullets.map((item) => <div class="rounded-3xl border border-slate-200 bg-white p-5 shadow-lg shadow-slate-950/5"><p class="font-semibold text-slate-950">{item}</p></div>)}
                </div>
            </div>
        </div>
    </section>

    <section class="bg-slate-50 py-20 sm:py-28">
        <div class="section-shell">
            <div class="reveal max-w-3xl">
                <p class="eyebrow">How It Works</p>
                <h2>A structured path from strategy to portfolio evolution.</h2>
            </div>
            <div class="mt-12 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
                {processSteps.map((step) => <div class="premium-card reveal"><p class="font-display text-5xl text-gold">{step.number}</p><h3 class="mt-5">{step.title}</h3><p class="mt-3 leading-7 text-slate-600">{step.text}</p></div>)}
            </div>
        </div>
    </section>
</Layout>
