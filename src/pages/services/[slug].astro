---
import Layout from '../../layouts/Layout.astro';
import { allServices, site } from '../../content/vidian';

export function getStaticPaths() {
    return allServices.map((service) => ({
        params: { slug: service.slug },
        props: { service }
    }));
}

const { service } = Astro.props;
---

<Layout title={`${service.title} | ${site.name}`} description={service.summary} noHeaderOverlay>
    <section class="bg-luxury pt-40 pb-24 text-white sm:pb-32">
        <div class="section-shell grid items-center gap-12 lg:grid-cols-[1fr_0.9fr]">
            <div class="reveal">
                <p class="eyebrow">Vidian Capital Services</p>
                <h1>{service.title}</h1>
                <p class="mt-6 max-w-3xl text-lg leading-8 text-white/72">{service.description}</p>
                <div class="mt-9 flex flex-col gap-4 sm:flex-row">
                    <a href="/contact-us" class="btn btn-gold">Discuss Your Portfolio</a>
                    <a href="/services" class="btn btn-outline">View All Services</a>
                </div>
            </div>
            <div class="reveal dark-card">
                <p class="text-sm font-bold uppercase tracking-[0.22em] text-gold">Strategic. Secure. Scalable.</p>
                <ul class="mt-6 space-y-4">
                    {service.bullets.map((item) => <li class="bg-white/[0.06] p-4 text-white/75">{item}</li>)}
                </ul>
            </div>
        </div>
    </section>

    <section class="py-24 sm:py-32">
        <div class="section-shell grid gap-12 lg:grid-cols-[0.9fr_1.1fr]">
            <div class="reveal">
                {service.image ? <img src={service.image} alt="" class="aspect-[4/3] object-cover shadow-2xl shadow-slate-950/15" /> : <img src="/images/vidian/investment-meeting.png" alt="" class="aspect-[4/3] object-cover shadow-2xl shadow-slate-950/15" />}
            </div>
            <div class="reveal">
                <p class="eyebrow">Service Overview</p>
                <h2>Designed around investor objectives, capital, and long-term priorities.</h2>
                <p class="mt-6 text-lg leading-8">{service.description}</p>
                <div class="mt-8 grid gap-4 sm:grid-cols-2">
                    {service.bullets.map((item) => <div class="premium-card"><p class="font-semibold text-ink">{item}</p></div>)}
                </div>
            </div>
        </div>
    </section>

    {service.sections?.map((section, index) => (
        <section class:list={[index % 2 === 0 ? 'bg-white' : 'bg-cream', 'py-24 sm:py-32']}>
            <div class="section-shell grid gap-10 lg:grid-cols-[0.75fr_1.25fr]">
                <div class="reveal">
                    <p class="eyebrow">{section.label}</p>
                    <h2>{section.title}</h2>
                </div>
                <div class="reveal">
                    <p class="text-xl leading-9">{section.text}</p>
                </div>
            </div>
        </section>
    ))}

    <section class="bg-luxury py-24 text-white sm:py-32">
        <div class="section-shell">
            <div class="reveal grid items-center gap-8 lg:grid-cols-[1fr_auto]">
                <div>
                    <p class="eyebrow">Start Your Investment Journey</p>
                    <h2 class="text-white">Whether you are looking for your first buy-to-let or expanding a global portfolio, our team is here to help.</h2>
                </div>
                <div class="flex flex-col gap-4 sm:flex-row">
                    <a href="/contact-us" class="btn btn-gold">Book Free Consultation</a>
                    <a href="/contact-us" class="btn btn-outline">Contact Us</a>
                </div>
            </div>
        </div>
    </section>
</Layout>
