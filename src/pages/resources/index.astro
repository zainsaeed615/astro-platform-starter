---
import Layout from '../../layouts/Layout.astro';
import PageHero from '../../components/PageHero.astro';
---

<Layout title="Resources" description="Operation 17:2 resources — policies, training materials, and mission information.">
    <PageHero label="Resources" title="Mission Resources" description="Policies, training materials, and information for members and supporters." />

    <section class="section-container py-16 md:py-24">
        <div class="grid gap-6 md:grid-cols-2">
            {
                [
                    { title: 'Code of Conduct', desc: 'Standards for all members on and off the field.', id: 'conduct' },
                    { title: 'Application Process', desc: 'Review → References → Background Check → Interview → Decision.', href: '/get-involved/apply' },
                    { title: 'Recording & Publication Policy', desc: 'Nothing published without leadership sign-off.', id: 'publication' },
                    { title: 'Background Check Info', desc: '$50 fee with hardship fund available for those in need.', id: 'screening' },
                    { title: 'Fundraiser Toolkit', desc: 'Downloadable materials for peer-to-peer fundraising.', href: '/donate#fundraiser' },
                    { title: 'Prayer Call Schedule', desc: 'Twice-monthly live Zoom prayer calls.', href: '/live-prayer' }
                ].map((item) => (
                    <div id={item.id} class="card-surface p-8">
                        <h3 class="font-display text-lg font-semibold uppercase">{item.title}</h3>
                        <p class="mt-3 text-sm text-white/60">{item.desc}</p>
                        {item.href && <a href={item.href} class="mt-4 inline-block text-sm text-brand-blue no-underline hover:underline">View →</a>}
                    </div>
                ))
            }
        </div>
    </section>
</Layout>
