---
import MainLayout from '../../layouts/MainLayout.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { site } from '../../data/site';

const goalPercent = Math.round((site.donations.raised / site.donations.goal) * 100);
---

<MainLayout title="Donate" description="Support Operation 17:2's mission to protect children. Make a one-time or recurring donation.">
  <section class="border-b border-white/10 bg-[#0a0a0a]">
    <div class="container-site py-16 sm:py-20">
      <span class="section-label">Support the Mission</span>
      <h1 class="mb-4">Donate</h1>
      <p class="max-w-2xl text-lg text-white/60">
        Every dollar goes directly back into our mission — funding decoy phone bills, travel for operations, and essential resources to identify and pursue child predators.
      </p>
    </div>
  </section>

  <!-- Live Goal -->
  <section class="section-padding">
    <div class="container-site">
      <div class="card gradient-border mx-auto max-w-3xl p-8 sm:p-12">
        <SectionHeading label="Live Goal" title="Fund the Fight" align="center" />
        <div class="mt-8">
          <div class="mb-3 flex justify-between">
            <span class="font-display text-3xl font-bold text-blue-400">${site.donations.raised.toLocaleString()}</span>
            <span class="text-white/50">of ${site.donations.goal.toLocaleString()} goal</span>
          </div>
          <div class="h-4 overflow-hidden rounded-full bg-white/10">
            <div class="h-full rounded-full bg-gradient-accent" style={`width: ${goalPercent}%`}></div>
          </div>
          <p class="mt-3 text-center text-sm text-white/50">{goalPercent}% funded</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Donation Options -->
  <section class="border-t border-white/10 bg-[#0a0a0a] section-padding">
    <div class="container-site">
      <div class="grid gap-8 lg:grid-cols-2">
        <!-- One-time / Recurring -->
        <div class="card">
          <h3 class="mb-2">One-Time or Recurring</h3>
          <p class="mb-6 text-sm text-white/50">
            Donate securely through our Donorbox platform. Choose a one-time gift or set up a recurring monthly donation to sustain our operations.
          </p>
          <div class="mb-6 grid grid-cols-3 gap-3">
            {[25, 50, 100, 250, 500, 1000].map((amount) => (
              <button class="rounded-sm border border-white/10 bg-white/5 py-3 text-sm font-semibold text-white transition-colors hover:border-blue-500 hover:bg-blue-500/10">
                ${amount}
              </button>
            ))}
          </div>
          <a href={site.donations.donorbox} target="_blank" rel="noopener" class="btn-primary w-full text-center">
            Donate via Donorbox
          </a>
        </div>

        <!-- Other Methods -->
        <div class="card">
          <h3 class="mb-2">Other Ways to Give</h3>
          <p class="mb-6 text-sm text-white/50">Prefer Venmo or PayPal? Send your gift directly to Operation 17:2.</p>
          <div class="space-y-4">
            <div class="flex items-center justify-between rounded-sm border border-white/10 bg-white/5 px-4 py-4">
              <div>
                <span class="text-xs uppercase tracking-wider text-white/40">Venmo</span>
                <p class="font-semibold text-white">{site.donations.venmo}</p>
              </div>
              <span class="text-2xl">💙</span>
            </div>
            <div class="flex items-center justify-between rounded-sm border border-white/10 bg-white/5 px-4 py-4">
              <div>
                <span class="text-xs uppercase tracking-wider text-white/40">PayPal</span>
                <p class="font-semibold text-white">{site.donations.paypal}</p>
              </div>
              <span class="text-2xl">💙</span>
            </div>
          </div>
          <p class="mt-6 text-sm text-white/40">
            Questions about donations? Email <a href={`mailto:${site.email}`} class="text-blue-400 no-underline">{site.email}</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Fundraiser CTA -->
  <section class="section-padding">
    <div class="container-site text-center">
      <SectionHeading
        label="Peer-to-Peer"
        title="Start a Fundraiser"
        description="Rally your community, church, or organization to raise funds for Operation 17:2. Create a personal fundraising page and share it with your network."
        align="center"
      />
      <a href="/donate/fundraiser" class="btn-primary mt-8 inline-flex">Start Your Fundraiser</a>
    </div>
  </section>
</MainLayout>

<style>
  .bg-gradient-accent {
    background-image: linear-gradient(135deg, #1e40af, #3b82f6);
  }
</style>
